{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical Knowledge Graph Extraction v3 — statements, attributions and participants",
  "description": "Experimental page-local statements: distinguish stance towards a proposition from participation in its content. Confidence is uncalibrated; no global IDs. Derived edges are application-owned and never part of the model response.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "kg-extraction-v3"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "grounding": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "salience": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "incidental"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_confidence": {
            "$ref": "#/$defs/model_confidence"
          }
        },
        "required": [
          "id",
          "label",
          "meaning",
          "grounding",
          "salience",
          "evidence_ids",
          "model_confidence"
        ]
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERSON",
              "GROUP",
              "INSTITUTION",
              "WORK",
              "PLACE",
              "SOURCE_REFERENCE",
              "OTHER"
            ]
          },
          "label": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "current_page",
              "bibliographic_context"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_confidence": {
            "$ref": "#/$defs/model_confidence"
          }
        },
        "required": [
          "id",
          "type",
          "label",
          "origin",
          "evidence_ids",
          "model_confidence"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "proposition": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "asserted",
              "reported",
              "hypothetical",
              "questioned",
              "uncertain",
              "conditional"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_confidence": {
            "$ref": "#/$defs/model_confidence"
          },
          "attributions": {
            "type": "array",
            "description": "Actors and their stances toward the exact proposition; never infer these from participants. Empty if unresolved.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entity_id": {
                  "type": "string"
                },
                "stance": {
                  "type": "string",
                  "enum": [
                    "AFFIRMS",
                    "DEFENDS",
                    "REFUTES",
                    "REPORTS",
                    "QUESTIONS"
                  ]
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "reported",
                    "hypothetical",
                    "conditional",
                    "uncertain"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "entity_id",
                "stance",
                "scope",
                "evidence_ids"
              ]
            }
          },
          "participants": {
            "type": "array",
            "description": "Entities mentioned inside the proposition, not necessarily its holders.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entity_id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "agent",
                    "target",
                    "cited_authority",
                    "subject"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "entity_id",
                "role",
                "evidence_ids"
              ]
            }
          }
        },
        "required": [
          "id",
          "proposition",
          "mode",
          "evidence_ids",
          "model_confidence",
          "attributions",
          "participants"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "narrative_status": {
            "type": "string",
            "enum": [
              "reported",
              "hypothetical",
              "uncertain"
            ]
          },
          "time_expression": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_confidence": {
            "$ref": "#/$defs/model_confidence"
          }
        },
        "required": [
          "id",
          "description",
          "narrative_status",
          "time_expression",
          "evidence_ids",
          "model_confidence"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "predicate": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "target_id": {
            "type": "string"
          },
          "grounding": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_confidence": {
            "$ref": "#/$defs/model_confidence"
          }
        },
        "required": [
          "id",
          "source_id",
          "predicate",
          "target_id",
          "grounding",
          "evidence_ids",
          "model_confidence"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "ocr_block",
              "summary_segment"
            ]
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "locator",
          "quote"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "OCR_AMBIGUITY",
              "SOURCE_CONFLICT",
              "AMBIGUOUS_ATTRIBUTION",
              "WORK_BOUNDARY",
              "OTHER"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "concepts",
    "entities",
    "claims",
    "events",
    "relations",
    "evidence",
    "warnings"
  ],
  "$defs": {
    "model_confidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Model-estimated probability that this entire item faithfully represents its cited sources, including attribution and modality. Uncalibrated."
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "One short sentence about decisive source support and any material uncertainty; not a reasoning trace."
        }
      },
      "required": [
        "score",
        "rationale"
      ]
    }
  }
}
