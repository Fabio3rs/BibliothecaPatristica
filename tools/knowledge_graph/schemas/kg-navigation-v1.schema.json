{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page-local subjects and arguments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kg-navigation-v1"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "salience": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "meaning",
          "salience",
          "evidence_ids"
        ]
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "concept_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "concept_ids",
          "evidence_ids"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "enum": [
              "ocr_block",
              "summary_segment"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "source",
          "locator",
          "quote"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "OCR_AMBIGUITY",
              "SOURCE_CONFLICT",
              "INTERPRETATION_AMBIGUITY",
              "COVERAGE_LIMIT",
              "OTHER"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "concepts",
    "arguments",
    "evidence",
    "warnings"
  ]
}
