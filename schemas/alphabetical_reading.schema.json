                    "explicit_declaration",
                    "printed_marker",
                    "edition_correspondence",
                    "sequence_inference",
                    "unverified_hypothesis"
                  ]
                },
                "literal": {
                  "type": "string"
                },
                "edition": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tome": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "series": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notation": {
                  "type": "string"
                },
                "physical_source_page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "literal",
                "edition",
                "tome",
                "series",
                "notation",
                "physical_source_page"
