{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "alphabetical-reading-v2"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "analytic_subject",
              "alphabetical_general",
              "onomastic_person",
              "onomastic_place",
              "onomastic_mixed",
              "author_index",
              "scripture_index",
              "pericope_index",
              "concordance_index",
              "foreign_terms",
              "crosswalk_index"
            ]
          },
          "material_reference_mode": {
            "type": "string",
            "enum": [
              "remissive",
              "parallel",
              "source_only"
            ]
          },
          "scripture_mode": {
            "type": "string",
            "enum": [
              "none",
              "citation_index",
              "pericope_index",
              "concordance_component",
              "textual_apparatus",
              "incidental_mention"
            ]
          },
          "scripture_profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "index_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "conventions": {
            "type": "array",
