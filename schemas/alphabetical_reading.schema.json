              "additionalProperties": false
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entry"
            }
          },
          "edition_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from_edition": {
                  "type": "string"
                },
                "from_locator": {
                  "type": "string"
                },
                "to_edition": {
                  "type": "string"
                },
                "to_locator": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "uncertain"
                  ]
                },
                "quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "from_edition",
                "from_locator",
                "to_edition",
                "to_locator",
                "status",
                "quotes"
              ],
              "additionalProperties": false
            }
          }
