                ]
              },
              "page_end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "column": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line_start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line_end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "edition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "series": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpretation_evidence": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string"
