{
  "name": "pdfocr-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:scripture-references && astro build",
    "build:scripture-references": "python3 ../tools/build_scripture_reference_payloads.py --public ./public --ocr-root ../teste --out ./public/scripture/references/v1",
    "build:dicts": "python3 ../tools/export_keywords_dicts.py --db ../data/patristica_keywords.db --out ./public/dict",
    "build:indices": "python3 ../tools/export_indices_from_db.py --db ../data/patristic_indices.db --out ./public/indices",
    "build:indexador-runtime:local": "node ../.work/PatrologiaIndexer/scripts/export-wasm-assets.mjs --build-dir ../.work/PatrologiaIndexer/build-codex-wasm --out-dir ./public/indexador/runtime",
    "build:indices-indexador:dev": "node ../tools/build_indices_indexador_from_json.mjs --source-manifest ./public/indices/manifest.json --out ./public/indexador/indices --binary ../.work/PatrologiaIndexer/build-codex-clang19/indexador --base /BibliothecaPatristica --volumes PG001,PL001,PO002",
    "build:indices-indexador": "node ../tools/build_indices_indexador_from_json.mjs --source-manifest ./public/indices/manifest.json --out ./public/indexador/indices --base /BibliothecaPatristica --documents-per-shard 500 --all",
    "build:search-indexador:dev": "node ../tools/build_search_indexador_from_shards.mjs --public ./public --source-manifest ./public/volumes.json --out ./public/indexador/search --binary ../.work/PatrologiaIndexer/build-codex-clang19/indexador --base /BibliothecaPatristica --layout unified --documents-per-shard 500 --volumes PG001,PL001,PO002",
    "build:search-indexador": "node ../tools/build_search_indexador_from_shards.mjs --public ./public --source-manifest ./public/volumes.json --out ./public/indexador/search --base /BibliothecaPatristica --layout unified --documents-per-shard 500 --all",
    "preview": "astro preview",
    "check": "astro check",
    "test:chat": "node --test tests/chat-agent-core.test.mjs",
    "test:agent-search": "node --test tests/agent-query-strategies.test.mjs",
    "test:agent-suggestions": "node --test tests/agent-chat-suggestions.test.mjs",
    "test:agent-benchmark": "node --test tests/agent-rag-harness.test.mjs",
    "test:ocr-text": "node --test tests/ocr-text.test.mjs",
    "test:agent-ui": "node --test tests/agent-chat-ui-contract.test.mjs",
    "benchmark:agent": "node ../scripts/playgrounds/agent_rag_benchmark.mjs",
    "test:i18n": "node --test tests/i18n-parity.test.mjs",
    "test:scripture": "node --test tests/scripture-index.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "^7.2.8",
    "typescript": "^5.9.3"
  }
}
