---
import Layout from '../../../../components/Layout.astro';
import { buildCanonicalUrl, getSeoVolumePayload, listThematicVolumes } from '../../../../lib/seoIndices';

export async function getStaticPaths() {
  const volumes = await listThematicVolumes();
  return volumes.map((volume) => ({
    params: { volumeId: volume.volume_id },
  }));
}

const { volumeId } = Astro.params;
if (!volumeId) {
  throw new Error('volumeId ausente em /seo/volumes/[volumeId]/indice-tematico.astro');
}

const payload = await getSeoVolumePayload(volumeId);
if (!payload.hasThematicSections) {
  throw new Error(`Volume ${volumeId} sem seções temáticas para a rota estática.`);
}

const base = import.meta.env.BASE_URL || '/';
const basePath = base.endsWith('/') ? base.slice(0, -1) : base;
const canonicalPath = `/seo/volumes/${payload.volumeId}/indice-tematico`;
const canonicalUrl = buildCanonicalUrl(Astro.site, canonicalPath);
const pageTitle = `${payload.volumeId} — índice temático estático | Bibliotheca Patristica`;
const description = `${payload.volumeId}: índice temático estático com headings originais e links HTML para páginas e seções do corpus.`;

function withBase(path: string) {
  const clean = path.startsWith('/') ? path : `/${path}`;
  return `${basePath}${clean}`;
}
---

<Layout
  title={pageTitle}
  description={description}
  breadcrumbs={[{ label: 'Início', href: withBase('/') }, { label: 'SEO' }, { label: payload.volumeId, href: withBase(`/seo/volumes/${payload.volumeId}`) }, { label: 'Índice temático' }]}
  showPrimaryNav={false}
  showLocaleSwitch={false}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
  </Fragment>

  <section class="card thematic-hero" style="margin-top:var(--space-4);">
    <div>
      <p class="eyebrow">Índice temático estático</p>
      <h1>{payload.volumeId} — {payload.title}</h1>
      <p>
        Lista HTML estática das seções temáticas do volume, preservando o texto original do índice e priorizando
        links profundos para páginas com referência explícita.
      </p>
    </div>
    <div class="hero-actions">
      <a class="button secondary" href={withBase(`/seo/volumes/${encodeURIComponent(payload.volumeId)}`)}>Voltar ao hub do volume</a>
      <a class="button secondary" href={withBase(`/indices?doc=${encodeURIComponent(payload.volumeId)}`)}>Abrir índice dinâmico</a>
    </div>
  </section>

  <section class="card toc-card" aria-label="Seções do índice">
    <p class="eyebrow">Sumário</p>
    <ul class="toc-list">
      {payload.sections.map((section) => (
        <li>
            <a href={`#${section.anchorId}`}>
            <strong>{section.title}</strong>
            <span>{section.entries.length} entradas</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="thematic-sections">
    {payload.sections.map((section) => (
      <section id={section.anchorId} class="card thematic-section">
        <div class="section-head">
          <div>
            <p class="eyebrow">{section.kind || 'Seção temática'}</p>
            <h2>{section.title}</h2>
            {section.titleSecondary && <p class="subtle">{section.titleSecondary}</p>}
          </div>
          <div class="head-actions">
            <a class="button secondary" href={withBase(section.sectionHref)}>Abrir seção no índice</a>
          </div>
        </div>

        <ol class="entry-list">
          {section.entries.map((entry) => (
            <li id={entry.anchorId}>
              <div class="entry-copy">
                <a class="entry-title" href={withBase(entry.viewerHref || entry.fallbackHref)}>
                  {entry.title}
                </a>
                {entry.subtitle && <p>{entry.subtitle}</p>}
                {entry.normalizedTarget && <small>{entry.normalizedTarget}</small>}
                {entry.note && <small>{entry.note}</small>}
              </div>
              <div class="entry-actions">
                {entry.viewerHref ? (
                  <a class="button secondary" href={withBase(entry.viewerHref)}>Abrir p. {entry.page}</a>
                ) : (
                  <a class="button secondary" href={withBase(entry.fallbackHref)}>Abrir no índice</a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <style>
    .thematic-hero, .toc-card, .thematic-section {
      padding: var(--space-5);
    }
    .thematic-hero {
      display: grid;
      gap: var(--space-4);
      border: 1px solid var(--color-border);
      background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 88%, var(--color-accent) 12%), var(--color-surface));
    }
    .thematic-hero h1, .thematic-section h2 {
      margin: 0;
      font-family: var(--font-serif);
    }
    .thematic-hero p, .subtle {
      margin: var(--space-2) 0 0;
      color: var(--color-muted);
      line-height: 1.6;
    }
    .eyebrow {
      margin: 0 0 var(--space-2);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      font-weight: 700;
      font-size: 0.8rem;
    }
    .hero-actions, .head-actions {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .toc-card, .thematic-sections {
      margin-top: var(--space-5);
    }
    .toc-list, .entry-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: var(--space-3);
    }
    .toc-list {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      margin-top: var(--space-3);
    }
    .toc-list a, .entry-list li {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      align-items: start;
      padding: var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-s);
      background: var(--color-surface-2);
      text-decoration: none;
      color: var(--color-ink);
    }
    .toc-list a:hover, .entry-list li:hover {
      border-color: var(--color-accent);
    }
    .thematic-sections {
      display: grid;
      gap: var(--space-4);
    }
    .section-head {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      align-items: end;
      margin-bottom: var(--space-4);
    }
    .entry-copy {
      display: grid;
      gap: 0.35rem;
    }
    .entry-title {
      color: var(--color-ink);
      text-decoration: none;
      font-weight: 700;
    }
    .entry-title:hover {
      color: var(--color-accent);
    }
    .entry-copy p, .entry-copy small, .toc-list span {
      margin: 0;
      color: var(--color-muted);
    }
    @media (max-width: 820px) {
      .section-head, .entry-list li {
        flex-direction: column;
        align-items: start;
      }
    }
  </style>
</Layout>
