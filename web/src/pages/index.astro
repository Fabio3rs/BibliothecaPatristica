---
import Layout from '../components/Layout.astro';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const assetBase = baseWithSlash; // para uso em scripts, garantindo a barra final

const startPoints = {
  "Autores Notáveis": [
    { label: "Agostinho de Hipona", term: "Augustinus Hipponensis" },
    { label: "Orígenes de Alexandria", term: "Origenes" },
    { label: "João Crisóstomo", term: "Joannes Chrysostomus" },
    { label: "Jerônimo", term: "Hieronymus" },
  ],
  "Temas Centrais": [
    { label: "Trindade", term: "Trinitas" },
    { label: "Cristologia", term: "Christologia" },
    { label: "Eucaristia", term: "Eucharistia" },
    { label: "Gnose", term: "Gnosis" },
  ]
};

---
<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
    text-align: center;
  }
  .stat-item h3 {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-accent);
  }
  .stat-item p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .start-points-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
  .start-points-grid h3 {
    margin-top: 0;
    margin-bottom: var(--space-3);
    font-family: var(--font-serif);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-2);
  }
  .start-points-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .start-points-grid a {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-s);
    transition: background-color 0.2s;
  }
  .start-points-grid a:hover {
    background-color: var(--color-surface-raised);
  }
</style>

<Layout title="Bibliotheca Patristica" description="Uma interface de pesquisa para as coleções da Patrologia de Migne." breadcrumbs={[{label:'Início'}]}>
  <Fragment slot="head">
    <link rel="prefetch" href={`${baseWithSlash}search`} />
    <link rel="prefetch" href={`${baseWithSlash}pagefind/pagefind.js`} />
  </Fragment>
  <section class="card" style="margin-top:var(--space-4);">
    <h1 style="margin-top:0;font-family:var(--font-serif);">Bibliotheca Patristica Digital</h1>
    <p>Uma interface de pesquisa e exploração para as coleções da <strong>Patrologia Graeca (PG)</strong>, <strong>Latina (PL)</strong> e <strong>Orientalis (PO)</strong> de J.P. Migne. Navegue por um dos maiores acervos da literatura cristã antiga através de uma busca textual poderosa e metadados enriquecidos por IA.</p>
    <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-4);">
      <a class="button" href={`${baseWithSlash}search`}>Iniciar Pesquisa</a>
      <a class="button secondary" href={`${baseWithSlash}viewer?doc=PG059&page=535`}>Ver Página de Exemplo (Crisóstomo)</a>
    </div>
  </section>

  <section class="card-plain" style="margin-top:var(--space-5);">
    <div class="stats-grid" id="stats-grid">
      <!-- Preenchido dinamicamente via volumes.json -->
      <div class="stat-item"><h3>…</h3><p>Volumes Cobertos</p></div>
      <div class="stat-item"><h3>3 Séries</h3><p>Graeca, Latina &amp; Orientalis</p></div>
      <div class="stat-item"><h3>…</h3><p>Páginas Indexadas</p></div>
      <div class="stat-item"><h3>1B+</h3><p>Tokens Processados</p></div>
    </div>
  </section>

  <section class="card" style="margin-top:var(--space-5);">
    <h2 style="margin-top:0;font-family:var(--font-serif);">Pontos de Partida</h2>
    <p style="color:var(--color-muted); max-width:65ch;">Não sabe por onde começar? Explore o acervo a partir destes autores e temas fundamentais.</p>
    <div class="start-points-grid">
      {Object.entries(startPoints).map(([title, links]) => (
        <div>
          <h3>{title}</h3>
          <ul>
            {links.map(link => (
              <li><a href={`${baseWithSlash}search?term=${encodeURIComponent(link.term)}`}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:var(--space-5);">
    <header style="display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);flex-wrap:wrap;">
      <div>
        <p style="margin:0;color:var(--color-muted);">Explorar Temas</p>
        <h2 style="margin:0;font-family:var(--font-serif);">Nuvem de Palavras-Chave</h2>
      </div>
      <small style="color:var(--color-muted);">Baseada em extração automática de termos.</small>
    </header>
    <div id="tag-cloud" role="list" aria-label="Nuvem de palavras-chave mais frequentes" style="margin-top:var(--space-4); display:flex; gap:0.6rem; flex-wrap:wrap; align-items:flex-end;">
      <p style="margin:0;color:var(--color-muted);">Carregando tags...</p>
    </div>
  </section>

  <script type="module" define:vars={{ assetBase }}>
    const cloud = document.getElementById('tag-cloud');
    const statsGrid = document.getElementById('stats-grid');
    const searchUrl = (tag) => `${assetBase}search?term=${encodeURIComponent(tag)}`;

    function formatNumber(n) {
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace('.0', '')}M+`;
      if (n >= 1_000) return `${Math.round(n / 1_000)}k+`;
      return String(n);
    }

    async function loadStats() {
      try {
        const res = await fetch(`${assetBase}volumes.json`);
        if (!res.ok) return;
        const data = await res.json();
        const volumes = data.volumes || [];
        const collections = new Set(volumes.map(v => v.collection_id)).size;
        const totalPages = volumes.reduce((s, v) => s + ((v.page_last || 0) - (v.page_first || 1) + 1), 0);

        const cells = statsGrid.querySelectorAll('.stat-item h3');
        if (cells[0]) cells[0].textContent = `${volumes.length}+`;
        if (cells[2]) cells[2].textContent = formatNumber(totalPages);
      } catch (e) {
        console.warn('Stats não carregadas:', e);
      }
    }

    function renderCloud(items) {
      cloud.innerHTML = '';
      // Escala logarítmica: evita que um item com count=5000 domine visualmente
      // sobre um com count=100. log(5000)/log(100) ≈ 1.85 vs 1 — proporção saudável.
      const maxLog = Math.log1p(Math.max(...items.map(i => i.count || 1)));
      const minLog = Math.log1p(Math.min(...items.map(i => i.count || 1)));
      const logRange = Math.max(1, maxLog - minLog);

      // Embaralhamento de Fisher-Yates para visual orgânico
      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }

      const minSize = 0.82, maxSize = 1.75;
      shuffled.forEach((item) => {
        const ratio = (Math.log1p(item.count || 1) - minLog) / logRange;
        const size = minSize + ratio * (maxSize - minSize);
        const a = document.createElement('a');
        a.href = searchUrl(item.label);
        a.textContent = item.label;
        a.setAttribute('role', 'listitem');
        a.title = `${item.count ? item.count + ' ocorrência(s)' : item.label}`;
        a.style.fontSize = `${size.toFixed(2)}rem`;
        a.style.fontWeight = ratio > 0.6 ? '700' : '500';
        a.style.color = 'var(--color-ink)';
        a.style.textDecoration = 'none';
        a.style.padding = '0.2rem 0.35rem';
        a.style.borderRadius = '6px';
        a.style.background = 'color-mix(in srgb, var(--color-accent) 10%, var(--color-surface))';
        a.style.border = '1px solid var(--color-border)';
        a.style.transition = 'background 0.15s';
        a.addEventListener('mouseover', () => { a.style.background = 'color-mix(in srgb, var(--color-accent) 22%, var(--color-surface))'; });
        a.addEventListener('mouseout', () => { a.style.background = 'color-mix(in srgb, var(--color-accent) 10%, var(--color-surface))'; });
        cloud.appendChild(a);
      });
    }

    async function loadTags() {
      try {
        // keywords_top.json contém apenas temas (iscit=false), ordenados por
        // frequência agregada do grupo HDBSCAN — sem citações bíblicas.
        const res = await fetch(`${assetBase}dict/keywords_top.json`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items = (data.items || []).slice(0, 60);
        if (items.length) {
          renderCloud(items);
        } else {
          cloud.innerHTML = `<p style="margin:0;color:var(--color-muted);">Nenhuma palavra-chave encontrada.</p>`;
        }
      } catch (err) {
        console.error("Falha ao carregar tags:", err);
        cloud.innerHTML = `<p style="margin:0;color:var(--color-muted);">Falha ao carregar as palavras-chave.</p>`;
      }
    }

    loadStats();
    loadTags();
  </script>
</Layout>
