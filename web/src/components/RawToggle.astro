---
import { useTranslations } from '../i18n';
const { url } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---
<div class="raw-box">
  {url ? (
    <a class="button secondary" href={url} target="_blank" rel="noreferrer">{t.rawOpen}</a>
  ) : (
    <p style="margin:0; color:var(--color-muted);">{t.rawUnavailable}</p>
  )}
</div>
