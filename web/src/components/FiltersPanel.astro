---
const { sections = [], loading = false } = Astro.props;
---
<aside class="card" aria-label="Filtros">
  <h2 style="margin-top:0;">Filtros</h2>
  {loading ? (
    <p class="muted" style="margin:0;">Carregando filtros...</p>
  ) : (
    <div class="filters">
      {sections.map((section) => (
        <div>
          <h3>{section.label}</h3>
          {(section.items || []).length ? (
            section.items.map((item) => (
              <label>
                <input type="checkbox" name={section.key} value={item} />
                {item}
              </label>
            ))
          ) : (
            <p class="muted" style="margin:0;">Sem opções</p>
          )}
        </div>
      ))}
    </div>
  )}
</aside>
