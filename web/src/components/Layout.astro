---
import '../styles/global.css';
import Breadcrumbs from './Breadcrumbs.astro';
import AgentChat from './AgentChat.astro';
import { useTranslations, getLocaleBase, getLocaleRouteUrl, getLocaleUrl } from '../i18n';
import type { SupportedLocale } from '../i18n';

const {
  title = 'Bibliotheca Patristica',
  description = 'Acervo digital aberto da Patrologia Graeca, Latina e Orientalis de J.P. Migne — busca textual e metadados enriquecidos.',
  breadcrumbs = [],
  showPrimaryNav = true,
  showLocaleSwitch = true,
} = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const baseWithSlash = `${base}/`;

const t = useTranslations(Astro.currentLocale);
// Mapeia locale para tag BCP-47 válida no atributo lang do HTML
const locale = (Astro.currentLocale ?? 'pt-br') as SupportedLocale;
const htmlLang = locale === 'en' ? 'en' : locale === 'it' ? 'it-IT' : locale === 'fr' ? 'fr-FR' : 'pt-BR';
const localeBase = getLocaleBase(locale, base);
const ogLocale = locale === 'en' ? 'en_US' : locale === 'it' ? 'it_IT' : locale === 'fr' ? 'fr_FR' : 'pt_BR';
const siteBase = Astro.site
  ? (Astro.site.toString().endsWith('/') ? Astro.site.toString() : `${Astro.site.toString()}/`)
  : `${Astro.url.origin}${baseWithSlash}`;

function absoluteLocaleUrl(targetLocale: SupportedLocale) {
  const appPath = getLocaleUrl(targetLocale, Astro.url.pathname, base);
  const relative = appPath.startsWith(base) ? appPath.slice(base.length) : appPath;
  return new URL(relative.replace(/^\//, ''), siteBase).toString();
}

const canonicalUrl = absoluteLocaleUrl(locale);
const socialImageUrl = new URL('favicon.svg', siteBase).toString();
const alternateLocales = [
  { locale: 'pt-br', hreflang: 'pt-BR' },
  { locale: 'en', hreflang: 'en' },
  { locale: 'it', hreflang: 'it' },
  { locale: 'fr', hreflang: 'fr' },
] as const;

const localeOptions = [
  { code: 'pt-br', label: t.langSwitchPt },
  { code: 'en', label: t.langSwitchEn },
  { code: 'it', label: t.langSwitchIt },
  { code: 'fr', label: t.langSwitchFr },
] as const;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLocales.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={absoluteLocaleUrl(alternate.locale)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl('pt-br')} />
    <link rel="icon" type="image/svg+xml" href={`${baseWithSlash}favicon.svg`} />
    <meta name="theme-color" content="#1f6b7a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bibliotheca Patristica" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLocales.filter((alternate) => alternate.locale !== locale).map((alternate) => (
      <meta property="og:locale:alternate" content={alternate.locale === 'pt-br' ? 'pt_BR' : alternate.locale === 'en' ? 'en_US' : alternate.locale === 'it' ? 'it_IT' : 'fr_FR'} />
    ))}
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="manifest" href={`${baseWithSlash}manifest.json`} />
    <script>
      import '../utils/dataCache.ts';
    </script>

    <slot name="head" />
    <style>
      @font-face { font-family: 'Source Serif 4'; font-style: normal; font-weight: 400; src: local('Source Serif 4'); }
      @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; src: local('Inter'); }
      .lang-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem;
        border-radius: var(--radius, 6px);
        border: 1px solid var(--color-border);
        background: transparent;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-muted);
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
        white-space: nowrap;
      }
      .lang-switch:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      }
      .lang-switch .ls-option {
        padding: 0.2rem 0.55rem;
        border-radius: calc(var(--radius, 6px) - 2px);
        color: var(--color-muted);
      }
      .lang-switch .ls-option[aria-current="true"] {
        color: var(--color-accent);
        font-weight: 700;
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.skipToContent}</a>
    <div class="page-shell">
      <header class="topbar">
        <div class="wrapper header-grid">
          <div>
            <a href={localeBase} class="logo" aria-label={t.logoLabel}>
              <span aria-hidden="true">📚</span> {t.logoText}
            </a>
            <div style="color: var(--color-muted); font-size: 0.95rem;">{t.tagline}</div>
          </div>
          {showPrimaryNav && (
            <nav aria-label={t.navMenuLabel}>
              <button class="nav-toggle" aria-label={t.navMenuLabel} aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">
                ☰
              </button>
              <div class="nav-links" id="primary-nav">
                <a href={getLocaleRouteUrl(locale, 'search', base)}>{t.navSearch}</a>
                <a href={getLocaleRouteUrl(locale, 'indices', base)}>{t.navIndices}</a>
                {showLocaleSwitch && (
                  <div class="lang-switch" role="group" aria-label={t.langSwitchLabel}>
                    {localeOptions.map((option) => (
                      <a
                        href={getLocaleUrl(option.code, Astro.url.pathname, base, Astro.url.search)}
                        class="ls-option"
                        data-locale-code={option.code}
                        aria-current={locale === option.code ? 'true' : undefined}
                        aria-label={option.label}
                        title={option.label}
                      >
                        {option.code === 'pt-br' ? 'PT' : option.code.toUpperCase()}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </nav>
          )}
        </div>
      </header>
      <main id="conteudo" class="wrapper" tabindex="-1">
        {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
        {Astro.slots.default ? <slot /> : null}
      </main>
      <aside class="wrapper disclaimer-wrapper" aria-label={t.disclaimerAriaLabel}>
        <div class="disclaimer-box">
          <p style="margin:0 0 0.5rem;"><strong>{t.disclaimerTitle}</strong></p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine1}</p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine2}</p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine3}</p>
          {(Astro.currentLocale ?? 'pt-br') !== 'pt-br' && (
            <p style="margin:0; font-style: italic; color: var(--color-muted); font-size: 0.9rem;">{t.disclaimerDataLang}</p>
          )}
        </div>
      </aside>
      <footer class="footer">
        <div class="wrapper" style="padding:0;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-3);">
            <span set:html={t.footerLeft}></span>
            <span style="color:var(--color-muted);">{t.footerRight}</span>
          </div>
        </div>
      </footer>
    </div>
    <AgentChat />
    <script type="module" define:vars={{ basePath: base }}>

      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('primary-nav');
      const localeLinks = Array.from(document.querySelectorAll('.lang-switch .ls-option[data-locale-code]'));

      function normalizeLocale(locale) {
        const lower = String(locale || '').toLowerCase();
        if (lower === 'en' || lower.startsWith('en-')) return 'en';
        if (lower === 'it' || lower.startsWith('it-')) return 'it';
        if (lower === 'fr' || lower.startsWith('fr-')) return 'fr';
        return 'pt-br';
      }

      function localeBase(locale) {
        const baseNoSlash = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
        const normalized = normalizeLocale(locale);
        return normalized === 'pt-br'
          ? `${baseNoSlash}/`
          : `${baseNoSlash}/${normalized}/`;
      }

      function localizedUrl(targetLocale) {
        const baseNoSlash = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
        const pathname = window.location.pathname || '/';
        const search = window.location.search || '';
        const hash = window.location.hash || '';
        const withoutBase = pathname.startsWith(baseNoSlash)
          ? pathname.slice(baseNoSlash.length)
          : pathname;
        const normalizedPath = withoutBase.startsWith('/') ? withoutBase : `/${withoutBase}`;
        let strippedPath = normalizedPath;
        if (normalizedPath === '/en' || normalizedPath === '/it' || normalizedPath === '/fr') strippedPath = '/';
        else if (normalizedPath.startsWith('/en/')) strippedPath = normalizedPath.slice(3) || '/';
        else if (normalizedPath.startsWith('/it/')) strippedPath = normalizedPath.slice(3) || '/';
        else if (normalizedPath.startsWith('/fr/')) strippedPath = normalizedPath.slice(3) || '/';
        const targetBase = localeBase(targetLocale).replace(/\/$/, '');
        const routePath = strippedPath === '/' ? '' : strippedPath;
        return `${targetBase}${routePath}${search}${hash}` || '/';
      }

      function syncLocaleLinks() {
        localeLinks.forEach((link) => {
          const targetLocale = link.getAttribute('data-locale-code');
          if (!targetLocale) return;
          link.href = localizedUrl(targetLocale);
        });
      }

      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.textContent = open ? '✕' : '☰';
        });
        document.addEventListener('click', (e) => {
          if (!toggle.contains(e.target) && !nav.contains(e.target) && nav.classList.contains('open')) {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = '☰';
          }
        });
      }
      if (localeLinks.length > 0) {
        const originalReplaceState = window.history.replaceState.bind(window.history);
        const originalPushState = window.history.pushState.bind(window.history);
        window.history.replaceState = (...args) => {
          originalReplaceState(...args);
          syncLocaleLinks();
        };
        window.history.pushState = (...args) => {
          originalPushState(...args);
          syncLocaleLinks();
        };
        window.addEventListener('popstate', syncLocaleLinks);
        syncLocaleLinks();
      }
    </script>
  </body>
</html>
