---
import '../styles/global.css';
import '../utils/dataCache.ts';
import Breadcrumbs from './Breadcrumbs.astro';
import { useTranslations, getLocaleUrl } from '../i18n';

const { title = 'Bibliotheca Patristica', description = 'Acervo digital aberto da Patrologia Graeca, Latina e Orientalis de J.P. Migne — busca textual e metadados enriquecidos.', breadcrumbs = [] } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const baseWithSlash = `${base}/`;

const t = useTranslations(Astro.currentLocale);
// Mapeia locale para tag BCP-47 válida no atributo lang do HTML
const locale = Astro.currentLocale ?? 'pt-br';
const htmlLang = locale === 'en' ? 'en' : locale === 'it' ? 'it-IT' : 'pt-BR';

const localeOptions = [
  { code: 'pt-br', label: t.langSwitchPt },
  { code: 'en', label: t.langSwitchEn },
  { code: 'it', label: t.langSwitchIt },
] as const;
const localeRoot = locale === 'pt-br' ? baseWithSlash : `${baseWithSlash}${locale}/`;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${baseWithSlash}favicon.svg`} />
    <meta name="theme-color" content="#1f6b7a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bibliotheca Patristica" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseWithSlash}favicon.svg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="manifest" href={`${baseWithSlash}manifest.json`} />

    <slot name="head" />
    <style>
      @font-face { font-family: 'Source Serif 4'; font-style: normal; font-weight: 400; src: local('Source Serif 4'); }
      @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400; src: local('Inter'); }
      .lang-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem;
        border-radius: var(--radius, 6px);
        border: 1px solid var(--color-border);
        background: transparent;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-muted);
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
        white-space: nowrap;
      }
      .lang-switch:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      }
      .lang-switch .ls-option {
        padding: 0.2rem 0.55rem;
        border-radius: calc(var(--radius, 6px) - 2px);
        color: var(--color-muted);
      }
      .lang-switch .ls-option[aria-current="true"] {
        color: var(--color-accent);
        font-weight: 700;
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.skipToContent}</a>
    <div class="page-shell">
      <header class="topbar">
        <div class="wrapper header-grid">
          <div>
            <a href={base} class="logo" aria-label={t.logoLabel}>
              <span aria-hidden="true">📚</span> {t.logoText}
            </a>
            <div style="color: var(--color-muted); font-size: 0.95rem;">{t.tagline}</div>
          </div>
          <nav aria-label={t.navMenuLabel}>
            <button class="nav-toggle" aria-label={t.navMenuLabel} aria-expanded="false" aria-controls="primary-nav" id="nav-toggle">
              ☰
            </button>
            <div class="nav-links" id="primary-nav">
              <a href={`${baseWithSlash}search`}>{t.navSearch}</a>
              <a href={`${baseWithSlash}indices`}>{t.navIndices}</a>
              <div class="lang-switch" role="group" aria-label={t.langSwitchLabel}>
                {localeOptions.map((option) => (
                  <a
                    href={getLocaleUrl(option.code, Astro.url.pathname, base, Astro.url.search)}
                    class="ls-option"
                    aria-current={locale === option.code ? 'true' : undefined}
                    aria-label={option.label}
                    title={option.label}
                  >
                    {option.code === 'pt-br' ? 'PT' : option.code.toUpperCase()}
                  </a>
                ))}
              </div>
            </div>
          </nav>
        </div>
      </header>
      <main id="conteudo" class="wrapper" tabindex="-1">
        {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
        {Astro.slots.default ? <slot /> : null}
      </main>
      <aside class="wrapper disclaimer-wrapper" aria-label={t.disclaimerAriaLabel}>
        <div class="disclaimer-box">
          <p style="margin:0 0 0.5rem;"><strong>{t.disclaimerTitle}</strong></p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine1}</p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine2}</p>
          <p style="margin:0 0 0.4rem;">{t.disclaimerLine3}</p>
          {(Astro.currentLocale ?? 'pt-br') !== 'pt-br' && (
            <p style="margin:0; font-style: italic; color: var(--color-muted); font-size: 0.9rem;">{t.disclaimerDataLang}</p>
          )}
        </div>
      </aside>
      <footer class="footer">
        <div class="wrapper" style="padding:0;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-3);">
            <span set:html={t.footerLeft}></span>
            <span style="color:var(--color-muted);">{t.footerRight}</span>
          </div>
        </div>
      </footer>
    </div>
    <script type="module">
      //

      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('primary-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
          toggle.textContent = open ? '✕' : '☰';
        });
        document.addEventListener('click', (e) => {
          if (!toggle.contains(e.target) && !nav.contains(e.target) && nav.classList.contains('open')) {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = '☰';
          }
        });
      }
    </script>
  </body>
</html>
