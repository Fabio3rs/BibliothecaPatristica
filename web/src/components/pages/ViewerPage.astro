---
import Layout from '../Layout.astro';
import { useTranslations, serializeTranslations } from '../../i18n';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const t = useTranslations(Astro.currentLocale);
const uiStrings = serializeTranslations(t);
const uiLocale = Astro.currentLocale ?? 'pt-br';
---
<Layout title="Bibliotheca Patristica — Leitura" description="Visualizador de páginas do corpus patrístico com metadados enriquecidos e OCR." breadcrumbs={[{label: t.breadcrumbHome, href: baseWithSlash},{label: t.breadcrumbViewer}]}>
  <div id="viewer-root" style="min-height:60vh;">
    <div style="padding:var(--space-8) 0;text-align:center;color:var(--color-muted);">
      <p>{t.viewerLoading}</p>
    </div>
  </div>

  <script type="module" define:vars={{ assetBase: baseWithSlash, uiStrings, uiLocale }}>
    const viewerRoot = document.getElementById('viewer-root');
    let loadGeneration = 0;
    let rawOcrController = null;
    const dataCache = window.pdfocrDataCache;
    const getJsonOnce = (url) => dataCache?.getJsonOnce(url) ?? fetch(url).then((res) => {
      if (!res.ok) throw new Error(`HTTP ${res.status} ao buscar ${url}`);
      return res.json();
    });
    const loadJsonInBatches = (urls, options = {}) => dataCache?.loadJsonInBatches(urls, options) ?? Promise.all(urls.map((url) => getJsonOnce(url).then((value) => ({ url, ok: true, value }), (error) => ({ url, ok: false, value: null, error }))));

    // Reconstrói funções de formatação (não serializáveis via define:vars)
    const isEn = uiLocale === 'en';
    const isIt = uiLocale === 'it';
    const s = {
      ...uiStrings,
      viewerVolume: (id, title) => `Volume ${id}${title ? ' — ' + title : ''}`,
      viewerPage: isEn ? (n) => `Page ${n}` : isIt ? (n) => `Pagina ${n}` : (n) => `Página ${n}`,
      viewerPageOfTotal: isEn ? (n, t) => `Page ${n} of ${t}` : isIt ? (n, t) => `Pagina ${n} di ${t}` : (n, t) => `Página ${n} de ${t}`,
      viewerFirst: isEn ? 'First' : isIt ? 'Prima' : 'Primeira',
      viewerLast: isEn ? 'Last' : isIt ? 'Ultima' : 'Última',
      viewerGo: isEn ? 'Go' : isIt ? 'Vai' : 'Ir',
      viewerPageInputLabel: isEn ? 'Page number' : isIt ? 'Numero di pagina' : 'Número da página',
      viewerFocusMode: isEn ? 'Focus mode' : isIt ? 'Modalità focus' : 'Modo foco',
      viewerNormalMode: isEn ? 'Normal mode' : isIt ? 'Modalità normale' : 'Modo normal',
      viewerDecreaseFont: isEn ? 'A-' : 'A-',
      viewerIncreaseFont: isEn ? 'A+' : 'A+',
      viewerContinueReading: isEn ? 'Continue reading' : isIt ? 'Continua la lettura' : 'Continuar lendo',
      viewerProgress: isEn ? 'Progress' : isIt ? 'Progresso' : 'Progresso',
      viewerSearchInVolume: isEn ? 'Search in this volume…' : isIt ? 'Cerca in questo volume…' : 'Buscar neste volume…',
      viewerIndex: isEn ? 'Index' : isIt ? 'Indice' : 'Índice',
      viewerNoIdentity: isEn ? 'Volume information not available' : isIt ? 'Informazioni sul volume non disponibili' : 'Informação do volume não disponível',
      viewerRelatedSim: isEn ? (sim) => `similarity ${sim.toFixed(2)}` : isIt ? (sim) => `somiglianza ${sim.toFixed(2)}` : (sim) => `similaridade ${sim.toFixed(2)}`,
      viewerRelatedTitle: isEn
        ? (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · p. ${page}`
        : isIt
          ? (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · pag. ${page}`
        : (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · pág. ${page}`,
      viewerError: isEn ? (msg) => `Error loading viewer: ${msg}` : isIt ? (msg) => `Errore nel caricamento del visualizzatore: ${msg}` : (msg) => `Erro ao carregar viewer: ${msg}`,
      viewerVolumeLabel: (id, title) => `${isEn ? 'Volume' : 'Volume'} ${id}${title ? ' — ' + title : ''}`,
    };

    async function getJSON(path) {
      return getJsonOnce(path);
    }

    function safeUrl(raw) {
      if (!raw) return '#';
      try {
        const resolved = new URL(raw, window.location.origin);
        // Mesmo domínio: retorna caminho relativo
        if (resolved.origin === window.location.origin) return resolved.pathname + resolved.search + resolved.hash;
        // Externo http/https: permitido (o viewer é estático; http cobre servidores locais,
        // https cobre GitHub raw em produção — import.meta.env.DEV não é confiável em
        // builds estáticos servidos localmente pois é substituído por false no bundle)
        if (resolved.protocol === 'https:' || resolved.protocol === 'http:') return resolved.href;
        return '#';
      } catch (err) {
        if (raw.startsWith('/')) return raw;
        return '#';
      }
    }

    function labelize(ids = [], dict = []) {
      const map = new Map(dict.map((d) => [d.id, d.label]));
      return ids.map((id) => map.get(id) || id);
    }

    function keywordShardKeyFromId(keywordId) {
      const slug = String(keywordId || '').replace(/^k:/, '').trim().toLowerCase();
      if (!slug) return 'other';
      const first = slug[0];
      if (/[0-9]/.test(first)) return '0-9';
      if (/[a-z]/.test(first)) return first;
      return 'other';
    }

    async function loadKeywordsForIds(ids = []) {
      const uniqueIds = Array.from(new Set((ids || []).filter((id) => typeof id === 'string' && id.length > 0)));
      if (!uniqueIds.length) return [];

      const fallbackLookup = async () => {
        const lookup = await getJSON(`${assetBase}dict/keywords_lookup.json`)
          .catch(() => getJSON(`${assetBase}dict/keywords.json`));
        const dict = Array.isArray(lookup?.items) ? lookup.items : [];
        const map = new Map(dict.map((d) => [d.id, d.label]));
        return uniqueIds.map((id) => map.get(id) || id);
      };

      const manifest = await getJSON(`${assetBase}dict/keywords_manifest.json`).catch(() => null);
      if (!manifest?.shards?.length || manifest.strategy !== 'alpha') {
        return fallbackLookup();
      }

      const shardById = new Map(manifest.shards.map((shard) => [shard.id, shard.path]));
      const shardKeys = Array.from(new Set(uniqueIds.map((id) => keywordShardKeyFromId(id))));
      const shardPayloads = await loadJsonInBatches(
        shardKeys.map((shardKey) => shardById.get(shardKey)).filter(Boolean).map((shardPath) => `${assetBase}${shardPath}`),
        { batchSize: 4, delayMs: 12 },
      );

      const map = new Map();
      shardPayloads.forEach((payload) => {
        (payload.value?.items || []).forEach((item) => {
          if (item?.id && item?.label && !map.has(item.id)) {
            map.set(item.id, item.label);
          }
        });
      });

      const missing = uniqueIds.filter((id) => !map.has(id));
      if (missing.length) {
        const lookup = await getJSON(`${assetBase}dict/keywords_lookup.json`)
          .catch(() => getJSON(`${assetBase}dict/keywords.json`));
        const dict = Array.isArray(lookup?.items) ? lookup.items : [];
        const lookupMap = new Map(dict.map((d) => [d.id, d.label]));
        missing.forEach((id) => {
          if (lookupMap.has(id)) map.set(id, lookupMap.get(id));
        });
      }

      return uniqueIds.map((id) => map.get(id) || id);
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function escapeRegex(s) {
      return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function renderMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br>');
    }

    function applyHighlight(el, term) {
      if (!el || !term) return;
      // Extrai o texto plano (sem as tags HTML já renderizadas) para re-renderizar
      // com os highlights por cima do Markdown processado.
      const txt = el.textContent || '';
      if (!txt) return;
      const re = new RegExp(`(${escapeRegex(term)})`, 'gi');
      // Re-aplica o renderMarkdown sobre o texto original armazenado em data-raw,
      // preservando a formatação e adicionando os <mark>.
      const raw = el.dataset.raw || txt;
      // Se for XML bruto (classe viewer-ocr-xml), aplicar highlight seguro sobre os nós de texto
      if (el.classList && el.classList.contains('viewer-ocr-xml')) {
        // remove marcas anteriores
        Array.from(el.querySelectorAll('mark')).forEach((m) => {
          m.replaceWith(document.createTextNode(m.textContent));
        });

        // percorre nós de texto e envolve ocorrências em <mark>
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
        const textNodes = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode);
        textNodes.forEach((node) => {
          const parent = node.parentNode;
          if (!parent) return;
          const text = node.nodeValue || '';
          const matches = text.match(re);
          if (!matches) return;
          const frag = document.createDocumentFragment();
          let lastIndex = 0;
          text.replace(re, (match, offset) => {
            const before = text.slice(lastIndex, offset);
            if (before) frag.appendChild(document.createTextNode(before));
            const mk = document.createElement('mark');
            mk.textContent = match;
            frag.appendChild(mk);
            lastIndex = offset + match.length;
          });
          const after = text.slice(lastIndex);
          if (after) frag.appendChild(document.createTextNode(after));
          parent.replaceChild(frag, node);
        });
      } else {
        el.innerHTML = renderMarkdown(raw).replace(re, (_, m) => `<mark>${escapeHtml(m)}</mark>`);
      }
    }

    // Simple XML syntax highlighter — escapes HTML then wraps tags/attrs/names
    function highlightXml(txt) {
      if (!txt) return '';
      const esc = escapeHtml(txt);
      // Regex to capture tags and attributes (simple, not full XML parser)
      return esc
        .replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="xml-comment">$1</span>')
        .replace(/(&lt;\/?)([a-zA-Z0-9_:-]+)([^&]*?)(&gt;)/g, (_m, open, name, rest, close) => {
          // color attributes inside rest
          const attrs = rest.replace(/([a-zA-Z0-9:_-]+)(=)\"([^\"]*)\"/g, '<span class="xml-attr">$1</span>$2<span class="xml-value">"$3"</span>');
          return `${open}<span class="xml-name">${name}</span>${attrs}${close}`;
        })
        .replace(/([^&]|^)([^\n]+)/g, (m) => m); // noop for other text
    }

    // ── Parser e renderer de OCR estruturado ──
    function parseOcrXml(xmlText) {
      try {
        const parser = new DOMParser();
        const doc = parser.parseFromString(xmlText, 'application/xml');
        const pagina = doc.querySelector('pagina');
        if (!pagina) return null;
        const estado = pagina.getAttribute('estado') || '';
        const blocos = Array.from(pagina.querySelectorAll('bloco')).map((b) => {
          const bbox = (b.getAttribute('bbox') || '').split(',').map(Number);
          return {
            tipo: b.getAttribute('tipo') || 'outro',
            script: b.getAttribute('script') || 'desconhecido',
            bbox: bbox.length === 4 ? bbox : null,
            text: (b.textContent || '').trim(),
          };
        }).filter((b) => b.text.length > 0);
        let width = 0;
        let height = 0;
        blocos.forEach((b) => {
          if (b.bbox) {
            width = Math.max(width, b.bbox[2]);
            height = Math.max(height, b.bbox[3]);
          }
        });
        return { estado, blocos, width, height };
      } catch (e) {
        console.warn('OCR XML parse error:', e);
        return null;
      }
    }

    function scriptLabel(script) {
      const labels = {
        latino: 'Latino', latin: 'Latino',
        grego: 'Grego',
        copta: 'Copta', copte: 'Copta', copto: 'Copta',
        siriaco: 'Siríaco',
        cirilico: 'Cirílico',
        ethiopico: 'Etíope',
        armenio: 'Armênio',
        arabe: 'Árabe',
        hebraico: 'Hebraico',
        misto: 'Misto',
        desconhecido: '?',
      };
      return labels[script?.toLowerCase()] || (script || '?');
    }

    function typeLabel(tipo) {
      const labels = {
        cabecalho: 'Cabeçalho',
        texto_principal: 'Texto',
        aparato_critico: 'Aparato crítico',
        rodape: 'Rodapé',
        nota: 'Nota',
        nota_marginal: 'Nota marginal',
        outro: 'Outro',
        titulo: 'Título',
        capa_ou_guarda: 'Capa',
      };
      return labels[tipo?.toLowerCase()] || (tipo || 'Bloco');
    }

    function renderOcrStructured(container, ocrData) {
      container.innerHTML = '';
      if (!ocrData || !ocrData.blocos.length) {
        container.innerHTML = `<p style="color:var(--color-muted);margin:0;">${s.viewerOcrNoBlocks}</p>`;
        return;
      }

      const wrap = document.createElement('div');
      wrap.className = 'viewer-ocr-body';

      // Legenda compacta de scripts
      const scriptsSeen = new Set(ocrData.blocos.map((b) => b.script));
      if (scriptsSeen.size > 1) {
        const legend = document.createElement('div');
        legend.style.cssText = 'display:flex; gap:var(--space-2); flex-wrap:wrap; margin-bottom:var(--space-3); font-size:0.75rem; color:var(--color-muted);';
        scriptsSeen.forEach((sc) => {
          const chip = document.createElement('span');
          chip.style.cssText = 'display:inline-flex; align-items:center; gap:6px; padding:2px 8px; border-radius:var(--radius-s); background:var(--color-surface-2); border:1px solid var(--color-border);';
          const colorDot = document.createElement('span');
          colorDot.className = 'ocr-script-chip';
          // map script -> color
          const scriptColors = {
            latino: '#2b8cbe',
            latin: '#2b8cbe',
            grego: '#8da0cb',
            copta: '#e78ac3',
            siriaco: '#66c2a5',
            cirilico: '#a6d854',
            ethiopico: '#fc8d62',
            armenio: '#ffd92f',
            arabe: '#e5c494',
            hebraico: '#b3b3b3',
            misto: '#999999',
            desconhecido: '#999999'
          };
          const key = (sc || '').toLowerCase();
          colorDot.style.background = scriptColors[key] || '#b0b0b0';
          chip.appendChild(colorDot);
          const label = document.createElement('span');
          label.textContent = scriptLabel(sc);
          chip.appendChild(label);
          legend.appendChild(chip);
        });
        wrap.appendChild(legend);
      }

      ocrData.blocos.forEach((bloco) => {
        const el = document.createElement('div');
        const tipoNorm = bloco.tipo.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const scriptNorm = (bloco.script || '').toLowerCase().replace(/[^a-z0-9]/g, '_');
        el.className = `ocr-block type-${tipoNorm} script-${scriptNorm}`;

        // Apenas mostrar meta para tipos não-comuns ou scripts não-latinos
        const isCommon = ['corpo', 'texto', 'paragrafo', 'outro'].includes(tipoNorm);
        const isLatin = ['latino', 'latin', 'desconhecido'].includes(bloco.script?.toLowerCase());
        const showMeta = !isCommon || !isLatin;

        if (showMeta) {
          const meta = document.createElement('div');
          meta.style.cssText = 'font-size:0.72rem; color:var(--color-muted); margin-bottom:0.25em; display:flex; gap:var(--space-2);';
          // adicionar chip colorido ao lado do script
          if (!isLatin && bloco.script) {
            const span = document.createElement('span');
            span.className = 'meta-script';
            const dot = document.createElement('span');
            dot.className = 'ocr-script-chip';
            const scriptColors = {
              latino: '#2b8cbe',
              latin: '#2b8cbe',
              grego: '#8da0cb',
              copta: '#e78ac3',
              siriaco: '#66c2a5',
              cirilico: '#a6d854',
              ethiopico: '#fc8d62',
              armenio: '#ffd92f',
              arabe: '#e5c494',
              hebraico: '#b3b3b3',
              misto: '#999999',
              desconhecido: '#999999'
            };
            dot.style.background = scriptColors[(bloco.script || '').toLowerCase()] || '#b0b0b0';
            const lbl = document.createElement('span'); lbl.textContent = `· ${scriptLabel(bloco.script)}`;
            span.appendChild(dot);
            span.appendChild(lbl);
            meta.appendChild(document.createElement('span'));
            meta.firstChild.textContent = typeLabel(bloco.tipo);
            meta.appendChild(span);
          } else {
            meta.innerHTML = `<span>${typeLabel(bloco.tipo)}</span>`;
          }
          el.appendChild(meta);
        }

        const text = document.createElement('div');
        text.textContent = bloco.text;
        el.appendChild(text);
        wrap.appendChild(el);
      });

      container.appendChild(wrap);
    }

    function renderOcrVisual(container, ocrData) {
      container.innerHTML = '';
      if (!ocrData || !ocrData.blocos.length) {
        container.innerHTML = `<p style="color:var(--color-muted);margin:0;">${s.viewerOcrNoBlocks}</p>`;
        return;
      }
      const { width, height, blocos } = ocrData;
      if (!width || !height) {
        renderOcrStructured(container, ocrData);
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'viewer-ocr-visual';
      const aspect = (height / width) * 100;
      const spacer = document.createElement('div');
      spacer.style.paddingTop = aspect + '%';
      wrap.appendChild(spacer);
      blocos.forEach((bloco, idx) => {
        if (!bloco.bbox) return;
        const [x1, y1, x2, y2] = bloco.bbox;
        const el = document.createElement('div');
        const tipoNorm = bloco.tipo.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const scriptNorm = (bloco.script || '').toLowerCase().replace(/[^a-z0-9]/g, '_');
        el.className = `ocr-block type-${tipoNorm} script-${scriptNorm}`;
        el.style.position = 'absolute';
        el.style.left = (x1 / width * 100) + '%';
        el.style.top = (y1 / height * 100) + '%';
        el.style.width = ((x2 - x1) / width * 100) + '%';
        el.style.height = ((y2 - y1) / height * 100) + '%';
        el.style.overflow = 'hidden';
        el.style.fontSize = `clamp(0.45rem, ${((y2 - y1) / height * 100) / 4}vw, 0.9rem)`;
        el.style.padding = '2px 4px';
        el.style.boxSizing = 'border-box';
        el.style.zIndex = String(idx);
        const text = document.createElement('span');
        text.textContent = bloco.text;
        text.style.wordBreak = 'break-word';
        text.style.lineHeight = '1.15';
        el.appendChild(text);
        el.title = `${typeLabel(bloco.tipo)} · ${scriptLabel(bloco.script)}\n${bloco.text}`;
        wrap.appendChild(el);
      });
      container.appendChild(wrap);
    }

    async function load() {
      try {
        const generation = ++loadGeneration;
        if (rawOcrController) rawOcrController.abort();
        rawOcrController = null;
        document.body.classList.add('viewer-active');
        const url = new URL(window.location.href);
        const doc = url.searchParams.get('doc') || 'PG144';
        const highlight = (url.searchParams.get('highlight') || '').trim();

        const volumes = await getJSON(`${assetBase}volumes.json`);

        const volume = volumes.volumes.find((v) => v.id === doc);
        if (!volume) throw new Error(isIt ? 'Volume non trovato nei mock' : 'Volume não encontrado nos mocks');
        const requestedPage = Number(url.searchParams.get('page'));
        const pageNumber = Number.isFinite(requestedPage) && requestedPage > 0
          ? Math.min(Math.max(requestedPage, volume.page_first || 1), volume.page_last || requestedPage)
          : (volume.page_first || 1);

        const meta = await getJSON(`${assetBase}${volume.meta_url.replace(/^\//, '')}`);
        const block = meta.page_blocks.find((b) => pageNumber >= b.page_first && pageNumber <= b.page_last);
        if (!block) throw new Error(isIt ? 'Blocco non trovato' : 'Bloco não encontrado');

        const blockData = await getJSON(`${assetBase}${block.file.replace(/^\//, '')}`);
        const page = blockData.pages.find((p) => p.page === pageNumber) || blockData.pages[0];

        const [keywordsLabels, entities, collections] = await Promise.all([
          loadKeywordsForIds(page.keyword_ids || []),
          getJSON(`${assetBase}dict/entities.json`),
          getJSON(`${assetBase}dict/collections.json`),
        ]);

        const segmentsFile = meta.segment_blocks?.[0]?.file;
        const snapshotFile = meta.snapshot_blocks?.[0]?.file;
        const segments = segmentsFile ? (await getJSON(`${assetBase}${segmentsFile.replace(/^\//, '')}`)).segments : [];
        const snapshots = snapshotFile ? (await getJSON(`${assetBase}${snapshotFile.replace(/^\//, '')}`)).snapshots : [];

        const pageSnapshots = snapshots.filter((s) => (page.snapshot_ids || []).includes(s.id));

        const entitiesLabels = labelize(page.entity_ids, entities.items);
        const snapshotLabels = pageSnapshots.map((s) => s.label);
        const summaryGlobal = page.summary_global || pageSnapshots[0]?.summary || '';

        // Atualizar título da aba e breadcrumb
        document.title = `${s.viewerVolumeLabel(volume.id, volume.title || '')} · ${s.viewerPage(page.page)} | Bibliotheca Patristica`;
        if (generation !== loadGeneration) return;
        const breadcrumbsEl = document.querySelector('.breadcrumbs ol');
        if (breadcrumbsEl) {
          breadcrumbsEl.innerHTML = `
            <li style="display:flex;align-items:center;gap:0.35rem;">
              <a href="${assetBase}">${uiStrings.breadcrumbHome || (isEn ? 'Home' : isIt ? 'Home' : 'Início')}</a>
            </li>
            <li style="display:flex;align-items:center;gap:0.35rem;" aria-hidden="true"><span>/</span></li>
            <li style="display:flex;align-items:center;gap:0.35rem;"><span>${s.viewerVolumeLabel(volume.id, volume.title || '')}</span></li>
            <li style="display:flex;align-items:center;gap:0.35rem;" aria-hidden="true"><span>/</span></li>
            <li style="display:flex;align-items:center;gap:0.35rem;"><span aria-current="page">${s.viewerPage(page.page)}</span></li>
          `;
        }

        // Bookmark: save current position
        try {
          const bookmarks = JSON.parse(localStorage.getItem('viewerBookmarks') || '{}');
          bookmarks[doc] = { page: pageNumber, ts: Date.now() };
          localStorage.setItem('viewerBookmarks', JSON.stringify(bookmarks));
        } catch (_) {}

        viewerRoot.innerHTML = '';
        if (generation !== loadGeneration) return;

        // Injetar estilos do viewer apenas uma vez
        if (!document.getElementById('viewer-styles')) {
          const styleTag = document.createElement('style');
          styleTag.id = 'viewer-styles';
          styleTag.textContent = `
            .viewer-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: start; gap: var(--space-6); }
            @media (min-width: 1400px) { .viewer-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-8); } }
            @media (max-width: 1100px) { .viewer-grid { grid-template-columns: 1fr; gap: var(--space-4); } }
            .viewer-grid aside { order: 2; }
            .viewer-grid .main-content { order: 1; }
            .viewer-grid aside { position: sticky; top: 5.75rem; align-self: start; }
            @media (max-width: 1100px) { .viewer-grid aside { position: static; } }
            .viewer-header-nav { display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; }
            .viewer-header-nav .button.disabled { opacity: 0.45; pointer-events: none; cursor: default; }
            .viewer-header-nav input[type="number"] { width: 4.5rem; padding: 0.35rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-s); background: var(--color-surface); color: var(--color-ink); font-size: 0.9rem; text-align: center; }
            .viewer-header-nav input[type="number"]:focus { outline: 2px solid var(--color-accent); outline-offset: 2px; }
            .viewer-header-nav .button { padding: 0.35rem 0.65rem; font-size: 0.85rem; }
            .viewer-action-bar { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
            @media (max-width: 720px) {
              .viewer-header-nav .button { padding: 0.3rem 0.5rem; font-size: 0.8rem; }
              .viewer-header-nav input[type="number"] { width: 3.8rem; font-size: 0.85rem; }
            }
            @media (max-width: 480px) {
              .viewer-header-nav { gap: 4px; }
              .viewer-header-nav .button { padding: 0.25rem 0.4rem; font-size: 0.75rem; min-width: 2rem; text-align: center; }
              .viewer-header-nav .nav-label-text { display: none; }
            }
            .viewer-identity { margin-bottom: var(--space-4); padding: var(--space-4); border-radius: var(--radius-m); background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-2) 100%); border: 1px solid var(--color-border); }
            .viewer-identity h3 { margin: 0 0 var(--space-2); font-family: var(--font-serif); color: var(--color-accent); font-size: 1.15rem; }
            @media (min-width: 1400px) { .viewer-identity h3 { font-size: 1.35rem; } }
            .viewer-identity p { margin: 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.5; }
            .viewer-identity .identity-meta-wrap { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-top: var(--space-2); }
            .viewer-identity .identity-badge { display: inline-block; padding: 2px 8px; border-radius: var(--radius-s); background: var(--color-surface); border: 1px solid var(--color-border); font-size: 0.75rem; color: var(--color-muted); }
            .viewer-progress-bar { width: 100%; height: 4px; background: var(--color-border); border-radius: 2px; margin-top: var(--space-3); overflow: hidden; }
            .viewer-progress-bar > div { height: 100%; background: var(--color-accent); border-radius: 2px; transition: width 0.3s ease; }
            .viewer-focus-mode .viewer-grid { grid-template-columns: 1fr !important; }
            .viewer-focus-mode aside { display: none !important; }
            .viewer-focus-mode .main-content { max-width: 720px; margin: 0 auto; }
            @media (min-width: 1400px) { .viewer-focus-mode .main-content { max-width: 800px; } }
            .viewer-bookmark-banner { margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-m); background: var(--color-surface-2); border: 1px solid var(--color-accent); display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
            .viewer-index-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(3rem, 1fr)); gap: 4px; max-height: 200px; overflow-y: auto; }
            @media (min-width: 1400px) { .viewer-index-list { max-height: 320px; grid-template-columns: repeat(auto-fill, minmax(3.2rem, 1fr)); } }
            .viewer-index-list a { display: block; padding: 4px; text-align: center; border-radius: var(--radius-s); font-size: 0.8rem; text-decoration: none; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-border); transition: all 0.15s; }
            .viewer-index-list a:hover, .viewer-index-list a.current { background: var(--color-accent); color: white; border-color: var(--color-accent); }
            .viewer-ocr-body { font-family: var(--font-serif); line-height: 1.8; font-size: 1.05rem; }
            .viewer-ocr-body .ocr-block { margin-bottom: 1em; }
            .viewer-ocr-body .ocr-block.titulo { font-weight: 700; font-size: 1.2em; color: var(--color-accent); }
            .viewer-ocr-body .ocr-block.nota { font-size: 0.9em; color: var(--color-muted); border-left: 3px solid var(--color-border); padding-left: 1em; }
            .viewer-ocr-body .ocr-block.cabecalho { font-variant: small-caps; letter-spacing: 0.05em; }
            /* Chips to indicate script with a visible color */
            .ocr-script-chip { display:inline-block; width:10px; height:10px; border-radius:50%; margin-left:6px; vertical-align:middle; border:1px solid rgba(0,0,0,0.08); }
            .ocr-block .meta-script { display:inline-flex; align-items:center; gap:6px; }

            /* XML syntax highlight for plain OCR view */
            pre.viewer-ocr-xml { font-family:var(--font-mono, monospace); font-size:0.82rem; line-height:1.6; white-space:pre-wrap; word-break:break-word; }
            pre.viewer-ocr-xml .xml-tag { color: #0b5; }
            pre.viewer-ocr-xml .xml-name { color: #07f; }
            pre.viewer-ocr-xml .xml-attr { color: #c67; }
            pre.viewer-ocr-xml .xml-value { color: #a31515; }
            pre.viewer-ocr-xml .xml-text { color: var(--color-text); }
            .viewer-toolbar { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
            @media (max-width: 480px) { .viewer-toolbar { flex-direction: column; align-items: stretch; } .viewer-search-local { width: 100%; } }
            .viewer-search-local { display: flex; gap: var(--space-2); align-items: center; flex: 1; min-width: 200px; }
            .viewer-search-local input { flex: 1; padding: 0.4rem 0.6rem; border: 1px solid var(--color-border); border-radius: var(--radius-s); background: var(--color-surface); color: var(--color-ink); font-size: 0.9rem; }
            .viewer-search-local input:focus { outline: 2px solid var(--color-accent); outline-offset: 2px; }
            .viewer-sidebar-section { margin-bottom: var(--space-4); }
            .viewer-sidebar-section h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 0.75rem; }
            /* Layout wide no viewer */
            body.viewer-active .wrapper { max-width: 1400px; }
            @media (min-width: 1600px) { body.viewer-active .wrapper { max-width: 1600px; } }
            /* OCR visual layout */
            .viewer-ocr-visual { position: relative; width: 100%; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-s); overflow: auto; min-height: 65vh; }
            .viewer-ocr-visual .ocr-block { position: absolute; margin-bottom: 0; border-radius: 2px; min-height: 1.6em; min-width: 3ch; overflow: hidden; }
            .viewer-ocr-visual .ocr-block.type-cabecalho { text-align: center; }
            .viewer-ocr-visual .ocr-block:hover { z-index: 999 !important; box-shadow: 0 0 0 2px var(--color-accent); overflow: visible; background: var(--color-surface); }
            .viewer-segments-index a.segment-active { border-color: var(--color-accent); background: var(--color-surface-2); }
            .viewer-segments-index a.segment-active span:first-child { color: var(--color-accent); }

          `;
          document.head.appendChild(styleTag);
        }

        const mainGrid = document.createElement('div');
        mainGrid.className = 'main-grid viewer-grid';
        
        const mainContent = document.createElement('div');
        mainContent.className = 'card';
        
        const sidebar = document.createElement('aside');
        sidebar.style.cssText = 'display:flex; flex-direction:column; gap:var(--space-4);';

        // Calcular limites de página a partir dos blocos de metadados
        const allBlocks = meta.page_blocks || [];
        const firstPage = allBlocks.length ? allBlocks[0].page_first : 1;
        const lastPage = allBlocks.length ? allBlocks[allBlocks.length - 1].page_last : pageNumber;

        function buildNavUrl(targetPage) {
          const p = new URLSearchParams({ doc, page: String(targetPage) });
          if (highlight) p.set('highlight', highlight);
          return `?${p.toString()}`;
        }

        // Cabeçalho com Navegação
        // ── Cartão de identidade do volume ──
        const identityCard = document.createElement('div');
        identityCard.className = 'viewer-identity';
        identityCard.style.marginBottom = 'var(--space-4)';

        // Tentar extrair autor/obra do snapshot global
        let volumeAuthor = '';
        let volumeWork = '';
        let volumeSummary = '';
        try {
          const snapshotFile = meta.snapshot_blocks?.[0]?.file;
          if (snapshotFile) {
            const snapData = await getJSON(`${assetBase}${snapshotFile.replace(/^\//, '')}`);
            const globalSnap = snapData.snapshots?.find((s) => s.kind === 'volume_summary');
            if (globalSnap?.summary) {
              const lines = globalSnap.summary.split('\n');
              for (const line of lines) {
                if (line.startsWith('Autor:')) volumeAuthor = line.replace('Autor:', '').trim();
                else if (line.startsWith('Livro/obra identificada:')) volumeWork = line.replace('Livro/obra identificada:', '').trim();
                else if (!volumeSummary && line.trim().length > 10 && !line.includes('não há conteúdo anterior')) volumeSummary = line.trim();
              }
              if (!volumeSummary) volumeSummary = lines.find((l) => l.trim().length > 20 && !l.includes('não há conteúdo anterior')) || '';
            }
          }
        } catch (e) { /* ignore */ }

        const volCollectionLabel = collections.items.find((c) => c.id === volume.collection_id)?.label || volume.collection_id;
        const identityTitle = document.createElement('h3');
        identityTitle.textContent = volumeAuthor && volumeWork ? `${volumeAuthor} — ${volumeWork}` : (volumeWork || volumeAuthor || s.viewerVolumeLabel(volume.id, volume.title || ''));
        identityCard.appendChild(identityTitle);

        const identityMetaWrap = document.createElement('div');
        identityMetaWrap.className = 'identity-meta-wrap';

        const badgeCollection = document.createElement('span');
        badgeCollection.className = 'identity-badge';
        badgeCollection.textContent = volCollectionLabel;
        identityMetaWrap.appendChild(badgeCollection);

        const badgePage = document.createElement('span');
        badgePage.className = 'identity-badge';
        badgePage.textContent = s.viewerPageOfTotal(pageNumber, lastPage);
        identityMetaWrap.appendChild(badgePage);

        if (volumeSummary) {
          const summaryP = document.createElement('p');
          summaryP.style.cssText = 'margin: var(--space-2) 0 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.5;';
          summaryP.textContent = volumeSummary.substring(0, 200) + (volumeSummary.length > 200 ? '…' : '');
          identityCard.appendChild(identityMetaWrap);
          identityCard.appendChild(summaryP);
        } else {
          identityCard.appendChild(identityMetaWrap);
        }

        // Barra de progresso
        const progressWrap = document.createElement('div');
        progressWrap.className = 'viewer-progress-bar';
        progressWrap.setAttribute('role', 'progressbar');
        progressWrap.setAttribute('aria-valuemin', '0');
        progressWrap.setAttribute('aria-valuemax', String(lastPage));
        progressWrap.setAttribute('aria-valuenow', String(pageNumber));
        progressWrap.setAttribute('aria-label', s.viewerProgress);
        const progressBar = document.createElement('div');
        const progressPct = lastPage > 1 ? ((pageNumber - 1) / (lastPage - 1) * 100) : 100;
        progressBar.style.width = `${progressPct}%`;
        progressWrap.appendChild(progressBar);
        identityCard.appendChild(progressWrap);

        // ── Barra de ferramentas ──
        const toolbar = document.createElement('div');
        toolbar.className = 'viewer-toolbar';

        // Modo foco
        const focusBtn = document.createElement('button');
        focusBtn.className = 'button secondary';
        focusBtn.style.fontSize = '0.8rem';
        let isFocusMode = false;
        focusBtn.textContent = s.viewerFocusMode;
        focusBtn.addEventListener('click', () => {
          isFocusMode = !isFocusMode;
          viewerRoot.classList.toggle('viewer-focus-mode', isFocusMode);
          focusBtn.textContent = isFocusMode ? s.viewerNormalMode : s.viewerFocusMode;
          try { localStorage.setItem('viewerFocusMode', isFocusMode ? '1' : '0'); } catch (_) {}
        });
        try { if (localStorage.getItem('viewerFocusMode') === '1') { isFocusMode = true; viewerRoot.classList.add('viewer-focus-mode'); focusBtn.textContent = s.viewerNormalMode; } } catch (_) {}

        // Font size
        const fontDown = document.createElement('button');
        fontDown.className = 'button secondary';
        fontDown.style.fontSize = '0.8rem';
        fontDown.textContent = s.viewerDecreaseFont;
        const fontUp = document.createElement('button');
        fontUp.className = 'button secondary';
        fontUp.style.fontSize = '0.8rem';
        fontUp.textContent = s.viewerIncreaseFont;

        let fontSizeLevel = parseInt(localStorage.getItem('viewerFontSize') || '0', 10) || 0;
        function applyFontSize() {
          const sizes = ['0.95rem', '1.05rem', '1.15rem', '1.3rem'];
          const idx = Math.max(0, Math.min(fontSizeLevel + 1, sizes.length - 1));
          mainContent.style.fontSize = sizes[idx];
          try { localStorage.setItem('viewerFontSize', String(fontSizeLevel)); } catch (_) {}
        }
        applyFontSize();
        fontDown.addEventListener('click', () => { fontSizeLevel = Math.max(-1, fontSizeLevel - 1); applyFontSize(); });
        fontUp.addEventListener('click', () => { fontSizeLevel = Math.min(2, fontSizeLevel + 1); applyFontSize(); });

        // Busca local
        const localSearchWrap = document.createElement('div');
        localSearchWrap.className = 'viewer-search-local';
        const localSearchInput = document.createElement('input');
        localSearchInput.type = 'search';
        localSearchInput.placeholder = s.viewerSearchInVolume;
        localSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && localSearchInput.value.trim()) {
            window.location.href = `${assetBase}search?term=${encodeURIComponent(localSearchInput.value.trim())}&volume=${encodeURIComponent(doc)}`;
          }
        });
        localSearchWrap.appendChild(localSearchInput);

        toolbar.appendChild(focusBtn);
        toolbar.appendChild(fontDown);
        toolbar.appendChild(fontUp);
        toolbar.appendChild(localSearchWrap);

        const actionBar = document.createElement('div');
        actionBar.className = 'viewer-action-bar';
        const copyExcerptBtn = document.createElement('button');
        copyExcerptBtn.className = 'button secondary';
        copyExcerptBtn.style.fontSize = '0.8rem';
        copyExcerptBtn.textContent = isEn ? 'Copy excerpt' : isIt ? 'Copia estratto' : 'Copiar trecho';
        const copyRefBtn = document.createElement('button');
        copyRefBtn.className = 'button secondary';
        copyRefBtn.style.fontSize = '0.8rem';
        copyRefBtn.textContent = isEn ? 'Copy reference' : isIt ? 'Copia riferimento' : 'Copiar referência';
        const reportBtn = document.createElement('a');
        reportBtn.className = 'button secondary';
        reportBtn.style.fontSize = '0.8rem';
        reportBtn.target = '_blank';
        reportBtn.rel = 'noreferrer';
        reportBtn.textContent = isEn ? 'Report issue' : isIt ? 'Segnala errore' : 'Reportar erro';
        actionBar.appendChild(copyExcerptBtn);
        actionBar.appendChild(copyRefBtn);
        actionBar.appendChild(reportBtn);

        // ── Índice de páginas (collapsible) ──
        const indexDetails = document.createElement('details');
        indexDetails.style.marginBottom = 'var(--space-4)';
        const indexSummary = document.createElement('summary');
        indexSummary.style.cssText = 'cursor:pointer; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); user-select:none; list-style:none; display:flex; align-items:center; gap:var(--space-2);';
        indexSummary.innerHTML = `<span style="display:inline-block;transition:transform 0.2s;" class="idx-arrow">▶</span> ${s.viewerIndex}`;
        indexDetails.appendChild(indexSummary);

        const indexList = document.createElement('ul');
        indexList.className = 'viewer-index-list';
        for (let p = firstPage; p <= lastPage; p++) {
          const a = document.createElement('a');
          a.textContent = String(p);
          a.href = buildNavUrl(p);
          if (p === pageNumber) { a.classList.add('current'); a.setAttribute('aria-current', 'page'); }
          const li = document.createElement('li');
          li.appendChild(a);
          indexList.appendChild(li);
        }
        indexDetails.appendChild(indexList);
        indexDetails.addEventListener('toggle', () => {
          const arrow = indexDetails.querySelector('.idx-arrow');
          if (arrow) arrow.style.transform = indexDetails.open ? 'rotate(90deg)' : '';
        });

        const header = document.createElement('header');
        header.style.cssText = 'display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); margin-bottom:var(--space-5); border-bottom:1px solid var(--color-border); padding-bottom:var(--space-4); flex-wrap: wrap;';

        const titleGroup = document.createElement('div');
        const volP = document.createElement('p');
        volP.style.margin = '0';
        volP.style.color = 'var(--color-muted)';
        volP.textContent = s.viewerVolumeLabel(volume.id, volume.title || '');
        const h2 = document.createElement('h2');
        h2.style.margin = '0';
        h2.textContent = s.viewerPage(page.page);
        titleGroup.appendChild(volP);
        titleGroup.appendChild(h2);
        header.appendChild(titleGroup);

        const navGroup = document.createElement('div');
        navGroup.className = 'viewer-header-nav';

        const hasPrev = pageNumber > firstPage;
        const hasNext = pageNumber < lastPage;

        function makeNavBtn(text, targetPage, enabled, ariaLabel, iconText) {
          const a = document.createElement('a');
          a.className = `button secondary${enabled ? '' : ' disabled'}`;
          // Em telas pequenas, mostra apenas ícone/símbolo; em maiores, texto
          a.innerHTML = `<span class="nav-icon" aria-hidden="true">${iconText || text}</span><span class="nav-label-text">${text}</span>`;
          a.setAttribute('aria-disabled', enabled ? 'false' : 'true');
          if (ariaLabel) a.setAttribute('aria-label', ariaLabel);
          if (enabled) a.href = buildNavUrl(targetPage);
          return a;
        }

        const firstBtn = makeNavBtn(s.viewerFirst || '<<', firstPage, pageNumber > firstPage, s.viewerFirst, '⏮');
        const prevBtn = makeNavBtn(s.viewerPrev, pageNumber - 1, hasPrev, s.viewerPrev, '◀');
        const nextBtn = makeNavBtn(s.viewerNext, pageNumber + 1, hasNext, s.viewerNext, '▶');
        const lastBtn = makeNavBtn(s.viewerLast || '>>', lastPage, pageNumber < lastPage, s.viewerLast, '⏭');

        const pageInputWrap = document.createElement('span');
        pageInputWrap.style.cssText = 'display:inline-flex; align-items:center; gap:var(--space-1); font-size:0.9rem; color:var(--color-muted);';

        const pageInput = document.createElement('input');
        pageInput.type = 'number';
        pageInput.min = String(firstPage);
        pageInput.max = String(lastPage);
        pageInput.value = String(pageNumber);
        pageInput.setAttribute('aria-label', s.viewerPageInputLabel || 'Page number');

        const pageTotalSpan = document.createElement('span');
        pageTotalSpan.textContent = `${isEn ? 'of' : isIt ? 'di' : 'de'} ${lastPage}`;

        pageInput.addEventListener('change', () => {
          let v = parseInt(pageInput.value, 10);
          if (isNaN(v)) return;
          if (v < firstPage) v = firstPage;
          if (v > lastPage) v = lastPage;
          window.location.href = buildNavUrl(v);
        });
        pageInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') pageInput.dispatchEvent(new Event('change'));
        });

        pageInputWrap.appendChild(pageInput);
        pageInputWrap.appendChild(pageTotalSpan);

        navGroup.appendChild(firstBtn);
        navGroup.appendChild(prevBtn);
        navGroup.appendChild(pageInputWrap);
        navGroup.appendChild(nextBtn);
        navGroup.appendChild(lastBtn);

        // Link de retorno à busca (se veio de uma busca com highlight)
        if (highlight) {
          const backLink = document.createElement('a');
          backLink.className = 'button secondary';
          backLink.style.fontSize = '0.85rem';
          const backParams = new URLSearchParams({ term: highlight });
          backLink.href = `${assetBase}search?${backParams.toString()}`;
          backLink.textContent = s.viewerBack;
          navGroup.prepend(backLink);
        }

        // Atalhos de teclado para navegação
        document.addEventListener('keydown', (e) => {
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable)) return;
          if (e.key === 'ArrowLeft' && hasPrev) { e.preventDefault(); window.location.href = buildNavUrl(pageNumber - 1); }
          if (e.key === 'ArrowRight' && hasNext) { e.preventDefault(); window.location.href = buildNavUrl(pageNumber + 1); }
        });

        header.appendChild(navGroup);

        const citationText = `${volume.id} p. ${page.page}`;
        reportBtn.href = `https://github.com/Fabio3rs/BibliothecaPatristica/issues/new?title=${encodeURIComponent(`${citationText} — ${volumeAuthor || volumeWork || volume.id}`)}&body=${encodeURIComponent(`URL: ${window.location.href}\n\nObservação:\n`)}`;
        copyExcerptBtn.addEventListener('click', async () => {
          const text = (page.excerpt || page.summary_page || summaryGlobal || '').trim();
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            copyExcerptBtn.textContent = isEn ? 'Copied' : isIt ? 'Copiato' : 'Copiado';
            setTimeout(() => {
              copyExcerptBtn.textContent = isEn ? 'Copy excerpt' : isIt ? 'Copia estratto' : 'Copiar trecho';
            }, 1200);
          } catch (_) {}
        });
        copyRefBtn.addEventListener('click', async () => {
          const text = `${citationText}${page.title ? ` — ${page.title}` : ''}`;
          try {
            await navigator.clipboard.writeText(text);
            copyRefBtn.textContent = isEn ? 'Copied' : isIt ? 'Copiato' : 'Copiado';
            setTimeout(() => {
              copyRefBtn.textContent = isEn ? 'Copy reference' : isIt ? 'Copia riferimento' : 'Copiar referência';
            }, 1200);
          } catch (_) {}
        });

        mainContent.appendChild(identityCard);
        mainContent.appendChild(toolbar);
        mainContent.appendChild(actionBar);
        mainContent.appendChild(header);

        // Índice de páginas: em telas grandes (>1100px) vai para a sidebar
        const isWide = window.innerWidth > 1100;
        if (isWide) {
          // Mover índice para sidebar com wrapper
          const sidebarIndexWrap = document.createElement('div');
          sidebarIndexWrap.className = 'viewer-sidebar-section';
          sidebarIndexWrap.appendChild(indexDetails);
          sidebar.appendChild(sidebarIndexWrap);
        } else {
          mainContent.appendChild(indexDetails);
        }

        // Funções auxiliares para blocos de texto
        function createTextBlock(title, text, isSerif = true) {
          const wrap = document.createElement('div');
          wrap.style.marginBottom = 'var(--space-5)';
          const h = document.createElement('h3');
          h.style.cssText = 'margin:0 0 0.5rem; font-family: var(--font-serif); color: var(--color-accent);';
          h.textContent = title;
          const p = document.createElement('p');
          p.style.margin = '0';
          p.style.lineHeight = '1.6';
          if (isSerif) p.style.fontFamily = 'var(--font-serif)';
          const safeText = text || s.viewerNoContent;
          p.dataset.raw = safeText;
          p.innerHTML = renderMarkdown(safeText);
          wrap.appendChild(h);
          wrap.appendChild(p);
          return { wrap, p };
        }

        const resPagina = createTextBlock(s.viewerSummaryPage, page.summary_page);
        const resGlobal = createTextBlock(s.viewerSummaryGlobal, summaryGlobal);
        const trechoRes = createTextBlock(s.viewerExcerpt, page.excerpt, true);
        
        mainContent.appendChild(resPagina.wrap);
        mainContent.appendChild(resGlobal.wrap);

        trechoRes.p.style.fontStyle = 'italic';
        trechoRes.p.style.color = 'var(--color-muted)';
        if (!page.excerpt) trechoRes.wrap.style.display = 'none';
        mainContent.appendChild(trechoRes.wrap);

        // Bloco OCR Original (sempre visível)
        const rawHref = safeUrl(page.raw?.url);
        if (rawHref !== '#') {
          const ocrSection = document.createElement('div');
          ocrSection.style.cssText = 'margin-top:var(--space-5); border-top:1px solid var(--color-border); padding-top:var(--space-4);';

          const ocrHeader = document.createElement('div');
          ocrHeader.style.cssText = 'display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-3); flex-wrap:wrap;';
          const ocrTitle = document.createElement('span');
          ocrTitle.style.cssText = 'font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted);';
          ocrTitle.textContent = s.viewerOcrTitle;
          ocrHeader.appendChild(ocrTitle);

          const ocrActions = document.createElement('div');
          ocrActions.style.cssText = 'display:flex; gap:var(--space-2); align-items:center; margin-left:auto; flex-wrap:wrap;';

          const loadBtn = document.createElement('button');
          loadBtn.className = 'button';
          loadBtn.style.fontSize = '0.8rem';
          loadBtn.textContent = s.viewerOcrLoadPage || s.rawOpen;
          ocrActions.appendChild(loadBtn);

          const extLink = document.createElement('a');
          extLink.href = rawHref;
          extLink.target = '_blank';
          extLink.rel = 'noreferrer';
          extLink.style.cssText = 'font-size:0.75rem; color:var(--color-muted); margin-left:auto;';
          extLink.textContent = s.viewerOcrOpenFile || s.viewerOcrOpen;
          ocrActions.appendChild(extLink);
          ocrHeader.appendChild(ocrActions);
          ocrSection.appendChild(ocrHeader);

          const bodyWrap = document.createElement('div');
          const rawHint = document.createElement('p');
          rawHint.style.cssText = 'margin:0 0 var(--space-3); color:var(--color-muted); font-size:0.85rem;';
          rawHint.textContent = s.viewerRawLoadHint;
          bodyWrap.appendChild(rawHint);

          const pre = document.createElement('pre');
          pre.className = 'viewer-ocr-xml';
          pre.style.cssText = 'max-height:60vh; overflow-y:auto;';
          pre.style.display = 'none';

          bodyWrap.appendChild(pre);
          ocrSection.appendChild(bodyWrap);
          mainContent.appendChild(ocrSection);

          let rawLoaded = false;
          let rawLoading = false;

          const loadRawOcr = async () => {
            if (rawLoaded || rawLoading) return;
            rawLoading = true;
            loadBtn.disabled = true;
            const controller = new AbortController();
            if (rawOcrController) rawOcrController.abort();
            rawOcrController = controller;
            pre.style.display = '';
            pre.textContent = s.viewerOcrLoading;
            try {
              const res = await fetch(rawHref, { signal: controller.signal });
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
              const txt = await res.text();
              if (controller.signal.aborted || generation !== loadGeneration) return;

              const ocrData = parseOcrXml(txt);
              if (ocrData && ocrData.blocos.length > 0) {
                pre.innerHTML = highlightXml(txt);
                pre.dataset.raw = txt;
                if (highlight) applyHighlight(pre, highlight);

                const toggleWrap = document.createElement('div');
                toggleWrap.style.cssText = 'display:flex; gap:var(--space-2); margin-bottom:var(--space-3); flex-wrap:wrap;';

                const btnPlain = document.createElement('button');
                btnPlain.className = 'button';
                btnPlain.style.fontSize = '0.8rem';
                btnPlain.textContent = s.viewerOcrPlain;

                const btnStruct = document.createElement('button');
                btnStruct.className = 'button secondary';
                btnStruct.style.fontSize = '0.8rem';
                btnStruct.textContent = s.viewerOcrStructured;

                const btnVisual = document.createElement('button');
                btnVisual.className = 'button secondary';
                btnVisual.style.fontSize = '0.8rem';
                btnVisual.textContent = s.viewerOcrVisual;

                const structContainer = document.createElement('div');
                structContainer.style.cssText = 'max-height:60vh; overflow-y:auto;';
                renderOcrStructured(structContainer, ocrData);
                structContainer.style.display = 'none';

                const visualContainer = document.createElement('div');
                visualContainer.style.cssText = 'max-height:60vh; overflow-y:auto;';
                renderOcrVisual(visualContainer, ocrData);
                visualContainer.style.display = 'none';

                function setActiveBtn(active) {
                  [btnPlain, btnStruct, btnVisual].forEach((btn) => {
                    btn.className = btn === active ? 'button' : 'button secondary';
                  });
                }
                function showPlain() {
                  pre.style.display = '';
                  structContainer.style.display = 'none';
                  visualContainer.style.display = 'none';
                  setActiveBtn(btnPlain);
                }
                function showStruct() {
                  pre.style.display = 'none';
                  structContainer.style.display = '';
                  visualContainer.style.display = 'none';
                  setActiveBtn(btnStruct);
                }
                function showVisual() {
                  pre.style.display = 'none';
                  structContainer.style.display = 'none';
                  visualContainer.style.display = '';
                  setActiveBtn(btnVisual);
                }

                btnPlain.addEventListener('click', () => { localStorage.setItem('viewerOcrMode', 'plain'); showPlain(); });
                btnStruct.addEventListener('click', () => { localStorage.setItem('viewerOcrMode', 'struct'); showStruct(); });
                btnVisual.addEventListener('click', () => { localStorage.setItem('viewerOcrMode', 'visual'); showVisual(); });
                toggleWrap.appendChild(btnPlain);
                toggleWrap.appendChild(btnStruct);
                toggleWrap.appendChild(btnVisual);
                bodyWrap.insertBefore(toggleWrap, pre);
                bodyWrap.appendChild(structContainer);
                bodyWrap.appendChild(visualContainer);
                const savedOcrMode = localStorage.getItem('viewerOcrMode');
                if (savedOcrMode === 'struct') showStruct();
                else if (savedOcrMode === 'visual') showVisual();
                else showPlain();
              } else {
                pre.style.display = '';
                pre.textContent = txt;
                if (highlight) applyHighlight(pre, highlight);
              }
              rawHint.remove();
              rawLoaded = true;
              loadBtn.disabled = true;
            } catch (e) {
              if (e?.name === 'AbortError') return;
              pre.style.display = '';
              pre.textContent = s.viewerOcrError(e.message);
              loadBtn.disabled = false;
            } finally {
              rawLoading = false;
            }
          };

          loadBtn.addEventListener('click', () => {
            void loadRawOcr();
          });

          if (highlight) {
            pre.dataset.highlight = highlight;
          }

        }

        // Sidebar Metadados
        function addMetaBlock(title, items, isKeywords = false) {
          if (!items || !items.length) return null;
          const block = document.createElement('div');
          block.className = 'meta-block';
          const h4 = document.createElement('h4');
          h4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
          h4.textContent = title;
          block.appendChild(h4);

          const ul = document.createElement('ul');
          ul.className = 'chips';
          items.forEach((txt) => {
            const li = document.createElement('li');
            if (isKeywords) {
              const a = document.createElement('a');
              a.href = `${assetBase}search?term=${encodeURIComponent(txt)}`;
              a.textContent = txt;
              a.style.textDecoration = 'none';
              a.style.color = 'inherit';
              li.appendChild(a);
            } else {
              li.textContent = txt;
            }
            ul.appendChild(li);
          });
          block.appendChild(ul);
          return block;
        }

        // Índice de segmentos do volume (sidebar)
        if (segments && segments.length) {
          const segIndexBlock = document.createElement('div');
          segIndexBlock.className = 'meta-block viewer-segments-index';
          const segH4 = document.createElement('h4');
          segH4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
          segH4.textContent = s.viewerMetaSegments;
          segIndexBlock.appendChild(segH4);

          const segList = document.createElement('ul');
          segList.style.cssText = 'list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:var(--space-2);';

          segments.forEach((seg) => {
            const isActive = pageNumber >= seg.page_first && pageNumber <= seg.page_last;
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = buildNavUrl(seg.page_first);
            a.style.cssText = 'display:block; padding:var(--space-2) var(--space-3); border-radius:var(--radius); background:var(--color-surface); border:1px solid var(--color-border); text-decoration:none; color:inherit; font-size:0.8rem; transition: border-color 0.15s;';
            if (isActive) {
              a.className = 'segment-active';
              a.style.borderColor = 'var(--color-accent)';
              a.style.background = 'var(--color-surface-2)';
            }
            a.addEventListener('mouseenter', () => { if (!isActive) a.style.borderColor = 'var(--color-accent)'; });
            a.addEventListener('mouseleave', () => { if (!isActive) a.style.borderColor = 'var(--color-border)'; });

            const labelSpan = document.createElement('span');
            labelSpan.style.cssText = 'font-weight:600; display:block; margin-bottom:2px;';
            labelSpan.textContent = seg.label;

            const rangeSpan = document.createElement('span');
            rangeSpan.style.cssText = 'font-size:0.72rem; color:var(--color-muted);';
            rangeSpan.textContent = `${isEn ? 'p.' : isIt ? 'pag.' : 'pág.'} ${seg.page_first}${seg.page_last !== seg.page_first ? '–' + seg.page_last : ''}`;

            a.appendChild(labelSpan);
            a.appendChild(rangeSpan);
            li.appendChild(a);
            segList.appendChild(li);
          });

          segIndexBlock.appendChild(segList);
          sidebar.appendChild(segIndexBlock);
        }

        const kwBlock = addMetaBlock(s.viewerMetaKeywords, keywordsLabels, true);
        if (kwBlock) sidebar.appendChild(kwBlock);

        const entBlock = addMetaBlock(s.viewerMetaEntities, entitiesLabels);
        if (entBlock) sidebar.appendChild(entBlock);


        const snapBlock = addMetaBlock(s.viewerMetaSnapshots, snapshotLabels);
        if (snapBlock) sidebar.appendChild(snapBlock);

        // Páginas relacionadas (KNN cross-volume)
        const relatedPages = page.related_pages || [];
        if (relatedPages.length) {
          const volMap = new Map(volumes.volumes.map((v) => [v.id, v]));

          const relBlock = document.createElement('div');
          relBlock.className = 'meta-block';
          {
            const relH4 = document.createElement('h4');
            relH4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
            relH4.textContent = s.viewerRelated;
            relBlock.appendChild(relH4);
          }
          {
            const relH4 = document.createElement('h4');
            relH4.style.cssText = 'font-size:0.6rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
            relH4.textContent = s.viewerRelatedNote;
            relBlock.appendChild(relH4);
          }

          const relList = document.createElement('ul');
          relList.style.cssText = 'list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:var(--space-2);';

          relatedPages.forEach((rel) => {
            const relVol = volMap.get(rel.doc);
            const li = document.createElement('li');

            const a = document.createElement('a');
            const params = new URLSearchParams({ doc: rel.doc, page: String(rel.page) });
            a.href = `${assetBase}viewer?${params.toString()}`;
            a.style.cssText = 'display:flex; flex-direction:column; gap:2px; padding:var(--space-2) var(--space-3); border-radius:var(--radius); background:var(--color-surface); border:1px solid var(--color-border); text-decoration:none; color:inherit; transition: border-color 0.15s;';
            a.addEventListener('mouseenter', () => a.style.borderColor = 'var(--color-accent)');
            a.addEventListener('mouseleave', () => a.style.borderColor = 'var(--color-border)');

            const titleSpan = document.createElement('span');
            titleSpan.style.cssText = 'font-size:0.85rem; font-weight:600; color:var(--color-accent);';
            titleSpan.textContent = s.viewerRelatedTitle(rel.doc, relVol?.title || '', rel.page);

            const distSpan = document.createElement('span');
            distSpan.style.cssText = 'font-size:0.72rem; color:var(--color-muted);';
            distSpan.textContent = s.viewerRelatedSim(1 - Math.min(rel.dist, 1));

            a.appendChild(titleSpan);
            a.appendChild(distSpan);
            li.appendChild(a);
            relList.appendChild(li);
          });

          relBlock.appendChild(relList);
          sidebar.appendChild(relBlock);
        }

        // Bookmark banner (continuar lendo)
        try {
          const bookmarks = JSON.parse(localStorage.getItem('viewerBookmarks') || '{}');
          const saved = bookmarks[doc];
          if (saved && saved.page !== pageNumber) {
            const banner = document.createElement('div');
            banner.className = 'viewer-bookmark-banner';
            const bannerText = document.createElement('span');
            bannerText.innerHTML = `📖 ${s.viewerContinueReading}: <strong>${s.viewerVolumeLabel(volume.id, volume.title || '')} · ${s.viewerPage(saved.page)}</strong>`;
            const bannerLink = document.createElement('a');
            bannerLink.href = buildNavUrl(saved.page);
            bannerLink.className = 'button';
            bannerLink.style.fontSize = '0.85rem';
            bannerLink.textContent = s.viewerGo;
            banner.appendChild(bannerText);
            banner.appendChild(bannerLink);
            viewerRoot.appendChild(banner);
          }
        } catch (_) {}

        mainGrid.appendChild(mainContent);
        mainGrid.appendChild(sidebar);
        viewerRoot.appendChild(mainGrid);

        if (highlight) {
          applyHighlight(resPagina.p, highlight);
          applyHighlight(resGlobal.p, highlight);
          applyHighlight(trechoRes.p, highlight);
        }
      } catch (err) {
        const safeMsg = escapeHtml(err instanceof Error ? err.message : String(err));
        viewerRoot.innerHTML = `<div class="card"><p style="color:var(--color-focus)">${s.viewerError(safeMsg)}</p></div>`;
      }
    }

    load();
  </script>
</Layout>
        el.style.overflow = 'hidden';
