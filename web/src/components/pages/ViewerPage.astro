        const focusBtn = document.createElement('button');
        focusBtn.type = 'button';
        focusBtn.className = 'button secondary';
        focusBtn.style.fontSize = '0.8rem';
        focusBtn.dataset.role = 'viewer-mode-toggle';
        focusBtn.addEventListener('click', () => {
          setViewerMode(viewerMode === 'reading' ? 'default' : 'reading');
        });
        focusBtn.textContent = viewerMode === 'reading' ? s.viewerNormalMode : s.viewerFocusMode;
        applyViewerMode(viewerMode);
        persistViewerMode(viewerMode);
        syncViewerModeUrl();

        // Font size
        const fontDown = document.createElement('button');
        fontDown.type = 'button';
        fontDown.className = 'button secondary';
        fontDown.style.fontSize = '0.8rem';
        fontDown.textContent = s.viewerDecreaseFont;
        fontDown.setAttribute('aria-label', s.viewerDecreaseFontLabel);
        const fontUp = document.createElement('button');
        fontUp.type = 'button';
        fontUp.className = 'button secondary';
        fontUp.style.fontSize = '0.8rem';
        fontUp.textContent = s.viewerIncreaseFont;
        fontUp.setAttribute('aria-label', s.viewerIncreaseFontLabel);

        const fontSizeStatus = document.createElement('span');
        fontSizeStatus.className = 'sr-only';
        fontSizeStatus.setAttribute('role', 'status');
        fontSizeStatus.setAttribute('aria-live', 'polite');

        let fontSizeLevel = parseInt(localStorage.getItem('viewerFontSize') || '0', 10) || 0;
        function applyFontSize() {
          const sizes = ['0.95rem', '1.05rem', '1.15rem', '1.3rem'];
          const idx = Math.max(0, Math.min(fontSizeLevel + 1, sizes.length - 1));
          mainContent.style.fontSize = sizes[idx];
          fontDown.disabled = fontSizeLevel <= -1;
          fontUp.disabled = fontSizeLevel >= 2;
          fontSizeStatus.textContent = s.viewerFontSizeStatus(Math.round(parseFloat(sizes[idx]) / 1.05 * 100));
          try { localStorage.setItem('viewerFontSize', String(fontSizeLevel)); } catch (_) {}
        }
        applyFontSize();
        fontDown.addEventListener('click', () => { fontSizeLevel = Math.max(-1, fontSizeLevel - 1); applyFontSize(); });
        fontUp.addEventListener('click', () => { fontSizeLevel = Math.min(2, fontSizeLevel + 1); applyFontSize(); });

        // Busca local
        if (rawHref !== '#' && viewerMode !== 'reading') {
          const topOcrBtn = document.createElement('button');
          topOcrBtn.type = 'button';
          topOcrBtn.className = 'button secondary';
          topOcrBtn.style.fontSize = '0.8rem';
          topOcrBtn.textContent = s.viewerOcrTopAction;
          topOcrBtn.dataset.role = 'viewer-ocr-top-action';
          toolbar.appendChild(topOcrBtn);
        }

        const localSearchWrap = document.createElement('div');
        localSearchWrap.className = 'viewer-search-local';
        const localSearchId = `viewer-search-${doc}-${pageNumber}`;
        const localSearchLabel = document.createElement('label');
        localSearchLabel.className = 'sr-only';
        localSearchLabel.htmlFor = localSearchId;
        localSearchLabel.textContent = s.viewerSearchInVolume;
        const localSearchInput = document.createElement('input');
        localSearchInput.type = 'search';
        localSearchInput.id = localSearchId;
        localSearchInput.placeholder = s.viewerSearchInVolume;
        localSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && localSearchInput.value.trim()) {
            const params = new URLSearchParams({
              term: localSearchInput.value.trim(),
              volume: doc,
            });
            if (viewerMode === 'reading') params.set('view', 'reading');
            window.location.href = routeUrl('search', `?${params.toString()}`);
          }
        });
        localSearchWrap.appendChild(localSearchLabel);
        localSearchWrap.appendChild(localSearchInput);

        toolbar.appendChild(focusBtn);
        toolbar.appendChild(fontDown);
        toolbar.appendChild(fontUp);
        toolbar.appendChild(fontSizeStatus);
        if (viewerMode !== 'reading') toolbar.appendChild(localSearchWrap);

        const actionBar = document.createElement('div');
        actionBar.className = 'viewer-action-bar';
        const copyExcerptBtn = document.createElement('button');
        copyExcerptBtn.type = 'button';
        copyExcerptBtn.className = 'button secondary';
        copyExcerptBtn.style.fontSize = '0.8rem';
        copyExcerptBtn.textContent = viewerMode === 'reading' ? s.viewerCopySummary : s.viewerCopyExcerpt;
        const copyRefBtn = document.createElement('button');
        copyRefBtn.type = 'button';
        copyRefBtn.className = 'button secondary';
        copyRefBtn.style.fontSize = '0.8rem';
        copyRefBtn.textContent = s.viewerCopyReference;
        const citationStyleLabel = document.createElement('label');
        citationStyleLabel.className = 'viewer-citation-control';
        citationStyleLabel.style.fontSize = '0.8rem';
        citationStyleLabel.style.color = 'var(--color-muted)';
        citationStyleLabel.textContent = `${s.viewerCitationStyleLabel}: `;
        const citationStyleSelect = document.createElement('select');
        citationStyleSelect.className = 'viewer-citation-select';
        citationStyleSelect.setAttribute('aria-label', s.viewerCitationStyleLabel);
        [
          ['abnt', s.viewerCitationStyleAbnt],
          ['apa', s.viewerCitationStyleApa],
          ['chicago', s.viewerCitationStyleChicago],
        ].forEach(([value, label]) => {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = label;
          citationStyleSelect.appendChild(option);
        });
        citationStyleLabel.appendChild(citationStyleSelect);
        const citeExcerptBtn = document.createElement('button');
        citeExcerptBtn.type = 'button';
        citeExcerptBtn.className = 'button secondary';
        citeExcerptBtn.style.fontSize = '0.8rem';
        citeExcerptBtn.textContent = viewerMode === 'reading' ? s.viewerCiteSummary : s.viewerCitationAction;
        const reportBtn = document.createElement('a');
        reportBtn.className = 'button secondary';
        reportBtn.style.fontSize = '0.8rem';
        reportBtn.target = '_blank';
        reportBtn.rel = 'noreferrer';
        reportBtn.textContent = viewerMode === 'reading' ? s.viewerReportTranscription : s.viewerReportIssue;
        reportBtn.setAttribute('aria-label', `${reportBtn.textContent} (${s.viewerOpenNewTab})`);
        actionBar.appendChild(copyExcerptBtn);
        actionBar.appendChild(copyRefBtn);
        actionBar.appendChild(citationStyleLabel);
        actionBar.appendChild(citeExcerptBtn);
        actionBar.appendChild(reportBtn);
        const copyStatus = document.createElement('span');
        copyStatus.className = 'sr-only';
        copyStatus.dataset.role = 'viewer-copy-status';
        copyStatus.setAttribute('role', 'status');
        copyStatus.setAttribute('aria-live', 'polite');
        actionBar.appendChild(copyStatus);

        // ── Índice de páginas (collapsible) ──
        const indexDetails = document.createElement('details');
        indexDetails.style.marginBottom = 'var(--space-4)';
        const indexSummary = document.createElement('summary');
        indexSummary.style.cssText = 'cursor:pointer; font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); user-select:none; list-style:none; display:flex; align-items:center; gap:var(--space-2);';
        indexSummary.innerHTML = `<span style="display:inline-block;transition:transform 0.2s;" class="idx-arrow">▶</span> ${s.viewerIndex}`;
        indexDetails.appendChild(indexSummary);

        const indexList = document.createElement('ul');
        indexList.className = 'viewer-index-list';
        for (let p = firstPage; p <= lastPage; p++) {
          const a = document.createElement('a');
          a.textContent = String(p);
          a.href = buildNavUrl(p);
          if (p === pageNumber) { a.classList.add('current'); a.setAttribute('aria-current', 'page'); }
          const li = document.createElement('li');
          li.appendChild(a);
          indexList.appendChild(li);
        }
        indexDetails.appendChild(indexList);
        indexDetails.addEventListener('toggle', () => {
          const arrow = indexDetails.querySelector('.idx-arrow');
          if (arrow) arrow.style.transform = indexDetails.open ? 'rotate(90deg)' : '';
        });

        const header = document.createElement('header');
        header.style.cssText = 'display:flex; justify-content:space-between; align-items:center; gap:var(--space-3); margin-bottom:var(--space-5); border-bottom:1px solid var(--color-border); padding-bottom:var(--space-4); flex-wrap: wrap;';

        const titleGroup = document.createElement('div');
        const volP = document.createElement('p');
        volP.style.margin = '0';
        volP.style.color = 'var(--color-muted)';
        volP.textContent = s.viewerVolumeLabel(volume.id, volume.title || '');
        const h2 = document.createElement('h2');
        h2.style.margin = '0';
        h2.textContent = s.viewerPage(page.page);
        titleGroup.appendChild(volP);
        titleGroup.appendChild(h2);
        header.appendChild(titleGroup);

        const navGroup = document.createElement('nav');
        navGroup.className = 'viewer-header-nav';
        navGroup.setAttribute('aria-label', s.viewerPageNavigation);

        const hasPrev = pageNumber > firstPage;
        const hasNext = pageNumber < lastPage;

        function makeNavBtn(text, targetPage, enabled, ariaLabel, iconText) {
          const control = document.createElement(enabled ? 'a' : 'button');
          control.className = `button secondary${enabled ? '' : ' disabled'}`;
          // Em telas pequenas, mostra apenas ícone/símbolo; em maiores, texto
          control.innerHTML = `<span class="nav-icon" aria-hidden="true">${iconText || text}</span><span class="nav-label-text">${text}</span>`;
          if (ariaLabel) control.setAttribute('aria-label', ariaLabel);
          if (enabled) control.href = buildNavUrl(targetPage);
          else {
            control.type = 'button';
            control.disabled = true;
          }
          return control;
        }

        const firstBtn = makeNavBtn(s.viewerFirst || '<<', firstPage, pageNumber > firstPage, s.viewerFirst, '⏮');
        const prevBtn = makeNavBtn(s.viewerPrev, pageNumber - 1, hasPrev, s.viewerPrev, '◀');
        const nextBtn = makeNavBtn(s.viewerNext, pageNumber + 1, hasNext, s.viewerNext, '▶');
        const lastBtn = makeNavBtn(s.viewerLast || '>>', lastPage, pageNumber < lastPage, s.viewerLast, '⏭');

        const pageInputWrap = document.createElement('span');
        pageInputWrap.style.cssText = 'display:inline-flex; align-items:center; gap:var(--space-1); font-size:0.9rem; color:var(--color-muted);';

        const pageInput = document.createElement('input');
        pageInput.type = 'number';
        pageInput.min = String(firstPage);
        pageInput.max = String(lastPage);
        pageInput.value = String(pageNumber);
        pageInput.setAttribute('aria-label', s.viewerPageInputLabel || 'Page number');

        const pageTotalSpan = document.createElement('span');
        pageTotalSpan.textContent = `${isEn ? 'of' : isIt ? 'di' : isFr ? 'sur' : 'de'} ${lastPage}`;

        pageInput.addEventListener('change', () => {
          let v = parseInt(pageInput.value, 10);
          if (isNaN(v)) return;
          if (v < firstPage) v = firstPage;
          if (v > lastPage) v = lastPage;
          window.location.href = buildNavUrl(v);
        });
        pageInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') pageInput.dispatchEvent(new Event('change'));
        });

        pageInputWrap.appendChild(pageInput);
        pageInputWrap.appendChild(pageTotalSpan);

        navGroup.appendChild(firstBtn);
        navGroup.appendChild(prevBtn);
        navGroup.appendChild(pageInputWrap);
        navGroup.appendChild(nextBtn);
        navGroup.appendChild(lastBtn);

        // Link de retorno à busca (se veio de uma busca com highlight)
        if (highlight) {
          const backLink = document.createElement('a');
          backLink.className = 'button secondary';
          backLink.style.fontSize = '0.85rem';
          const backParams = new URLSearchParams({ term: highlight });
          if (viewerMode === 'reading') backParams.set('view', 'reading');
          backLink.href = routeUrl('search', `?${backParams.toString()}`);
          backLink.textContent = s.viewerBack;
          navGroup.prepend(backLink);
        }

        // Atalhos de teclado para navegação
        viewerKeydownHandler = (e) => {
          if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable)) return;
          if (e.key === 'ArrowLeft' && hasPrev) { e.preventDefault(); window.location.href = buildNavUrl(pageNumber - 1); }
          if (e.key === 'ArrowRight' && hasNext) { e.preventDefault(); window.location.href = buildNavUrl(pageNumber + 1); }
        };
        document.addEventListener('keydown', viewerKeydownHandler);

        header.appendChild(navGroup);

        reportBtn.href = buildViewerIssueUrl({ page, volume, volumeAuthor, volumeWork });
        copyExcerptBtn.addEventListener('click', async () => {
          await writeClipboardWithFeedback(
            copyExcerptBtn,
            () => normalizeWhitespace(page.excerpt || localizedPageSummary(page) || summaryGlobal || ''),
            viewerMode === 'reading' ? s.viewerCopySummary : s.viewerCopyExcerpt,
          );
        });
        copyRefBtn.addEventListener('click', async () => {
          await writeClipboardWithFeedback(
            copyRefBtn,
            () => buildShortReference({ page, volume, volumeAuthor, volumeWork }),
            s.viewerCopyReference,
          );
        });
        citeExcerptBtn.addEventListener('click', async () => {
          await writeClipboardWithFeedback(
            citeExcerptBtn,
            () => {
              const meta = buildCitationMetadata({ page, volume, volumeAuthor, volumeWork, summaryGlobal });
              const reference = formatCitation(citationStyleSelect.value, meta);
              return meta.excerpt ? `${meta.excerpt}\n\n${reference}` : reference;
            },
            viewerMode === 'reading' ? s.viewerCiteSummary : s.viewerCitationAction,
          );
        });

        mainContent.appendChild(identityCard);
        const isWide = window.innerWidth > 1100;

        function createIndexLocationPanel() {
          const details = document.createElement('details');
          details.className = 'viewer-location-panel';
          details.dataset.state = 'idle';

          const summary = document.createElement('summary');
          const icon = document.createElement('span');
          icon.className = 'viewer-location-icon';
          icon.setAttribute('aria-hidden', 'true');
          icon.textContent = '⌖';
          const summaryCopy = document.createElement('span');
          summaryCopy.className = 'viewer-location-summary-copy';
          const summaryTitle = document.createElement('strong');
          summaryTitle.textContent = s.viewerLocationTitle;
          const summarySubtitle = document.createElement('small');
          summarySubtitle.textContent = s.viewerLocationSubtitle;
          summaryCopy.append(summaryTitle, summarySubtitle);
          summary.append(icon, summaryCopy);

          const body = document.createElement('div');
          body.className = 'viewer-location-body';
          body.setAttribute('aria-live', 'polite');
          const initialStatus = document.createElement('p');
          initialStatus.className = 'viewer-location-status';
          initialStatus.textContent = s.viewerLocationAutomaticNote;
          body.appendChild(initialStatus);
          details.append(summary, body);

          function appendStatus(text) {
            const status = document.createElement('p');
            status.className = 'viewer-location-status';
            status.textContent = text;
            body.appendChild(status);
          }

          function appendEntryList(title, items) {
            if (!items.length) return;
            const section = document.createElement('section');
            section.className = 'viewer-location-section';
            const heading = document.createElement('p');
            heading.className = 'viewer-location-eyebrow';
            heading.textContent = title;
            const list = document.createElement('ul');
            list.className = 'viewer-location-entry-list';
            items.forEach(({ entry, relation }) => {
              const li = document.createElement('li');
              const link = document.createElement('a');
              link.className = 'viewer-location-entry';
              link.dataset.relation = relation;
              link.href = buildNavUrl(entry.page);
              const badge = document.createElement('span');
              badge.className = 'viewer-location-entry-badge';
              badge.textContent = relation === 'current'
                ? s.viewerLocationHere
                : relation === 'previous'
                  ? s.viewerLocationPrevious
                  : s.viewerLocationNext;
              const copy = document.createElement('span');
              copy.className = 'viewer-location-entry-copy';
              const target = document.createElement('strong');
              target.textContent = entry.target.primary;
              const metaLine = document.createElement('span');
              const metaParts = [s.viewerPage(entry.page), entry.section?.primary].filter(Boolean);
              metaLine.textContent = metaParts.join(' · ');
              copy.append(target, metaLine);
              if (entry.target.original) {
                const original = document.createElement('span');
                original.lang = 'la';
                original.textContent = entry.target.original;
                copy.appendChild(original);
              }
              link.append(badge, copy);
              li.appendChild(link);
              list.appendChild(li);
            });
            section.append(heading, list);
            body.appendChild(section);
          }

          function renderContext(context) {
            body.replaceChildren();
            if (!context.work && !context.resolvedEntries) {
              appendStatus(s.viewerLocationUnavailable);
            }

            if (context.work) {
              const section = document.createElement('section');
              section.className = 'viewer-location-section';
              const heading = document.createElement('p');
              heading.className = 'viewer-location-eyebrow';
              heading.textContent = s.viewerLocationWork;
              const work = document.createElement('div');
              work.className = 'viewer-location-work';
              const title = document.createElement('strong');
              title.textContent = context.work.title.primary;
              work.appendChild(title);
              if (context.work.author.primary) {
                const author = document.createElement('span');
                author.textContent = context.work.author.primary;
                work.appendChild(author);
              }
              const range = document.createElement('span');
              range.textContent = `${s.viewerPage(context.work.startPage)}–${context.work.endPage} · ${context.work.progress}% ${s.viewerLocationWorkProgress}`;
              const progress = document.createElement('div');
              progress.className = 'viewer-location-progress';
              progress.setAttribute('role', 'progressbar');
              progress.setAttribute('aria-valuemin', '0');
              progress.setAttribute('aria-valuemax', '100');
              progress.setAttribute('aria-valuenow', String(context.work.progress));
              const progressFill = document.createElement('span');
              progressFill.style.width = `${context.work.progress}%`;
              progress.appendChild(progressFill);
              work.append(range, progress);
              section.append(heading, work);
              body.appendChild(section);
            }

            if (context.current.length) {
              appendEntryList(
                s.viewerLocationCurrentPage,
                context.current.map((entry) => ({ entry, relation: 'current' })),
              );
              const hiddenCount = context.currentTotal - context.current.length;
              if (hiddenCount > 0) appendStatus(`+${hiddenCount} ${s.viewerLocationMore}`);
            } else if (context.resolvedEntries) {
              appendStatus(s.viewerLocationNoExact);
              appendEntryList(s.viewerLocationNearby, [
                ...context.previous.map((entry) => ({ entry, relation: 'previous' })),
                ...context.next.map((entry) => ({ entry, relation: 'next' })),
              ]);
            }

            const footer = document.createElement('div');
            footer.className = 'viewer-location-footer';
            const note = document.createElement('small');
            note.textContent = s.viewerLocationAutomaticNote;
            const catalogLink = document.createElement('a');
            catalogLink.href = routeUrl('indices', `?volume=${encodeURIComponent(doc)}`);
            catalogLink.textContent = s.viewerLocationOpenCatalog;
            footer.append(note, catalogLink);
            body.appendChild(footer);
          }

          async function loadIndexContext() {
            if (details.dataset.state === 'loading' || details.dataset.state === 'loaded') return;
            details.dataset.state = 'loading';
            body.setAttribute('aria-busy', 'true');
            body.replaceChildren();
            appendStatus(s.viewerLocationLoading);
            try {
              const indexUrl = `${assetBase}indices/${encodeURIComponent(doc)}.json.gz`;
              const [{ buildViewerIndexContext }, payload] = await Promise.all([
                import(`${assetBase}scripts/viewer-index-context.mjs`),
                getJSON(indexUrl),
              ]);
              if (generation !== loadGeneration) return;
              renderContext(buildViewerIndexContext(payload, pageNumber, uiLocale));
              details.dataset.state = 'loaded';
            } catch (error) {
              if (generation !== loadGeneration) return;
              console.warn('[Viewer] Índice contextual indisponível', error);
              body.replaceChildren();
              appendStatus(s.viewerLocationUnavailable);
              const retry = document.createElement('button');
              retry.type = 'button';
              retry.className = 'button secondary';
              retry.textContent = s.viewerLocationRetry;
              retry.addEventListener('click', () => {
                details.dataset.state = 'idle';
                void loadIndexContext();
              });
              body.appendChild(retry);
              details.dataset.state = 'error';
            } finally {
              body.removeAttribute('aria-busy');
            }
          }

          details.addEventListener('toggle', () => {
            if (details.open) void loadIndexContext();
          });
          return details;
        }

        const indexLocationPanel = createIndexLocationPanel();
        if (viewerMode === 'reading') {
          mainContent.appendChild(header);
          mainContent.appendChild(toolbar);

          const readingToolsDetails = document.createElement('details');
          readingToolsDetails.className = 'viewer-reading-tools';
          const readingToolsSummary = document.createElement('summary');
          readingToolsSummary.textContent = s.viewerReadingTools;
          const readingToolsContent = document.createElement('div');
          readingToolsContent.className = 'viewer-reading-tools-content';
          readingToolsContent.appendChild(indexLocationPanel);
          readingToolsContent.appendChild(localSearchWrap);
          readingToolsContent.appendChild(actionBar);
          readingToolsContent.appendChild(indexDetails);
          readingToolsDetails.appendChild(readingToolsSummary);
          readingToolsDetails.appendChild(readingToolsContent);
          mainContent.appendChild(readingToolsDetails);
        } else {
          mainContent.appendChild(toolbar);
          mainContent.appendChild(actionBar);
          mainContent.appendChild(header);
          if (isWide) sidebar.appendChild(indexLocationPanel);
          else mainContent.appendChild(indexLocationPanel);
        }

        // Índice de páginas: no modo padrão, telas grandes usam a sidebar.
        if (viewerMode !== 'reading' && isWide) {
          // Mover índice para sidebar com wrapper
          const sidebarIndexWrap = document.createElement('div');
          sidebarIndexWrap.className = 'viewer-sidebar-section';
          sidebarIndexWrap.appendChild(indexDetails);
          sidebar.appendChild(sidebarIndexWrap);
        } else if (viewerMode !== 'reading') {
          mainContent.appendChild(indexDetails);
        }

        // Funções auxiliares para blocos de texto
        function createTextBlock(title, text, isSerif = true) {
          const wrap = document.createElement('div');
          wrap.style.marginBottom = 'var(--space-5)';
          const h = document.createElement('h2');
          h.style.cssText = 'margin:0 0 0.5rem; font-family: var(--font-serif); color: var(--color-accent);';
          h.textContent = title;
          const p = document.createElement('p');
          p.style.margin = '0';
          p.style.lineHeight = '1.6';
          if (isSerif) p.style.fontFamily = 'var(--font-serif)';
          const safeText = text || s.viewerNoContent;
          p.dataset.raw = safeText;
          p.innerHTML = renderMarkdown(safeText);
          wrap.appendChild(h);
          wrap.appendChild(p);
          return { wrap, p };
        }

        const resPagina = createTextBlock(s.viewerSummaryPage, localizedPageSummary(page));
        const resGlobal = createTextBlock(s.viewerSummaryGlobal, summaryGlobal);
        const trechoRes = createTextBlock(s.viewerExcerpt, page.excerpt, true);

        trechoRes.p.style.fontStyle = 'italic';
        trechoRes.p.style.color = 'var(--color-muted)';
        if (!page.excerpt) trechoRes.wrap.style.display = 'none';

        const dataNote = document.createElement('aside');
        dataNote.setAttribute('aria-label', s.viewerEditorialNote);
        dataNote.style.cssText = 'margin:0 0 var(--space-5); padding:var(--space-3) var(--space-4); border:1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border)); border-radius:var(--radius-m); background:color-mix(in srgb, var(--color-surface) 84%, var(--color-accent) 16%); color:var(--color-muted); line-height:1.6;';
        dataNote.textContent = s.viewerDataNote;

        function createSummaryDetails(label, textBlock, open = false) {
          const details = document.createElement('details');
          details.className = 'viewer-summary-details';
          details.open = open;
          const summary = document.createElement('summary');
          summary.textContent = label;
          const content = document.createElement('div');
          content.appendChild(textBlock.p);
          details.appendChild(summary);
          details.appendChild(content);
          return details;
        }

        function appendSummaryContent() {
          if (viewerMode === 'reading') {
            mainContent.appendChild(createSummaryDetails(s.viewerPageSummaryDetails, resPagina, true));
            mainContent.appendChild(createSummaryDetails(s.viewerGlobalSummaryDetails, resGlobal));
          } else {
            mainContent.appendChild(resPagina.wrap);
            mainContent.appendChild(resGlobal.wrap);
          }
          mainContent.appendChild(trechoRes.wrap);
          mainContent.appendChild(dataNote);
        }

        function createReadingFooterNav() {
          const nav = document.createElement('nav');
          nav.className = 'viewer-footer-nav';
          nav.setAttribute('aria-label', `${s.viewerPageNavigation} — ${s.viewerPage(pageNumber)}`);
          nav.appendChild(makeNavBtn(s.viewerPrev, pageNumber - 1, hasPrev, s.viewerPrev, '◀'));
          const position = document.createElement('span');
          position.className = 'viewer-page-position';
          position.textContent = s.viewerPageOfTotal(pageNumber, lastPage);
          position.setAttribute('aria-current', 'page');
          nav.appendChild(position);
          nav.appendChild(makeNavBtn(s.viewerNext, pageNumber + 1, hasNext, s.viewerNext, '▶'));
          return nav;
        }

        if (viewerMode !== 'reading') {
          appendSummaryContent();
        }

        // Bloco OCR Original (sempre visível)
        if (rawHref !== '#') {
          const ocrSection = document.createElement('section');
          ocrSection.id = 'viewer-original-text';
          const ocrTitleId = `viewer-original-text-title-${doc}-${pageNumber}`;
          ocrSection.setAttribute('aria-labelledby', ocrTitleId);
          ocrSection.style.cssText = 'margin-top:var(--space-5); border-top:1px solid var(--color-border); padding-top:var(--space-4);';

          const ocrHeader = document.createElement('div');
          ocrHeader.style.cssText = 'display:flex; align-items:center; gap:var(--space-2); margin-bottom:var(--space-3); flex-wrap:wrap;';
          const ocrTitle = document.createElement('h2');
          ocrTitle.id = ocrTitleId;
          ocrTitle.style.cssText = 'margin:0; font-size:1.15rem; font-family:var(--font-serif); color:var(--color-accent);';
          ocrTitle.textContent = s.viewerOcrTitle;
          ocrHeader.appendChild(ocrTitle);

          const autoLoadLabel = document.createElement('label');
          autoLoadLabel.style.cssText = 'display:inline-flex; align-items:center; gap:0.45rem; font-size:0.8rem; color:var(--color-muted);';
          const autoLoadToggle = document.createElement('input');
          autoLoadToggle.type = 'checkbox';
          autoLoadToggle.checked = shouldAutoLoadRaw;
          autoLoadLabel.appendChild(autoLoadToggle);
          const autoLoadText = document.createElement('span');
          autoLoadText.textContent = s.viewerOcrAutoLoadLabel;
          autoLoadLabel.appendChild(autoLoadText);
          if (viewerMode !== 'reading') {
            ocrHeader.appendChild(autoLoadLabel);
          }

          const ocrActions = document.createElement('div');
          ocrActions.style.cssText = 'display:flex; gap:var(--space-2); align-items:center; margin-left:auto; flex-wrap:wrap;';

          const loadBtn = document.createElement('button');
          loadBtn.type = 'button';
          loadBtn.className = 'button';
          loadBtn.style.fontSize = '0.8rem';
          loadBtn.textContent = s.viewerOcrLoadPage || s.rawOpen;
          ocrActions.appendChild(loadBtn);

          const extLink = document.createElement('a');
          extLink.href = rawHref;
          extLink.target = '_blank';
          extLink.rel = 'noreferrer';
          extLink.style.cssText = 'font-size:0.75rem; color:var(--color-muted); margin-left:auto;';
          extLink.textContent = s.viewerOcrOpenFile || s.viewerOcrOpen;
          extLink.setAttribute('aria-label', `${extLink.textContent} (${s.viewerOpenNewTab})`);
          ocrActions.appendChild(extLink);
          const loadStatus = document.createElement('span');
          loadStatus.className = 'sr-only';
          loadStatus.setAttribute('role', 'status');
          loadStatus.setAttribute('aria-live', 'polite');
          ocrActions.appendChild(loadStatus);
          ocrHeader.appendChild(ocrActions);
          ocrSection.appendChild(ocrHeader);

          const bodyWrap = document.createElement('div');
          const rawDescription = document.createElement('p');
          rawDescription.style.cssText = 'margin:0 0 var(--space-2); color:var(--color-ink); font-size:0.95rem; line-height:1.6;';
          rawDescription.textContent = `${s.viewerOcrDescription} ${s.viewerOcrAutomaticNote}`;
          bodyWrap.appendChild(rawDescription);
          const rawHint = document.createElement('p');
          rawHint.style.cssText = 'margin:0 0 var(--space-3); color:var(--color-muted); font-size:0.85rem;';
          rawHint.textContent = s.viewerRawLoadHint;
          bodyWrap.appendChild(rawHint);

          const pre = document.createElement('pre');
          pre.className = 'viewer-ocr-xml';
          pre.id = `viewer-ocr-plain-${doc}-${pageNumber}`;
          pre.dataset.ocrView = 'plain';
          pre.style.cssText = 'max-height:60vh; overflow-y:auto;';
          pre.style.display = 'none';

          bodyWrap.appendChild(pre);
          ocrSection.appendChild(bodyWrap);
          mainContent.appendChild(ocrSection);

          let rawLoaded = false;
          let rawLoading = false;
          let rawLoadPromise = null;

          const topOcrBtn = toolbar.querySelector('[data-role="viewer-ocr-top-action"]');

          function scrollToOcrSection() {
            ocrSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }

          const loadRawOcr = async ({ scrollIntoView = false, persistPreference = false } = {}) => {
            if (persistPreference && viewerMode !== 'reading') {
              persistRawAutoLoad(true);
              autoLoadToggle.checked = true;
            }
            if (rawLoaded) {
              if (scrollIntoView) scrollToOcrSection();
              return;
            }
            if (rawLoading && rawLoadPromise) {
              await rawLoadPromise;
              if (scrollIntoView && rawLoaded) scrollToOcrSection();
              return;
            }
            rawLoading = true;
            loadBtn.disabled = true;
            ocrSection.setAttribute('aria-busy', 'true');
            loadStatus.textContent = s.viewerOcrLoading;
            rawLoadPromise = (async () => {
              const controller = new AbortController();
              if (rawOcrController) rawOcrController.abort();
              rawOcrController = controller;
              pre.style.display = '';
              pre.classList.remove('viewer-ocr-error');
              pre.textContent = s.viewerOcrLoading;
              try {
                const res = await fetch(rawHref, { signal: controller.signal });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const txt = await res.text();
                if (controller.signal.aborted || generation !== loadGeneration) return;

                const ocrData = parseOcrXml(txt);
                if (ocrData && ocrData.blocos.length > 0) {
                  pre.innerHTML = highlightXml(txt);
                  pre.dataset.raw = txt;
                  if (highlight) applyHighlight(pre, highlight);

                  const toggleWrap = document.createElement('div');
                  toggleWrap.className = 'viewer-ocr-toggle';
                  toggleWrap.setAttribute('role', 'group');
                  toggleWrap.setAttribute('aria-label', s.viewerOcrDisplayLabel);

                  const btnPlain = document.createElement('button');
                  btnPlain.type = 'button';
                  btnPlain.className = 'button';
                  btnPlain.style.fontSize = '0.8rem';
                  btnPlain.textContent = s.viewerOcrPlain;
                  btnPlain.setAttribute('aria-controls', pre.id);

                  const btnStruct = document.createElement('button');
                  btnStruct.type = 'button';
                  btnStruct.className = 'button secondary';
                  btnStruct.style.fontSize = '0.8rem';
                  btnStruct.textContent = s.viewerOcrStructured;

                  const btnVisual = document.createElement('button');
                  btnVisual.type = 'button';
                  btnVisual.className = 'button secondary';
                  btnVisual.style.fontSize = '0.8rem';
                  btnVisual.textContent = s.viewerOcrVisual;

                  const structContainer = document.createElement('div');
                  structContainer.id = `viewer-ocr-structured-${doc}-${pageNumber}`;
                  structContainer.dataset.ocrView = 'structured';
                  structContainer.style.cssText = 'max-height:60vh; overflow-y:auto;';
                  renderOcrStructured(structContainer, ocrData);
                  structContainer.hidden = true;
                  btnStruct.setAttribute('aria-controls', structContainer.id);

                  const visualContainer = document.createElement('div');
                  visualContainer.id = `viewer-ocr-visual-${doc}-${pageNumber}`;
                  visualContainer.dataset.ocrView = 'visual';
                  visualContainer.style.cssText = 'max-height:60vh; overflow-y:auto;';
                  renderOcrVisual(visualContainer, ocrData);
                  visualContainer.hidden = true;
                  btnVisual.setAttribute('aria-controls', visualContainer.id);

                  function setActiveBtn(active) {
                    [btnPlain, btnStruct, btnVisual].forEach((btn) => {
                      btn.className = btn === active ? 'button' : 'button secondary';
                      btn.setAttribute('aria-pressed', btn === active ? 'true' : 'false');
                    });
                  }
                  function showPlain() {
                    pre.hidden = false;
                    pre.style.display = '';
                    structContainer.hidden = true;
                    visualContainer.hidden = true;
                    setActiveBtn(btnPlain);
                  }
                  function showStruct() {
                    pre.hidden = true;
                    structContainer.hidden = false;
                    visualContainer.hidden = true;
                    setActiveBtn(btnStruct);
                  }
                  function showVisual() {
                    pre.hidden = true;
                    structContainer.hidden = true;
                    visualContainer.hidden = false;
                    setActiveBtn(btnVisual);
                  }

                  btnPlain.addEventListener('click', () => { persistOcrMode('plain'); showPlain(); });
                  btnStruct.addEventListener('click', () => { persistOcrMode('struct'); showStruct(); });
                  btnVisual.addEventListener('click', () => { persistOcrMode('visual'); showVisual(); });
                  toggleWrap.appendChild(btnPlain);
                  toggleWrap.appendChild(btnStruct);
                  toggleWrap.appendChild(btnVisual);
                  bodyWrap.insertBefore(toggleWrap, pre);
                  bodyWrap.appendChild(structContainer);
                  bodyWrap.appendChild(visualContainer);
                  const savedOcrMode = getStoredOcrMode();
                  if (savedOcrMode === 'plain') showPlain();
                  else if (savedOcrMode === 'visual') showVisual();
                  else showStruct();
                } else {
                  pre.style.display = '';
                  pre.textContent = txt;
                  if (highlight) applyHighlight(pre, highlight);
                }
                rawHint.remove();
                rawLoaded = true;
                loadBtn.disabled = true;
                loadBtn.hidden = true;
                loadStatus.textContent = s.viewerOcrLoaded;
              } catch (e) {
                if (e?.name === 'AbortError') return;
                pre.style.display = '';
                pre.classList.add('viewer-ocr-error');
                pre.textContent = s.viewerOcrError(e.message);
                loadBtn.disabled = false;
                loadBtn.hidden = false;
                loadStatus.textContent = s.viewerOcrError(e.message);
              } finally {
                ocrSection.setAttribute('aria-busy', 'false');
                rawLoading = false;
                rawLoadPromise = null;
              }
            })();
            await rawLoadPromise;
            if (scrollIntoView && rawLoaded) scrollToOcrSection();
          };

          loadBtn.addEventListener('click', () => {
            void loadRawOcr({ persistPreference: true });
          });

          topOcrBtn?.addEventListener('click', () => {
            void loadRawOcr({ scrollIntoView: true, persistPreference: true });
          });

          if (viewerMode !== 'reading') {
            autoLoadToggle.addEventListener('change', () => {
              persistRawAutoLoad(autoLoadToggle.checked);
            });
          }

          if (highlight) {
            pre.dataset.highlight = highlight;
          }

          if (shouldAutoLoadRaw) {
            void loadRawOcr();
          }

        }

        if (viewerMode === 'reading') {
          mainContent.appendChild(createReadingFooterNav());
          appendSummaryContent();
        }

        // Sidebar Metadados
        function addMetaBlock(title, items, isKeywords = false) {
          if (!items || !items.length) return null;
          const block = document.createElement('div');
          block.className = 'meta-block';
          const h4 = document.createElement('h4');
          h4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
          h4.textContent = title;
          block.appendChild(h4);

          const ul = document.createElement('ul');
          ul.className = 'chips';
          items.forEach((txt) => {
            const li = document.createElement('li');
            if (isKeywords) {
              const a = document.createElement('a');
              const params = new URLSearchParams({ keyword: txt });
              if (viewerMode === 'reading') params.set('view', 'reading');
              a.href = routeUrl('search', `?${params.toString()}`);
              a.textContent = txt;
              a.style.textDecoration = 'none';
              a.style.color = 'inherit';
              li.appendChild(a);
            } else {
              li.textContent = txt;
            }
            ul.appendChild(li);
          });
          block.appendChild(ul);
          return block;
        }

        // Índice de segmentos do volume (sidebar)
        if (segments && segments.length) {
          const segIndexBlock = document.createElement('div');
          segIndexBlock.className = 'meta-block viewer-segments-index';
          const segH4 = document.createElement('h4');
          segH4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
          segH4.textContent = s.viewerMetaSegments;
          segIndexBlock.appendChild(segH4);

          const segList = document.createElement('ul');
          segList.style.cssText = 'list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:var(--space-2);';

          segments.forEach((seg) => {
            const isActive = pageNumber >= seg.page_first && pageNumber <= seg.page_last;
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = buildNavUrl(seg.page_first);
            a.style.cssText = 'display:block; padding:var(--space-2) var(--space-3); border-radius:var(--radius); background:var(--color-surface); border:1px solid var(--color-border); text-decoration:none; color:inherit; font-size:0.8rem; transition: border-color 0.15s;';
            if (isActive) {
              a.className = 'segment-active';
              a.style.borderColor = 'var(--color-accent)';
              a.style.background = 'var(--color-surface-2)';
            }
            a.addEventListener('mouseenter', () => { if (!isActive) a.style.borderColor = 'var(--color-accent)'; });
            a.addEventListener('mouseleave', () => { if (!isActive) a.style.borderColor = 'var(--color-border)'; });

            const labelSpan = document.createElement('span');
            labelSpan.style.cssText = 'font-weight:600; display:block; margin-bottom:2px;';
            labelSpan.textContent = seg.label;

            const rangeSpan = document.createElement('span');
            rangeSpan.style.cssText = 'font-size:0.72rem; color:var(--color-muted);';
            rangeSpan.textContent = `${isEn ? 'p.' : isIt ? 'pag.' : isFr ? 'p.' : 'pág.'} ${seg.page_first}${seg.page_last !== seg.page_first ? '–' + seg.page_last : ''}`;

            a.appendChild(labelSpan);
            a.appendChild(rangeSpan);
            li.appendChild(a);
            segList.appendChild(li);
          });

          segIndexBlock.appendChild(segList);
          sidebar.appendChild(segIndexBlock);
        }

        const kwBlock = addMetaBlock(s.viewerMetaKeywords, keywordsLabels, true);
        if (kwBlock) sidebar.appendChild(kwBlock);

        const entBlock = addMetaBlock(s.viewerMetaEntities, entitiesLabels);
        if (entBlock) sidebar.appendChild(entBlock);

        // Páginas relacionadas (KNN cross-volume)
        const relatedPages = page.related_pages || [];
        if (relatedPages.length) {
          const volMap = new Map(volumes.volumes.map((v) => [v.id, v]));

          const relBlock = document.createElement('div');
          relBlock.className = 'meta-block';
          {
            const relH4 = document.createElement('h4');
            relH4.style.cssText = 'font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
            relH4.textContent = s.viewerRelated;
            relBlock.appendChild(relH4);
          }
          {
            const relH4 = document.createElement('h4');
            relH4.style.cssText = 'font-size:0.6rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--color-muted); margin:0 0 0.75rem;';
            relH4.textContent = s.viewerRelatedNote;
            relBlock.appendChild(relH4);
          }

          const relList = document.createElement('ul');
          relList.style.cssText = 'list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:var(--space-2);';

          relatedPages.forEach((rel) => {
            const relVol = volMap.get(rel.doc);
            const li = document.createElement('li');

            const a = document.createElement('a');
            const params = new URLSearchParams({ doc: rel.doc, page: String(rel.page) });
            if (viewerMode === 'reading') params.set('view', 'reading');
            a.href = routeUrl('viewer', `?${params.toString()}`);
            a.style.cssText = 'display:flex; flex-direction:column; gap:2px; padding:var(--space-2) var(--space-3); border-radius:var(--radius); background:var(--color-surface); border:1px solid var(--color-border); text-decoration:none; color:inherit; transition: border-color 0.15s;';
            a.addEventListener('mouseenter', () => a.style.borderColor = 'var(--color-accent)');
            a.addEventListener('mouseleave', () => a.style.borderColor = 'var(--color-border)');

            const titleSpan = document.createElement('span');
            titleSpan.style.cssText = 'font-size:0.85rem; font-weight:600; color:var(--color-accent);';
            titleSpan.textContent = s.viewerRelatedTitle(rel.doc, relVol?.title || '', rel.page);

            const distSpan = document.createElement('span');
            distSpan.style.cssText = 'font-size:0.72rem; color:var(--color-muted);';
            distSpan.textContent = s.viewerRelatedSim(1 - Math.min(rel.dist, 1));

            a.appendChild(titleSpan);
            a.appendChild(distSpan);
            li.appendChild(a);
            relList.appendChild(li);
          });

          relBlock.appendChild(relList);
          sidebar.appendChild(relBlock);
        }

        // Bookmark banner (continuar lendo)
        try {
          const bookmarks = JSON.parse(localStorage.getItem('viewerBookmarks') || '{}');
          const saved = bookmarks[doc];
          if (saved && saved.page !== pageNumber) {
            const banner = document.createElement('div');
            banner.className = 'viewer-bookmark-banner';
            const bannerText = document.createElement('span');
            bannerText.innerHTML = `📖 ${s.viewerContinueReading}: <strong>${s.viewerVolumeLabel(volume.id, volume.title || '')} · ${s.viewerPage(saved.page)}</strong>`;
            const bannerLink = document.createElement('a');
            bannerLink.href = buildNavUrl(saved.page);
            bannerLink.className = 'button';
            bannerLink.style.fontSize = '0.85rem';
            bannerLink.textContent = s.viewerGo;
            banner.appendChild(bannerText);
            banner.appendChild(bannerLink);
            viewerRoot.appendChild(banner);
          }
        } catch (_) {}

        mainGrid.appendChild(mainContent);
        mainGrid.appendChild(sidebar);
        viewerRoot.appendChild(mainGrid);
        prefetchAdjacentPages();

        if (highlight) {
          applyHighlight(resPagina.p, highlight);
          applyHighlight(resGlobal.p, highlight);
          applyHighlight(trechoRes.p, highlight);
        }
      } catch (err) {
        const safeMsg = escapeHtml(err instanceof Error ? err.message : String(err));
        viewerRoot.innerHTML = `<div class="card"><p style="color:var(--color-focus)">${s.viewerError(safeMsg)}</p></div>`;
      }
    }

    load();
  </script>
</Layout>
