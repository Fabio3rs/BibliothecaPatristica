---
import Layout from '../Layout.astro';
import { useTranslations, serializeTranslations, getLocaleBase } from '../../i18n';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const localeBase = getLocaleBase(Astro.currentLocale, base);
const t = useTranslations(Astro.currentLocale);
const uiStrings = serializeTranslations(t);
const uiLocale = Astro.currentLocale ?? 'pt-br';
---
<Layout title="Bibliotheca Patristica — Leitura" description="Visualizador de páginas do corpus patrístico com metadados enriquecidos e OCR." breadcrumbs={[{label: t.breadcrumbHome, href: localeBase},{label: t.breadcrumbViewer}]}>
  <div id="viewer-root" style="min-height:60vh;">
    <div style="padding:var(--space-8) 0;text-align:center;color:var(--color-muted);">
      <p>{t.viewerLoading}</p>
    </div>
  </div>

  <script type="module" define:vars={{ assetBase: baseWithSlash, localeBase, uiStrings, uiLocale }}>
    const viewerRoot = document.getElementById('viewer-root');
    let loadGeneration = 0;
    let rawOcrController = null;
    const dataCache = window.pdfocrDataCache;
    const localePath = localeBase.endsWith('/') ? localeBase.slice(0, -1) : localeBase;

    function routeUrl(route, search = '') {
      const cleanRoute = String(route || '').replace(/^\/+/, '');
      return `${localePath}/${cleanRoute}${search}`;
    }

    async function decodeJsonResponse(res, url) {
      if (!res.ok) throw new Error(`HTTP ${res.status} ao buscar ${url}`);
      const bytes = new Uint8Array(await res.arrayBuffer());
      const isGzipped = bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b;
      const payload = isGzipped && typeof DecompressionStream !== 'undefined'
        ? await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer()
        : bytes;
      const text = new TextDecoder('utf-8').decode(payload);
      return JSON.parse(text);
    }
    const getJsonOnce = (url) => dataCache?.getJsonOnce(url) ?? fetch(url).then((res) => decodeJsonResponse(res, url));
    const loadJsonInBatches = (urls, options = {}) => dataCache?.loadJsonInBatches(urls, options) ?? Promise.all(urls.map((url) => getJsonOnce(url).then((value) => ({ url, ok: true, value }), (error) => ({ url, ok: false, value: null, error }))));

    // Reconstrói funções de formatação (não serializáveis via define:vars)
    const isEn = uiLocale === 'en';
    const isIt = uiLocale === 'it';
    const localeTag = isEn ? 'en-US' : isIt ? 'it-IT' : 'pt-BR';
    const seoHubLabel = 'SEO';
    const s = {
      ...uiStrings,
      viewerVolume: (id, title) => `Volume ${id}${title ? ' — ' + title : ''}`,
      viewerPage: isEn ? (n) => `Page ${n}` : isIt ? (n) => `Pagina ${n}` : (n) => `Página ${n}`,
      viewerPageOfTotal: isEn ? (n, t) => `Page ${n} of ${t}` : isIt ? (n, t) => `Pagina ${n} di ${t}` : (n, t) => `Página ${n} de ${t}`,
      viewerFirst: isEn ? 'First' : isIt ? 'Prima' : 'Primeira',
      viewerLast: isEn ? 'Last' : isIt ? 'Ultima' : 'Última',
      viewerGo: isEn ? 'Go' : isIt ? 'Vai' : 'Ir',
      viewerPageInputLabel: isEn ? 'Page number' : isIt ? 'Numero di pagina' : 'Número da página',
      viewerFocusMode: isEn ? 'Reading mode' : isIt ? 'Modalità lettura' : 'Modo leitura',
      viewerNormalMode: isEn ? 'Default mode' : isIt ? 'Modalità standard' : 'Modo padrão',
      viewerDecreaseFont: isEn ? 'A-' : 'A-',
      viewerIncreaseFont: isEn ? 'A+' : 'A+',
      viewerContinueReading: isEn ? 'Continue reading' : isIt ? 'Continua la lettura' : 'Continuar lendo',
      viewerProgress: isEn ? 'Progress' : isIt ? 'Progresso' : 'Progresso',
      viewerSearchInVolume: isEn ? 'Search in this volume…' : isIt ? 'Cerca in questo volume…' : 'Buscar neste volume…',
      viewerIndex: isEn ? 'Index' : isIt ? 'Indice' : 'Índice',
      viewerNoIdentity: isEn ? 'Volume information not available' : isIt ? 'Informazioni sul volume non disponibili' : 'Informação do volume não disponível',
      viewerRelatedSim: isEn ? (sim) => `similarity ${sim.toFixed(2)}` : isIt ? (sim) => `somiglianza ${sim.toFixed(2)}` : (sim) => `similaridade ${sim.toFixed(2)}`,
      viewerRelatedTitle: isEn
        ? (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · p. ${page}`
        : isIt
          ? (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · pag. ${page}`
        : (doc, title, page) => `${doc}${title ? ' — ' + title : ''} · pág. ${page}`,
      viewerError: isEn ? (msg) => `Error loading viewer: ${msg}` : isIt ? (msg) => `Errore nel caricamento del visualizzatore: ${msg}` : (msg) => `Erro ao carregar viewer: ${msg}`,
      viewerVolumeLabel: (id, title) => `${isEn ? 'Volume' : 'Volume'} ${id}${title ? ' — ' + title : ''}`,
      viewerCitationVolumePage: isEn
        ? (volume, page) => `Volume ${volume}, p. ${page}`
        : isIt
          ? (volume, page) => `Volume ${volume}, p. ${page}`
          : (volume, page) => `Volume ${volume}, p. ${page}`,
      viewerCitationAccessed: isEn
        ? (date) => `Accessed ${date}`
        : isIt
          ? (date) => `Consultato il ${date}`
          : (date) => `Acesso em ${date}`,
    };

    function normalizeWhitespace(value) {
      return String(value || '').replace(/\s+/g, ' ').trim();
    }

    function hasMeaningfulDescriptor(value) {
      const text = normalizeWhitespace(value);
      if (!text || text.length <= 2) return false;
      return (text.match(/\p{L}/gu) || []).length >= 3;
    }

    function pickBestDescriptor(...values) {
      return values
        .map((value) => normalizeWhitespace(value))
        .filter((value) => hasMeaningfulDescriptor(value))
        .sort((a, b) => b.length - a.length)[0] || '';
    }

    function isUsefulLocator(value) {
      const text = normalizeWhitespace(value);
      return !!text && !/^\d+$/.test(text);
    }

    function formatAccessDate(date = new Date()) {
      return new Intl.DateTimeFormat(localeTag, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      }).format(date);
    }

    function joinSentence(parts) {
      return parts
        .map((part) => normalizeWhitespace(part))
        .filter(Boolean)
        .map((part) => part.endsWith('.') ? part : `${part}.`)
        .join(' ');
    }

    function buildCitationSubject(meta) {
      return [meta.work, meta.locator].filter(Boolean).join('. ');
    }

    function buildCitationAuthor(meta) {
      return normalizeWhitespace(meta.author || meta.source);
    }

    function buildCitationCorporateAuthor(meta) {
      return normalizeWhitespace(meta.source || meta.author);
    }

    function buildViewerIssueUrl({ page, volume, volumeAuthor, volumeWork }) {
      const issueTitleDescriptor = pickBestDescriptor(page.work, volumeWork, page.author, volumeAuthor, volume.title, volume.id);
      const referenceParts = [
        pickBestDescriptor(page.author, volumeAuthor),
        pickBestDescriptor(page.work, volumeWork),
        normalizeWhitespace(volume.title || ''),
      ].filter(Boolean);
      const reference = referenceParts.join(' — ') || volume.id;
      const title = `${volume.id} p. ${page.page}${issueTitleDescriptor ? ` — ${issueTitleDescriptor}` : ''}`;
      const params = new URLSearchParams({
        template: 'ocr-page-report.yml',
        title,
        volume_id: volume.id,
        page_number: String(page.page),
        page_url: window.location.href,
        reference,
      });
      return `https://github.com/Fabio3rs/BibliothecaPatristica/issues/new?${params.toString()}`;
    }

    function buildShortReference({ page, volume, volumeAuthor, volumeWork }) {
      const descriptor = pickBestDescriptor(page.title, page.work, volumeWork, page.author, volumeAuthor, volume.title);
      return `${volume.id} p. ${page.page}${descriptor ? ` — ${descriptor}` : ''}`;
    }

    function buildViewerDocumentTitle({ page, volume, volumeAuthor, volumeWork }) {
      const primary = pickBestDescriptor(page.author, volumeAuthor);
      const secondary = pickBestDescriptor(page.work, page.title, volumeWork, volume.title);
      const context = [primary, secondary].filter(Boolean).join(' — ');
      const baseLabel = context || s.viewerVolumeLabel(volume.id, volume.title || '');
      return `${baseLabel} · ${s.viewerPage(page.page)} | Bibliotheca Patristica`;
    }

    function buildCitationMetadata({ page, volume, volumeAuthor, volumeWork, summaryGlobal }) {
      const excerpt = normalizeWhitespace(page.excerpt || page.summary_page || summaryGlobal || page.summary_global || '');
      const author = pickBestDescriptor(page.author, volumeAuthor);
      const work = pickBestDescriptor(page.work, volumeWork);
      const locator = isUsefulLocator(page.title) ? normalizeWhitespace(page.title) : '';
      const source = normalizeWhitespace(s.viewerCitationSource || 'Bibliotheca Patristica Digital');
      const volumePage = s.viewerCitationVolumePage(volume.id, page.page);
      return {
        excerpt,
        author,
        work,
        locator,
        source,
        volumeId: volume.id,
        volumePage,
        url: window.location.href,
        accessDate: formatAccessDate(),
      };
    }

    function formatCitation(style, meta) {
      const author = buildCitationAuthor(meta);
      const corporateAuthor = buildCitationCorporateAuthor(meta);
      const subject = buildCitationSubject(meta) || meta.work || s.viewerVolumeLabel(meta.volumeId || '', '');
      const locator = meta.locator ? `${s.viewerCitationLocatorLabel} ${meta.locator}` : '';
      const volumePage = meta.volumePage;
      if (style === 'apa') {
        const authorPart = author || corporateAuthor;
        const workPart = subject || meta.source;
        const parenthetical = [locator, volumePage].filter(Boolean).join(', ');
        const sourcePart = meta.author ? meta.source : '';
        return joinSentence([
          authorPart,
          '(n.d.)',
          `${workPart}${parenthetical ? ` (${parenthetical})` : ''}`,
          sourcePart,
          meta.url,
        ]);
      }
      if (style === 'chicago') {
        return joinSentence([
          author || corporateAuthor,
          subject,
          locator,
          volumePage,
          s.viewerCitationAccessed(meta.accessDate),
          meta.url,
        ]);
      }
      if (style === 'abnt') {
        return joinSentence([
          (author || corporateAuthor).toLocaleUpperCase(localeTag),
          subject,
          volumePage,
          `${s.viewerCitationAvailableAt}: ${meta.url}`,
          `${s.viewerCitationAccessedOn}: ${meta.accessDate}`,
        ]);
      }
      return joinSentence([
        author || corporateAuthor,
        subject,
        locator,
        volumePage,
        `${s.viewerCitationAvailableAt}: ${meta.url}`,
        `${s.viewerCitationAccessedOn}: ${meta.accessDate}`,
      ]);
    }

    async function writeClipboardWithFeedback(button, buildText, idleLabel) {
      try {
        const text = buildText();
        if (!text) return;
        await navigator.clipboard.writeText(text);
        button.textContent = s.viewerCopied;
      } catch (_) {
        button.textContent = s.viewerCopyFailed;
      }
      setTimeout(() => {
        button.textContent = idleLabel;
      }, 1200);
    }

    async function getJSON(path) {
      return getJsonOnce(path);
    }

    function normalizeViewerMode(value) {
      return value === 'reading' ? 'reading' : 'default';
    }

    function getStoredViewerMode() {
      try {
        const stored = normalizeViewerMode(localStorage.getItem('viewerMode'));
        if (stored === 'reading') return stored;
        if (localStorage.getItem('viewerFocusMode') === '1') return 'reading';
      } catch (_) {}
      return 'default';
    }

    function getRequestedViewerMode(url) {
      return normalizeViewerMode(url.searchParams.get('view'));
    }

    function resolveInitialViewerMode(url) {
      if (url.searchParams.has('view')) {
        return getRequestedViewerMode(url);
      }
      // Query params sem `view` representam links canônicos do layout padrão.
      // Só reaproveitamos a preferência local quando o viewer abre "nu".
      if (url.searchParams.toString()) {
        return 'default';
      }
      return getStoredViewerMode();
    }

    function applyViewerMode(mode) {
      const isReading = mode === 'reading';
      viewerRoot.classList.toggle('viewer-reading-mode', isReading);
      document.body.classList.toggle('viewer-reading-active', isReading);
    }

    function persistViewerMode(mode) {
      try {
        localStorage.setItem('viewerMode', mode);
      } catch (_) {}
    }

    function getStoredRawAutoLoad() {
      try {
        return localStorage.getItem('viewerRawAutoLoad') === '1';
      } catch (_) {}
      return false;
    }

    function persistRawAutoLoad(enabled) {
      try {
        localStorage.setItem('viewerRawAutoLoad', enabled ? '1' : '0');
      } catch (_) {}
    }

    function scheduleIdle(callback, timeout = 1200) {
      if (typeof requestIdleCallback === 'function') {
        requestIdleCallback(callback, { timeout });
        return;
      }
      window.setTimeout(callback, Math.min(timeout, 250));
    }

    function safeUrl(raw) {
      if (!raw) return '#';
      try {
        const resolved = new URL(raw, window.location.origin);
        // Mesmo domínio: retorna caminho relativo
        if (resolved.origin === window.location.origin) return resolved.pathname + resolved.search + resolved.hash;
        // Externo http/https: permitido (o viewer é estático; http cobre servidores locais,
        // https cobre GitHub raw em produção — import.meta.env.DEV não é confiável em
        // builds estáticos servidos localmente pois é substituído por false no bundle)
        if (resolved.protocol === 'https:' || resolved.protocol === 'http:') return resolved.href;
        return '#';
      } catch (err) {
        if (raw.startsWith('/')) return raw;
        return '#';
      }
    }

    function labelize(ids = [], dict = []) {
      const map = new Map(dict.map((d) => [d.id, d.label]));
      return ids.map((id) => map.get(id) || id);
    }

    function keywordShardKeyFromId(keywordId) {
      const slug = String(keywordId || '').replace(/^k:/, '').trim().toLowerCase();
      if (!slug) return 'other';
      const first = slug[0];
      if (/[0-9]/.test(first)) return '0-9';
      if (/[a-z]/.test(first)) return first;
      return 'other';
    }

    async function loadKeywordsForIds(ids = []) {
      const uniqueIds = Array.from(new Set((ids || []).filter((id) => typeof id === 'string' && id.length > 0)));
      if (!uniqueIds.length) return [];

      const fallbackLookup = async () => {
        const lookup = await getJSON(`${assetBase}dict/keywords_lookup.json`)
          .catch(() => getJSON(`${assetBase}dict/keywords.json`));
        const dict = Array.isArray(lookup?.items) ? lookup.items : [];
        const map = new Map(dict.map((d) => [d.id, d.label]));
        return uniqueIds.map((id) => map.get(id) || id);
      };

      const manifest = await getJSON(`${assetBase}dict/keywords_manifest.json`).catch(() => null);
      if (!manifest?.shards?.length || manifest.strategy !== 'alpha') {
        return fallbackLookup();
      }

      const shardById = new Map(manifest.shards.map((shard) => [shard.id, shard.path]));
      const shardKeys = Array.from(new Set(uniqueIds.map((id) => keywordShardKeyFromId(id))));
      const shardPayloads = await loadJsonInBatches(
        shardKeys.map((shardKey) => shardById.get(shardKey)).filter(Boolean).map((shardPath) => `${assetBase}${shardPath}`),
        { batchSize: 4, delayMs: 12 },
      );

      const map = new Map();
      shardPayloads.forEach((payload) => {
        (payload.value?.items || []).forEach((item) => {
          if (item?.id && item?.label && !map.has(item.id)) {
            map.set(item.id, item.label);
          }
        });
      });

      const missing = uniqueIds.filter((id) => !map.has(id));
      if (missing.length) {
        const lookup = await getJSON(`${assetBase}dict/keywords_lookup.json`)
          .catch(() => getJSON(`${assetBase}dict/keywords.json`));
        const dict = Array.isArray(lookup?.items) ? lookup.items : [];
        const lookupMap = new Map(dict.map((d) => [d.id, d.label]));
        missing.forEach((id) => {
          if (lookupMap.has(id)) map.set(id, lookupMap.get(id));
        });
      }

      return uniqueIds.map((id) => map.get(id) || id);
    }

    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function escapeRegex(s) {
      return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function renderMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br>');
    }

    function applyHighlight(el, term) {
      if (!el || !term) return;
      // Extrai o texto plano (sem as tags HTML já renderizadas) para re-renderizar
      // com os highlights por cima do Markdown processado.
      const txt = el.textContent || '';
      if (!txt) return;
      const re = new RegExp(`(${escapeRegex(term)})`, 'gi');
      // Re-aplica o renderMarkdown sobre o texto original armazenado em data-raw,
      // preservando a formatação e adicionando os <mark>.
      const raw = el.dataset.raw || txt;
      // Se for XML bruto (classe viewer-ocr-xml), aplicar highlight seguro sobre os nós de texto
      if (el.classList && el.classList.contains('viewer-ocr-xml')) {
        // remove marcas anteriores
        Array.from(el.querySelectorAll('mark')).forEach((m) => {
          m.replaceWith(document.createTextNode(m.textContent));
        });

        // percorre nós de texto e envolve ocorrências em <mark>
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
        const textNodes = [];
        while (walker.nextNode()) textNodes.push(walker.currentNode);
        textNodes.forEach((node) => {
          const parent = node.parentNode;
          if (!parent) return;
          const text = node.nodeValue || '';
          const matches = text.match(re);
          if (!matches) return;
          const frag = document.createDocumentFragment();
          let lastIndex = 0;
          text.replace(re, (match, offset) => {
            const before = text.slice(lastIndex, offset);
            if (before) frag.appendChild(document.createTextNode(before));
            const mk = document.createElement('mark');
            mk.textContent = match;
            frag.appendChild(mk);
            lastIndex = offset + match.length;
          });
          const after = text.slice(lastIndex);
          if (after) frag.appendChild(document.createTextNode(after));
          parent.replaceChild(frag, node);
        });
      } else {
        el.innerHTML = renderMarkdown(raw).replace(re, (_, m) => `<mark>${escapeHtml(m)}</mark>`);
      }
    }

    // Simple XML syntax highlighter — escapes HTML then wraps tags/attrs/names
    function highlightXml(txt) {
      if (!txt) return '';
      const esc = escapeHtml(txt);
      // Regex to capture tags and attributes (simple, not full XML parser)
      return esc
        .replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="xml-comment">$1</span>')
        .replace(/(&lt;\/?)([a-zA-Z0-9_:-]+)([^&]*?)(&gt;)/g, (_m, open, name, rest, close) => {
          // color attributes inside rest
          const attrs = rest.replace(/([a-zA-Z0-9:_-]+)(=)\"([^\"]*)\"/g, '<span class="xml-attr">$1</span>$2<span class="xml-value">"$3"</span>');
          return `${open}<span class="xml-name">${name}</span>${attrs}${close}`;
        })
        .replace(/([^&]|^)([^\n]+)/g, (m) => m); // noop for other text
    }

    // ── Parser e renderer de OCR estruturado ──
    function parseOcrXml(xmlText) {
      try {
        const parser = new DOMParser();
        const doc = parser.parseFromString(xmlText, 'application/xml');
        const pagina = doc.querySelector('pagina');
        if (!pagina) return null;
        const estado = pagina.getAttribute('estado') || '';
        const blocos = Array.from(pagina.querySelectorAll('bloco')).map((b) => {
          const bbox = (b.getAttribute('bbox') || '').split(',').map(Number);
          return {
            tipo: b.getAttribute('tipo') || 'outro',
            script: b.getAttribute('script') || 'desconhecido',
            bbox: bbox.length === 4 ? bbox : null,
            text: (b.textContent || '').trim(),
          };
        }).filter((b) => b.text.length > 0);
        let width = 0;
        let height = 0;
        blocos.forEach((b) => {
          if (b.bbox) {
            width = Math.max(width, b.bbox[2]);
            height = Math.max(height, b.bbox[3]);
          }
        });
        return { estado, blocos, width, height };
      } catch (e) {
        console.warn('OCR XML parse error:', e);
        return null;
      }
    }

    function scriptLabel(script) {
      const labels = {
        latino: 'Latino', latin: 'Latino',
        grego: 'Grego',
        copta: 'Copta', copte: 'Copta', copto: 'Copta',
        siriaco: 'Siríaco',
        cirilico: 'Cirílico',
        ethiopico: 'Etíope',
        armenio: 'Armênio',
        arabe: 'Árabe',
        hebraico: 'Hebraico',
        misto: 'Misto',
        desconhecido: '?',
      };
      return labels[script?.toLowerCase()] || (script || '?');
    }

    function typeLabel(tipo) {
      const labels = {
        cabecalho: 'Cabeçalho',
        texto_principal: 'Texto',
        aparato_critico: 'Aparato crítico',
        rodape: 'Rodapé',
        nota: 'Nota',
        nota_marginal: 'Nota marginal',
        outro: 'Outro',
        titulo: 'Título',
        capa_ou_guarda: 'Capa',
      };
      return labels[tipo?.toLowerCase()] || (tipo || 'Bloco');
    }

    function renderOcrStructured(container, ocrData) {
      container.innerHTML = '';
      if (!ocrData || !ocrData.blocos.length) {
        container.innerHTML = `<p style="color:var(--color-muted);margin:0;">${s.viewerOcrNoBlocks}</p>`;
        return;
      }

      const wrap = document.createElement('div');
      wrap.className = 'viewer-ocr-body';

      // Legenda compacta de scripts
      const scriptsSeen = new Set(ocrData.blocos.map((b) => b.script));
      if (scriptsSeen.size > 1) {
        const legend = document.createElement('div');
        legend.style.cssText = 'display:flex; gap:var(--space-2); flex-wrap:wrap; margin-bottom:var(--space-3); font-size:0.75rem; color:var(--color-muted);';
        scriptsSeen.forEach((sc) => {
          const chip = document.createElement('span');
          chip.style.cssText = 'display:inline-flex; align-items:center; gap:6px; padding:2px 8px; border-radius:var(--radius-s); background:var(--color-surface-2); border:1px solid var(--color-border);';
          const colorDot = document.createElement('span');
          colorDot.className = 'ocr-script-chip';
          // map script -> color
          const scriptColors = {
            latino: '#2b8cbe',
            latin: '#2b8cbe',
            grego: '#8da0cb',
            copta: '#e78ac3',
            siriaco: '#66c2a5',
            cirilico: '#a6d854',
            ethiopico: '#fc8d62',
            armenio: '#ffd92f',
            arabe: '#e5c494',
            hebraico: '#b3b3b3',
            misto: '#999999',
            desconhecido: '#999999'
          };
          const key = (sc || '').toLowerCase();
          colorDot.style.background = scriptColors[key] || '#b0b0b0';
          chip.appendChild(colorDot);
          const label = document.createElement('span');
          label.textContent = scriptLabel(sc);
          chip.appendChild(label);
          legend.appendChild(chip);
        });
        wrap.appendChild(legend);
      }

      ocrData.blocos.forEach((bloco) => {
        const el = document.createElement('div');
        const tipoNorm = bloco.tipo.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const scriptNorm = (bloco.script || '').toLowerCase().replace(/[^a-z0-9]/g, '_');
        el.className = `ocr-block type-${tipoNorm} script-${scriptNorm}`;

        // Apenas mostrar meta para tipos não-comuns ou scripts não-latinos
        const isCommon = ['corpo', 'texto', 'paragrafo', 'outro'].includes(tipoNorm);
        const isLatin = ['latino', 'latin', 'desconhecido'].includes(bloco.script?.toLowerCase());
        const showMeta = !isCommon || !isLatin;

        if (showMeta) {
          const meta = document.createElement('div');
          meta.style.cssText = 'font-size:0.72rem; color:var(--color-muted); margin-bottom:0.25em; display:flex; gap:var(--space-2);';
          // adicionar chip colorido ao lado do script
          if (!isLatin && bloco.script) {
            const span = document.createElement('span');
            span.className = 'meta-script';
            const dot = document.createElement('span');
            dot.className = 'ocr-script-chip';
            const scriptColors = {
              latino: '#2b8cbe',
              latin: '#2b8cbe',
              grego: '#8da0cb',
              copta: '#e78ac3',
              siriaco: '#66c2a5',
              cirilico: '#a6d854',
              ethiopico: '#fc8d62',
              armenio: '#ffd92f',
              arabe: '#e5c494',
              hebraico: '#b3b3b3',
              misto: '#999999',
              desconhecido: '#999999'
            };
            dot.style.background = scriptColors[(bloco.script || '').toLowerCase()] || '#b0b0b0';
            const lbl = document.createElement('span'); lbl.textContent = `· ${scriptLabel(bloco.script)}`;
            span.appendChild(dot);
            span.appendChild(lbl);
            meta.appendChild(document.createElement('span'));
            meta.firstChild.textContent = typeLabel(bloco.tipo);
            meta.appendChild(span);
          } else {
            meta.innerHTML = `<span>${typeLabel(bloco.tipo)}</span>`;
          }
          el.appendChild(meta);
        }

        const text = document.createElement('div');
        text.textContent = bloco.text;
        el.appendChild(text);
        wrap.appendChild(el);
      });

      container.appendChild(wrap);
    }

    function renderOcrVisual(container, ocrData) {
      container.innerHTML = '';
      if (!ocrData || !ocrData.blocos.length) {
        container.innerHTML = `<p style="color:var(--color-muted);margin:0;">${s.viewerOcrNoBlocks}</p>`;
        return;
      }
      const { width, height, blocos } = ocrData;
      if (!width || !height) {
        renderOcrStructured(container, ocrData);
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'viewer-ocr-visual';
      const aspect = (height / width) * 100;
      const spacer = document.createElement('div');
      spacer.style.paddingTop = aspect + '%';
      wrap.appendChild(spacer);
      blocos.forEach((bloco, idx) => {
        if (!bloco.bbox) return;
        const [x1, y1, x2, y2] = bloco.bbox;
        const el = document.createElement('div');
        const tipoNorm = bloco.tipo.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const scriptNorm = (bloco.script || '').toLowerCase().replace(/[^a-z0-9]/g, '_');
        el.className = `ocr-block type-${tipoNorm} script-${scriptNorm}`;
        el.style.position = 'absolute';
        el.style.left = (x1 / width * 100) + '%';
        el.style.top = (y1 / height * 100) + '%';
        el.style.width = ((x2 - x1) / width * 100) + '%';
        el.style.height = ((y2 - y1) / height * 100) + '%';
        el.style.overflow = 'hidden';
        el.style.fontSize = `clamp(0.45rem, ${((y2 - y1) / height * 100) / 4}vw, 0.9rem)`;
        el.style.padding = '2px 4px';
        el.style.boxSizing = 'border-box';
        el.style.zIndex = String(idx);
        const text = document.createElement('span');
        text.textContent = bloco.text;
        text.style.wordBreak = 'break-word';
        text.style.lineHeight = '1.15';
        el.appendChild(text);
        el.title = `${typeLabel(bloco.tipo)} · ${scriptLabel(bloco.script)}\n${bloco.text}`;
        wrap.appendChild(el);
      });
      container.appendChild(wrap);
    }

    async function load() {
      try {
        const generation = ++loadGeneration;
        if (rawOcrController) rawOcrController.abort();
        rawOcrController = null;
        document.body.classList.add('viewer-active');
        const url = new URL(window.location.href);
        const doc = url.searchParams.get('doc') || 'PG144';
        const highlight = (url.searchParams.get('highlight') || '').trim();
        const initialViewerMode = resolveInitialViewerMode(url);

        const volumes = await getJSON(`${assetBase}volumes.json`);

        const volume = volumes.volumes.find((v) => v.id === doc);
        if (!volume) throw new Error(isIt ? 'Volume non trovato nei mock' : 'Volume não encontrado nos mocks');
        const requestedPage = Number(url.searchParams.get('page'));
        const pageNumber = Number.isFinite(requestedPage) && requestedPage > 0
          ? Math.min(Math.max(requestedPage, volume.page_first || 1), volume.page_last || requestedPage)
          : (volume.page_first || 1);

        const meta = await getJSON(`${assetBase}${volume.meta_url.replace(/^\//, '')}`);
        const block = meta.page_blocks.find((b) => pageNumber >= b.page_first && pageNumber <= b.page_last);
        if (!block) throw new Error(isIt ? 'Blocco non trovato' : 'Bloco não encontrado');

        const blockData = await getJSON(`${assetBase}${block.file.replace(/^\//, '')}`);
        const page = blockData.pages.find((p) => p.page === pageNumber) || blockData.pages[0];

        const [keywordsLabels, entities, collections] = await Promise.all([
          loadKeywordsForIds(page.keyword_ids || []),
          getJSON(`${assetBase}dict/entities.json`),
          getJSON(`${assetBase}dict/collections.json`),
        ]);

        const segmentsFile = meta.segment_blocks?.[0]?.file;
        const snapshotFile = meta.snapshot_blocks?.[0]?.file;
        const segments = segmentsFile ? (await getJSON(`${assetBase}${segmentsFile.replace(/^\//, '')}`)).segments : [];
        const snapshots = snapshotFile ? (await getJSON(`${assetBase}${snapshotFile.replace(/^\//, '')}`)).snapshots : [];

        const pageSnapshots = snapshots.filter((s) => (page.snapshot_ids || []).includes(s.id));

        const entitiesLabels = labelize(page.entity_ids, entities.items);
        const snapshotLabels = pageSnapshots.map((s) => s.label);
        const summaryGlobal = page.summary_global || pageSnapshots[0]?.summary || '';
        let viewerMode = initialViewerMode;
        const rawHref = safeUrl(page.raw?.url);
        const shouldAutoLoadRaw = rawHref !== '#' && getStoredRawAutoLoad();

        // Bookmark: save current position
        try {
          const bookmarks = JSON.parse(localStorage.getItem('viewerBookmarks') || '{}');
          bookmarks[doc] = { page: pageNumber, ts: Date.now() };
          localStorage.setItem('viewerBookmarks', JSON.stringify(bookmarks));
        } catch (_) {}

        viewerRoot.innerHTML = '';
        if (generation !== loadGeneration) return;

        // Injetar estilos do viewer apenas uma vez
        if (!document.getElementById('viewer-styles')) {
          const styleTag = document.createElement('style');
          styleTag.id = 'viewer-styles';
          styleTag.textContent = `
            .viewer-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: start; gap: var(--space-6); }
            @media (min-width: 1400px) { .viewer-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-8); } }
            @media (max-width: 1100px) { .viewer-grid { grid-template-columns: 1fr; gap: var(--space-4); } }
            body.viewer-reading-active { background: color-mix(in srgb, var(--color-bg) 74%, #f1e6d2 26%); }
            body.viewer-reading-active .topbar { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(10px); background: color-mix(in srgb, var(--color-bg) 82%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent); }
            body.viewer-reading-active .topbar .wrapper { padding-top: var(--space-2); padding-bottom: var(--space-2); }
            body.viewer-reading-active .topbar .tagline,
            body.viewer-reading-active .breadcrumbs,
            body.viewer-reading-active .disclaimer-wrapper,
            body.viewer-reading-active .footer { display: none !important; }
            body.viewer-reading-active #conteudo.wrapper { max-width: 92ch; }
            .viewer-grid aside { order: 2; }
            .viewer-grid .main-content { order: 1; }
            .viewer-grid aside { position: sticky; top: 5.75rem; align-self: start; }
            @media (max-width: 1100px) { .viewer-grid aside { position: static; } }
            .viewer-header-nav { display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; }
            .viewer-header-nav .button.disabled { opacity: 0.45; pointer-events: none; cursor: default; }
            .viewer-header-nav input[type="number"] { width: 4.5rem; padding: 0.35rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-s); background: var(--color-surface); color: var(--color-ink); font-size: 0.9rem; text-align: center; }
            .viewer-header-nav input[type="number"]:focus { outline: 2px solid var(--color-accent); outline-offset: 2px; }
            .viewer-header-nav .button { padding: 0.35rem 0.65rem; font-size: 0.85rem; }
            .viewer-action-bar { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
            @media (max-width: 720px) {
              .viewer-header-nav .button { padding: 0.3rem 0.5rem; font-size: 0.8rem; }
              .viewer-header-nav input[type="number"] { width: 3.8rem; font-size: 0.85rem; }
            }
            @media (max-width: 480px) {
              .viewer-header-nav { gap: 4px; }
              .viewer-header-nav .button { padding: 0.25rem 0.4rem; font-size: 0.75rem; min-width: 2rem; text-align: center; }
              .viewer-header-nav .nav-label-text { display: none; }
            }
            .viewer-identity { margin-bottom: var(--space-4); padding: var(--space-4); border-radius: var(--radius-m); background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-2) 100%); border: 1px solid var(--color-border); }
            .viewer-identity h3 { margin: 0 0 var(--space-2); font-family: var(--font-serif); color: var(--color-accent); font-size: 1.15rem; }
            @media (min-width: 1400px) { .viewer-identity h3 { font-size: 1.35rem; } }
            .viewer-identity p { margin: 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.5; }
            .viewer-identity .identity-meta-wrap { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-top: var(--space-2); }
            .viewer-identity .identity-badge { display: inline-block; padding: 2px 8px; border-radius: var(--radius-s); background: var(--color-surface); border: 1px solid var(--color-border); font-size: 0.75rem; color: var(--color-muted); }
            .viewer-progress-bar { width: 100%; height: 4px; background: var(--color-border); border-radius: 2px; margin-top: var(--space-3); overflow: hidden; }
            .viewer-progress-bar > div { height: 100%; background: var(--color-accent); border-radius: 2px; transition: width 0.3s ease; }
            .viewer-reading-mode .viewer-grid { grid-template-columns: 1fr !important; }
            .viewer-reading-mode aside { display: none !important; }
            .viewer-reading-mode .main-content { max-width: 72ch; margin: 0 auto; padding: var(--space-6); background: color-mix(in srgb, var(--color-surface) 90%, #f8ecd8 10%); box-shadow: 0 12px 36px rgba(65, 48, 20, 0.08); }
            .viewer-reading-mode .viewer-identity { margin-bottom: var(--space-6); background: transparent; padding: 0 0 var(--space-4); border-radius: 0; border: 0; border-bottom: 1px solid var(--color-border); }
            .viewer-reading-mode .viewer-identity .identity-meta-wrap { margin-top: var(--space-3); }
            .viewer-reading-mode .viewer-toolbar { position: sticky; top: 4.25rem; z-index: 10; margin: 0 0 var(--space-5); padding: var(--space-3); background: color-mix(in srgb, var(--color-surface) 90%, transparent); border: 1px solid color-mix(in srgb, var(--color-border) 90%, transparent); border-radius: var(--radius-m); box-shadow: 0 8px 24px rgba(20, 20, 20, 0.05); }
            .viewer-reading-mode .viewer-action-bar { margin-bottom: var(--space-5); }
            .viewer-reading-mode .viewer-header-nav { justify-content: flex-start; }
            .viewer-reading-mode .viewer-header-nav .button,
            .viewer-reading-mode .viewer-toolbar .button { min-height: 2.25rem; }
            .viewer-reading-mode .viewer-bookmark-banner { max-width: 72ch; margin-left: auto; margin-right: auto; }
            .viewer-reading-mode .main-content p,
            .viewer-reading-mode .main-content li { line-height: 1.9; }
            @media (min-width: 1400px) { .viewer-reading-mode .main-content { max-width: 74ch; } }
            @media (max-width: 720px) {
              body.viewer-reading-active #conteudo.wrapper { max-width: 100%; }
              .viewer-reading-mode .main-content { padding: var(--space-4); border-radius: var(--radius-m); }
              .viewer-reading-mode .viewer-toolbar { top: 3.75rem; }
            }
            .viewer-bookmark-banner { margin-bottom: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-m); background: var(--color-surface-2); border: 1px solid var(--color-accent); display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
            .viewer-index-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(3rem, 1fr)); gap: 4px; max-height: 200px; overflow-y: auto; }
            @media (min-width: 1400px) { .viewer-index-list { max-height: 320px; grid-template-columns: repeat(auto-fill, minmax(3.2rem, 1fr)); } }
            .viewer-index-list a { display: block; padding: 4px; text-align: center; border-radius: var(--radius-s); font-size: 0.8rem; text-decoration: none; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-border); transition: all 0.15s; }
            .viewer-index-list a:hover, .viewer-index-list a.current { background: var(--color-accent); color: white; border-color: var(--color-accent); }
            .viewer-ocr-body { font-family: var(--font-serif); line-height: 1.8; font-size: 1.05rem; }
            .viewer-ocr-body .ocr-block { margin-bottom: 1em; }
            .viewer-ocr-body .ocr-block.titulo { font-weight: 700; font-size: 1.2em; color: var(--color-accent); }
            .viewer-ocr-body .ocr-block.nota { font-size: 0.9em; color: var(--color-muted); border-left: 3px solid var(--color-border); padding-left: 1em; }
            .viewer-ocr-body .ocr-block.cabecalho { font-variant: small-caps; letter-spacing: 0.05em; }
            /* Chips to indicate script with a visible color */
            .ocr-script-chip { display:inline-block; width:10px; height:10px; border-radius:50%; margin-left:6px; vertical-align:middle; border:1px solid rgba(0,0,0,0.08); }
            .ocr-block .meta-script { display:inline-flex; align-items:center; gap:6px; }

            /* XML syntax highlight for plain OCR view */
            pre.viewer-ocr-xml { font-family:var(--font-mono, monospace); font-size:0.82rem; line-height:1.6; white-space:pre-wrap; word-break:break-word; }
            pre.viewer-ocr-xml .xml-tag { color: #0b5; }
            pre.viewer-ocr-xml .xml-name { color: #07f; }
            pre.viewer-ocr-xml .xml-attr { color: #c67; }
            pre.viewer-ocr-xml .xml-value { color: #a31515; }
            pre.viewer-ocr-xml .xml-text { color: var(--color-text); }
            .viewer-toolbar { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
            @media (max-width: 480px) { .viewer-toolbar { flex-direction: column; align-items: stretch; } .viewer-search-local { width: 100%; } }
            .viewer-search-local { display: flex; gap: var(--space-2); align-items: center; flex: 1; min-width: 200px; }
            .viewer-search-local input { flex: 1; padding: 0.4rem 0.6rem; border: 1px solid var(--color-border); border-radius: var(--radius-s); background: var(--color-surface); color: var(--color-ink); font-size: 0.9rem; }
            .viewer-search-local input:focus { outline: 2px solid var(--color-accent); outline-offset: 2px; }
            .viewer-sidebar-section { margin-bottom: var(--space-4); }
            .viewer-sidebar-section h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); margin: 0 0 0.75rem; }
            /* Layout wide no viewer */
            body.viewer-active .wrapper { max-width: 1400px; }
            @media (min-width: 1600px) { body.viewer-active .wrapper { max-width: 1600px; } }
            /* OCR visual layout */
            .viewer-ocr-visual { position: relative; width: 100%; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-s); overflow: auto; min-height: 65vh; }
            .viewer-ocr-visual .ocr-block { position: absolute; margin-bottom: 0; border-radius: 2px; min-height: 1.6em; min-width: 3ch; overflow: hidden; }
            .viewer-ocr-visual .ocr-block.type-cabecalho { text-align: center; }
            .viewer-ocr-visual .ocr-block:hover { z-index: 999 !important; box-shadow: 0 0 0 2px var(--color-accent); overflow: visible; background: var(--color-surface); }
            .viewer-segments-index a.segment-active { border-color: var(--color-accent); background: var(--color-surface-2); }
            .viewer-segments-index a.segment-active span:first-child { color: var(--color-accent); }

          `;
          document.head.appendChild(styleTag);
        }

        const mainGrid = document.createElement('div');
        mainGrid.className = 'main-grid viewer-grid';

        const mainContent = document.createElement('div');
        mainContent.className = 'card main-content';

        const sidebar = document.createElement('aside');
        sidebar.style.cssText = 'display:flex; flex-direction:column; gap:var(--space-4);';

        // Calcular limites de página a partir dos blocos de metadados
        const allBlocks = meta.page_blocks || [];
        const firstPage = allBlocks.length ? allBlocks[0].page_first : 1;
        const lastPage = allBlocks.length ? allBlocks[allBlocks.length - 1].page_last : pageNumber;

        function buildViewerSearch(targetPage, overrides = {}) {
          const p = new URLSearchParams({ doc, page: String(targetPage) });
          if (highlight) p.set('highlight', highlight);
          const targetMode = normalizeViewerMode(overrides.view ?? viewerMode);
          if (targetMode === 'reading') p.set('view', 'reading');
          return `?${p.toString()}`;
        }

        function buildNavUrl(targetPage, overrides = {}) {
          return buildViewerSearch(targetPage, overrides);
        }

        function createBreadcrumbItem(content, { href = '', isCurrent = false, separator = false } = {}) {
          const li = document.createElement('li');
          li.style.cssText = 'display:flex;align-items:center;gap:0.35rem;';
          if (separator) {
            li.setAttribute('aria-hidden', 'true');
            const span = document.createElement('span');
            span.textContent = '/';
            li.appendChild(span);
            return li;
          }
          if (href) {
            const link = document.createElement('a');
            link.href = href;
            link.textContent = content;
            li.appendChild(link);
            return li;
          }
          const span = document.createElement('span');
          if (isCurrent) span.setAttribute('aria-current', 'page');
          span.textContent = content;
          li.appendChild(span);
          return li;
        }

        function syncViewerModeUrl() {
          const nextUrl = `${window.location.pathname}${buildViewerSearch(pageNumber)}${window.location.hash || ''}`;
          window.history.replaceState(window.history.state, '', nextUrl);
        }

        function setViewerMode(nextMode) {
          viewerMode = normalizeViewerMode(nextMode);
          applyViewerMode(viewerMode);
          persistViewerMode(viewerMode);
          syncViewerModeUrl();
          void load();
        }

        function prefetchPageAssets(targetPage) {
          if (targetPage < firstPage || targetPage > lastPage) return;
          const targetBlock = allBlocks.find((candidate) => targetPage >= candidate.page_first && targetPage <= candidate.page_last);
          if (!targetBlock?.file) return;
          const targetBlockUrl = `${assetBase}${targetBlock.file.replace(/^\//, '')}`;
          void getJsonOnce(targetBlockUrl).catch(() => {});
        }

        function prefetchAdjacentPages() {
          scheduleIdle(() => {
            [pageNumber + 1, pageNumber - 1].forEach((targetPage) => prefetchPageAssets(targetPage));
          });
        }

        // Cabeçalho com Navegação
        // ── Cartão de identidade do volume ──
        const identityCard = document.createElement('div');
        identityCard.className = 'viewer-identity';
        identityCard.style.marginBottom = 'var(--space-4)';

        // Tentar extrair autor/obra do snapshot global
        let volumeAuthor = '';
        let volumeWork = '';
        let volumeSummary = '';
        try {
          const snapshotFile = meta.snapshot_blocks?.[0]?.file;
          if (snapshotFile) {
            const snapData = await getJSON(`${assetBase}${snapshotFile.replace(/^\//, '')}`);
            const globalSnap = snapData.snapshots?.find((s) => s.kind === 'volume_summary');
            if (globalSnap?.summary) {
              const lines = globalSnap.summary.split('\n');
              for (const line of lines) {
                if (line.startsWith('Autor:')) volumeAuthor = line.replace('Autor:', '').trim();
                else if (line.startsWith('Livro/obra identificada:')) volumeWork = line.replace('Livro/obra identificada:', '').trim();
                else if (!volumeSummary && line.trim().length > 10 && !line.includes('não há conteúdo anterior')) volumeSummary = line.trim();
              }
              if (!volumeSummary) volumeSummary = lines.find((l) => l.trim().length > 20 && !l.includes('não há conteúdo anterior')) || '';
            }
          }
        } catch (e) { /* ignore */ }

        // Atualizar título da aba e breadcrumb com o melhor contexto disponível
        document.title = buildViewerDocumentTitle({ page, volume, volumeAuthor, volumeWork });
        if (generation !== loadGeneration) return;
        const breadcrumbVolumeLabel = volumeWork || volumeAuthor || s.viewerVolumeLabel(volume.id, volume.title || '');
        const breadcrumbsEl = document.querySelector('.breadcrumbs ol');
        if (breadcrumbsEl) {
          breadcrumbsEl.replaceChildren(
            createBreadcrumbItem(uiStrings.breadcrumbHome || (isEn ? 'Home' : isIt ? 'Home' : 'Início'), { href: localeBase }),
            createBreadcrumbItem('', { separator: true }),
            createBreadcrumbItem(breadcrumbVolumeLabel),
            createBreadcrumbItem('', { separator: true }),
            createBreadcrumbItem(s.viewerPage(page.page), { isCurrent: true }),
          );
        }

        const volCollectionLabel = collections.items.find((c) => c.id === volume.collection_id)?.label || volume.collection_id;
        const identityTitle = document.createElement('h3');
        identityTitle.textContent = volumeAuthor && volumeWork ? `${volumeAuthor} — ${volumeWork}` : (volumeWork || volumeAuthor || s.viewerVolumeLabel(volume.id, volume.title || ''));
        identityCard.appendChild(identityTitle);

        const identityMetaWrap = document.createElement('div');
        identityMetaWrap.className = 'identity-meta-wrap';

        const badgeCollection = document.createElement('span');
        badgeCollection.className = 'identity-badge';
        badgeCollection.textContent = volCollectionLabel;
        identityMetaWrap.appendChild(badgeCollection);

        const badgePage = document.createElement('span');
        badgePage.className = 'identity-badge';
        badgePage.textContent = s.viewerPageOfTotal(pageNumber, lastPage);
        identityMetaWrap.appendChild(badgePage);

        const seoLink = document.createElement('a');
        seoLink.className = 'identity-badge';
        seoLink.href = `${assetBase}seo/volumes/${encodeURIComponent(volume.id)}`;
        seoLink.textContent = seoHubLabel;
        identityMetaWrap.appendChild(seoLink);

        if (volumeSummary) {
          const summaryP = document.createElement('p');
          summaryP.style.cssText = 'margin: var(--space-2) 0 0; color: var(--color-muted); font-size: 0.9rem; line-height: 1.5;';
          summaryP.textContent = volumeSummary.substring(0, 200) + (volumeSummary.length > 200 ? '…' : '');
          identityCard.appendChild(identityMetaWrap);
          identityCard.appendChild(summaryP);
        } else {
