---
import Layout from '../Layout.astro';
import { useTranslations, serializeTranslations } from '../../i18n';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const assetBase = baseWithSlash;

const t = useTranslations(Astro.currentLocale);
const uiStrings = serializeTranslations(t);
const uiLocale = Astro.currentLocale ?? 'pt-br';

const startPoints = {
  "Autores Notáveis": [
    { label: "Agostinho de Hipona", term: "Agostinho de Hipona" },
    { label: "Orígenes de Alexandria", term: "Orígenes de Alexandria" },
    { label: "João Crisóstomo", term: "João Crisóstomo" },
    { label: "Jerônimo", term: "Jerônimo de Estridão" },
  ],
  "Temas Centrais": [
    { label: "Trindade", term: "Trindade" },
    { label: "Cristologia", term: "Cristologia" },
    { label: "Eucaristia", term: "Eucaristia" },
    { label: "Gnose", term: "Gnosis" },
  ]
};

const personas = [
  {
    icon: '🕊️',
    title: t.personaDevotoTitle,
    desc: t.personaDevotoDesc,
    cta: t.personaDevotoCta,
    href: `${baseWithSlash}search?term=${encodeURIComponent('João Crisóstomo')}`,
  },
  {
    icon: '📖',
    title: t.personaTheologyTitle,
    desc: t.personaTheologyDesc,
    cta: t.personaTheologyCta,
    href: `${baseWithSlash}search`,
  },
  {
    icon: '🔬',
    title: t.personaResearcherTitle,
    desc: t.personaResearcherDesc,
    cta: t.personaResearcherCta,
    href: `${baseWithSlash}search?term=${encodeURIComponent('Trindade')}`,
  },
];
---

<style>
  .hero {
    text-align: center;
    padding: var(--space-8) var(--space-4);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-accent) 8%, var(--color-bg)) 0%, var(--color-bg) 100%);
    border-radius: var(--radius-m);
    border: 1px solid var(--color-border);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin: 0 0 var(--space-3);
    line-height: 1.2;
  }
  .hero p {
    max-width: 65ch;
    margin: 0 auto var(--space-5);
    color: var(--color-muted);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
    text-align: center;
  }
  .stat-item h3 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    margin: 0;
    color: var(--color-accent);
  }
  .stat-item p {
    margin: var(--space-1) 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .start-points-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
  .start-points-grid h3 {
    margin-top: 0;
    margin-bottom: var(--space-3);
    font-family: var(--font-serif);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--space-2);
    font-size: 1.1rem;
  }
  .start-points-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .start-points-grid a {
    text-decoration: none;
    color: var(--color-ink);
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-s);
    transition: background-color 0.2s;
  }
  .start-points-grid a:hover {
    background-color: var(--color-surface-raised);
  }

  .personas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
  .persona-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    padding: var(--space-5);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .persona-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  .persona-icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .persona-card h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }
  .persona-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    flex: 1;
  }
  .persona-card .button {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (prefers-color-scheme: dark) {
    .persona-card:hover {
      box-shadow: 0 12px 32px rgba(0,0,0,0.35);
    }
  }
</style>

<Layout title="Bibliotheca Patristica" description={t.homeSubtitle.replace(/<[^>]*>/g, '')} breadcrumbs={[{label: t.breadcrumbHome, href: baseWithSlash}]}>
  <Fragment slot="head">
    <link rel="prefetch" href={`${baseWithSlash}search`} />
    <link rel="prefetch" href={`${baseWithSlash}pagefind/pagefind.js`} />
  </Fragment>

  <!-- Hero -->
  <section class="hero" style="margin-top:var(--space-4);">
    <h1>{t.homeTitle}</h1>
    <p set:html={t.homeSubtitle}></p>
    <div class="hero-actions">
      <a class="button" href={`${baseWithSlash}search`}>{t.homeCtaSearch}</a>
      <a class="button secondary" href={`${baseWithSlash}viewer?doc=PG059&page=535`}>{t.homeCtaExample}</a>
    </div>
  </section>

  <!-- Stats -->
  <section class="card-plain" style="margin-top:var(--space-5);">
    <div class="stats-grid" id="stats-grid">
      <div class="stat-item"><h3>…</h3><p>{t.statVolumes}</p></div>
      <div class="stat-item"><h3>{t.statSeries}</h3><p>{t.statSeriesLabel}</p></div>
      <div class="stat-item"><h3>…</h3><p>{t.statPages}</p></div>
      <div class="stat-item"><h3>{t.statTokens}</h3><p>{t.statTokensLabel}</p></div>
    </div>
  </section>

  <!-- About -->
  <section class="card" style="margin-top:var(--space-5);">
    <h2 style="margin-top:0;font-family:var(--font-serif);">{t.aboutTitle}</h2>
    <div style="display:flex; flex-direction:column; gap:var(--space-4); color:var(--color-ink); line-height:1.6; max-width:80ch;">
      <p set:html={t.aboutP1}></p>
      <p set:html={t.aboutP2}></p>
      <p set:html={t.aboutP3}></p>
      <p set:html={t.aboutP4}></p>
      <p set:html={t.aboutP5}></p>
      <p set:html={t.aboutP6}></p>
      <p set:html={t.aboutP7}></p>
    </div>
  </section>

  <!-- Personas -->
  <section class="card" style="margin-top:var(--space-5);">
    <h2 style="margin-top:0;font-family:var(--font-serif);">{t.personasTitle}</h2>
    <p style="color:var(--color-muted); max-width:65ch;">{t.personasDesc}</p>
    <div class="personas-grid">
      {personas.map(p => (
        <div class="persona-card">
          <div class="persona-icon" aria-hidden="true">{p.icon}</div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
          <a class="button" href={p.href}>{p.cta}</a>
        </div>
      ))}
    </div>
  </section>

  <!-- Pontos de partida -->
  <section class="card" style="margin-top:var(--space-5);">
    <h2 style="margin-top:0;font-family:var(--font-serif);">{t.startPointsTitle}</h2>
    <p style="color:var(--color-muted); max-width:65ch;">{t.startPointsDesc}</p>
    <div class="start-points-grid">
      {Object.entries(startPoints).map(([title, links]) => (
        <div>
          <h3>{title}</h3>
          <ul>
            {links.map(link => (
              <li><a href={`${baseWithSlash}search?term=${encodeURIComponent(link.term)}`}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Tag Cloud -->
  <section class="card" style="margin-top:var(--space-5);">
    <header style="display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);flex-wrap:wrap;">
      <div>
        <p style="margin:0;color:var(--color-muted);">{t.tagCloudSubtitle}</p>
        <h2 style="margin:0;font-family:var(--font-serif);">{t.tagCloudTitle}</h2>
      </div>
      <small style="color:var(--color-muted);">{t.tagCloudNote}</small>
    </header>
    <div id="tag-cloud" role="list" aria-label={t.tagCloudTitle} style="margin-top:var(--space-4); display:flex; gap:0.6rem; flex-wrap:wrap; align-items:flex-end;">
      <p style="margin:0;color:var(--color-muted);">{t.tagCloudLoading}</p>
    </div>
  </section>

  <script type="module" define:vars={{ assetBase, uiStrings, uiLocale }}>
    const cloud = document.getElementById('tag-cloud');
    const statsGrid = document.getElementById('stats-grid');
    const searchUrl = (tag) => `${assetBase}search?term=${encodeURIComponent(tag)}`;

    const isEn = uiLocale === 'en';
    const s = uiStrings;
    const ariaOccurrences = isEn
      ? (n) => `${n} occurrence(s)`
      : (n) => `${n} ocorrência(s)`;

    function formatNumber(n) {
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace('.0', '')}M+`;
      if (n >= 1_000) return `${Math.round(n / 1_000)}k+`;
      return String(n);
    }

    async function loadStats() {
      try {
        const res = await fetch(`${assetBase}volumes.json`);
        if (!res.ok) return;
        const data = await res.json();
        const volumes = data.volumes || [];
        const totalPages = volumes.reduce((acc, v) => acc + ((v.page_last || 0) - (v.page_first || 1) + 1), 0);

        const cells = statsGrid.querySelectorAll('.stat-item h3');
        if (cells[0]) cells[0].textContent = `${volumes.length}+`;
        if (cells[2]) cells[2].textContent = formatNumber(totalPages);
      } catch (e) {
        console.warn(s.statsLoadError, e);
      }
    }

    function renderCloud(items) {
      cloud.innerHTML = '';
      const maxLog = Math.log1p(Math.max(...items.map(i => i.count || 1)));
      const minLog = Math.log1p(Math.min(...items.map(i => i.count || 1)));
      const logRange = Math.max(1, maxLog - minLog);

      const shuffled = [...items];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }

      const minSize = 0.82, maxSize = 1.75;
      shuffled.forEach((item) => {
        const ratio = (Math.log1p(item.count || 1) - minLog) / logRange;
        const size = minSize + ratio * (maxSize - minSize);
        const a = document.createElement('a');
        a.href = searchUrl(item.label);
        a.textContent = item.label;
        a.setAttribute('role', 'listitem');
        a.title = item.count ? ariaOccurrences(item.count) : item.label;
        a.style.fontSize = `${size.toFixed(2)}rem`;
        a.style.fontWeight = ratio > 0.6 ? '700' : '500';
        a.style.color = 'var(--color-ink)';
        a.style.textDecoration = 'none';
        a.style.padding = '0.2rem 0.35rem';
        a.style.borderRadius = '6px';
        a.style.background = 'color-mix(in srgb, var(--color-accent) 10%, var(--color-surface))';
        a.style.border = '1px solid var(--color-border)';
        a.style.transition = 'background 0.15s';
        a.addEventListener('mouseover', () => { a.style.background = 'color-mix(in srgb, var(--color-accent) 22%, var(--color-surface))'; });
        a.addEventListener('mouseout', () => { a.style.background = 'color-mix(in srgb, var(--color-accent) 10%, var(--color-surface))'; });
        cloud.appendChild(a);
      });
    }

    async function loadTags() {
      try {
        const res = await fetch(`${assetBase}dict/keywords_top.json`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const items = (data.items || []).slice(0, 60);
        if (items.length) {
          renderCloud(items);
        } else {
          cloud.innerHTML = `<p style="margin:0;color:var(--color-muted);">${s.tagCloudEmpty}</p>`;
        }
      } catch (err) {
        console.error(s.tagCloudError, err);
        cloud.innerHTML = `<p style="margin:0;color:var(--color-muted);">${s.tagCloudError}</p>`;
      }
    }

    loadStats();
    loadTags();
  </script>
</Layout>
