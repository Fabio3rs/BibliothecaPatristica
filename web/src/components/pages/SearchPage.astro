---
import Layout from '../Layout.astro';
import FiltersPanel from '../FiltersPanel.astro';
import { useTranslations, serializeTranslations, getLocaleBase } from '../../i18n';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const localeBase = getLocaleBase(Astro.currentLocale, base);
const t = useTranslations(Astro.currentLocale);
const uiStrings = serializeTranslations(t);
const uiLocale = Astro.currentLocale ?? 'pt-br';
---
<Layout title={t.searchTitle} description={t.searchSubtitle} breadcrumbs={[{label: t.breadcrumbHome, href: localeBase},{label: t.breadcrumbSearch}]}>
  <div class="main-grid search-layout">
    <FiltersPanel loading={true} />

    <section aria-label={t.ariaResults} class="search-main">
      <header class="search-hero card">
        <div class="search-hero-copy">
          <p class="eyebrow">{t.searchSubtitle}</p>
          <h1>{t.searchTitle}</h1>
          <p>{t.searchHeroHint}</p>
          <p class="search-data-note">{t.searchDataNote}</p>
        </div>
        <div class="search-controls">
          <label class="sr-only" for="search-box">{t.searchPlaceholder}</label>
          <input id="search-box" type="search" placeholder={t.searchPlaceholder} list="keywords-suggestions" class="search-input search-input-xl" />
          <datalist id="keywords-suggestions"></datalist>
          <div class="search-toolbar">
            <label for="page-size" class="search-toolbar-label">{t.searchItemsLabel}</label>
            <select id="page-size" class="page-size-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
            </select>
          </div>
          <div class="search-quick-filters" aria-label={t.searchHeroLabel}>
            <button type="button" class="chip-button" data-collection="">{t.searchAllCollections}</button>
            <button type="button" class="chip-button" data-collection="PG">PG</button>
            <button type="button" class="chip-button" data-collection="PL">PL</button>
            <button type="button" class="chip-button" data-collection="PO">PO</button>
          </div>
          <div class="search-suggestions">
            <button type="button" class="suggestion-button" data-term="Agostinho de Hipona">{t.searchQuickAuthors}</button>
            <button type="button" class="suggestion-button" data-term="Trindade">{t.searchQuickThemes}</button>
            <button type="button" class="suggestion-button" data-term="João 1,1">{t.searchQuickScripture}</button>
            <button type="button" class="suggestion-button" data-term="Eucaristia">{t.searchQuickKeywords}</button>
          </div>
        </div>
      </header>

      <div id="results" class="results-list" aria-live="polite">
        <p>{t.searchLoading}</p>
      </div>
    </section>
  </div>

  <style>
    .search-layout {
      align-items: start;
    }
    .search-layout :global(.card[aria-label]) {
      position: sticky;
      top: calc(var(--space-4) + 72px);
      max-height: calc(100vh - 96px);
      overflow: auto;
    }
    .search-main {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .search-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-6);
      border: 1px solid var(--color-border);
      background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 92%, var(--color-accent) 8%) 0%, var(--color-surface) 100%);
    }
    .search-hero-copy .eyebrow {
      margin: 0 0 var(--space-2);
      color: var(--color-muted);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
    }
    .search-hero-copy h1 {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.1;
    }
    .search-hero-copy p {
      margin: var(--space-3) 0 0;
      max-width: 70ch;
      color: var(--color-muted);
      line-height: 1.65;
    }
    .search-data-note {
      padding: var(--space-3) var(--space-4);
      border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
      border-radius: var(--radius-m);
      background: color-mix(in srgb, var(--color-surface) 82%, var(--color-accent) 18%);
      font-size: 0.95rem;
    }
    .search-controls {
      display: grid;
      gap: var(--space-3);
    }
    .search-input-xl {
      max-width: none;
      padding: 1rem 1.05rem;
      border-radius: var(--radius-m);
      font-size: 1.05rem;
    }
    .search-toolbar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .search-toolbar-label {
      color: var(--color-muted);
      font-size: 0.9rem;
    }
    .filters details {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-s);
      background: var(--color-surface-2);
      padding: 0.5rem 0.7rem;
    }
    .filters summary {
      cursor: pointer;
      list-style: none;
      font-weight: 700;
    }
    .filters summary::-webkit-details-marker { display: none; }
    .filters-group {
      display: grid;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }
    .search-quick-filters,
    .search-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .chip-button,
    .suggestion-button {
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-ink);
      padding: 0.45rem 0.8rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.9rem;
    }
    .chip-button:hover,
    .suggestion-button:hover,
    .chip-button[aria-pressed="true"] {
      background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
      border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
    }
    .search-result-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    @keyframes shimmer {
      0% { background-position: 0% 0; }
      100% { background-position: 200% 0; }
    }
    .result-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 0.7rem;
      font-size: 0.92rem;
      color: var(--color-muted);
    }
    .result-meta-item {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      line-height: 1.4;
      padding: 0.14rem 0.55rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    }
    .result-meta-label {
      color: var(--color-ink);
      font-weight: 600;
      white-space: nowrap;
      letter-spacing: 0.01em;
    }
    .result-meta-value {
      color: var(--color-muted);
      overflow-wrap: anywhere;
    }
    .result-chips {
      gap: 0.4rem;
    }
    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .results-list .card {
      box-shadow: var(--shadow-soft);
    }
    @media (max-width: 980px) {
      .search-hero {
        padding: var(--space-5);
      }
      .search-layout :global(.card[aria-label]) {
        position: static;
        max-height: none;
        overflow: visible;
      }
    }
    @media (max-width: 720px) {
      .search-hero {
        padding: var(--space-4);
      }
      .search-hero-copy h1 {
        font-size: clamp(1.7rem, 8vw, 2.3rem);
      }
      .search-result-card .button {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script type="module" define:vars={{ assetBase: baseWithSlash, localeBase, uiStrings, uiLocale }}>
    const resultsEl = document.getElementById('results');
    const searchBox = document.getElementById('search-box');
    const pageSizeSel = document.getElementById('page-size');
    // uiStrings não contém filtersTitle pois é string (está em uiStrings), mas o aside
    // usa o atributo aria-label renderizado pelo servidor. Selecionamos pelo papel semântico.
    const filtersRoot = document.querySelector('aside[aria-label]');
    const datalist = document.getElementById('keywords-suggestions');
    const quickCollectionButtons = Array.from(document.querySelectorAll('[data-collection]'));
    const suggestionButtons = Array.from(document.querySelectorAll('[data-term]'));
    let checkboxNodes = [];
    let keywordOptions = [];
    let keywordCatalog = null;
    let keywordCatalogPromise = null;
    let keywordManifest = null;
    let keywordManifestPromise = null;
    let renderGeneration = 0;
    let keywordCatalogGeneration = 0;
    const dataCache = window.pdfocrDataCache;
    const jsonCache = new Map();
    const RESULT_BATCH_SIZE = 8;
    const KEYWORD_SHARD_BATCH_SIZE = 4;

    // Reconstrói funções de formatação (não serializáveis via define:vars)
    const s = uiStrings;
    const isEn = uiLocale === 'en';
    const isIt = uiLocale === 'it';
    const paginationShowing = isEn
      ? (start, end, total) => `Showing ${start}–${end} of ${total} results`
      : isIt
        ? (start, end, total) => `Mostrando ${start}–${end} di ${total} risultati`
      : (start, end, total) => `Mostrando ${start}–${end} de ${total} resultados`;
    const paginationPage = isEn
      ? (page, total) => `Page ${page} / ${total}`
      : isIt
        ? (page, total) => `Pagina ${page} / ${total}`
      : (page, total) => `Página ${page} / ${total}`;
    const ariaFilterBy = isEn
      ? (cat, val) => `Filter by ${cat}: ${val}`
      : isIt
        ? (cat, val) => `Filtra per ${cat}: ${val}`
      : (cat, val) => `Filtrar por ${cat}: ${val}`;
    const escapeHtml = (value) => String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const getJsonOnce = (url) => {
      if (dataCache?.getJsonOnce) return dataCache.getJsonOnce(url);
      if (!jsonCache.has(url)) {
        const promise = fetch(url).then(async (res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status} ao buscar ${url}`);
          return res.json();
        }).catch((err) => {
          jsonCache.delete(url);
          throw err;
        });
        jsonCache.set(url, promise);
      }
      return jsonCache.get(url);
    };

    const loadJsonInBatches = (urls, options = {}) => {
      if (dataCache?.loadJsonInBatches) return dataCache.loadJsonInBatches(urls, options);
      return Promise.all(urls.map((url) => getJsonOnce(url).then(
        (value) => ({ url, ok: true, value }),
        (error) => ({ url, ok: false, value: null, error }),
      )));
    };

    const state = {
      term: '',
      pageSize: 25,
      page: 1,
      filters: {},
      exactPhrase: false,
    };

    function readStateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const term = params.get('term') || '';
      const pageSize = parseInt(params.get('pageSize'), 10);
      const page = parseInt(params.get('page'), 10);
      const filters = {};
      // Apenas 'collection' e 'volume' são filtros estruturais do Pagefind (leves).
      // 'keyword' é resolvido via busca textual (term) para evitar baixar o chunk de 7MB.
      ['collection', 'volume', 'book'].forEach((key) => {
        const values = params.getAll(key);
        if (values.length) filters[key] = values;
      });
      // Keywords vindas da URL (?keyword=X) são convertidas em term de busca textual
      const kwValues = params.getAll('keyword');
      const termFromKw = kwValues.join(' ');
      state.term = term || termFromKw;
      state.exactPhrase = kwValues.length > 0 && !!termFromKw;
      state.pageSize = !Number.isNaN(pageSize) && pageSize > 0 ? Math.min(pageSize, 50) : 25;
      state.page = !Number.isNaN(page) && page > 0 ? page : 1;
      state.filters = filters;
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (state.term.trim()) params.set('term', state.term.trim());
      if (state.pageSize && state.pageSize !== 25) params.set('pageSize', String(state.pageSize));
      if (state.page && state.page > 1) params.set('page', String(state.page));
      // Apenas filtros estruturais (collection, volume) na URL — keywords vão em 'term'
      Object.entries(state.filters).forEach(([key, values]) => {
        if (key === 'keyword') return; // não serializa keyword como filtro
        values.forEach((v) => params.append(key, v));
      });
      const newUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState({}, '', newUrl);
    }

    readStateFromUrl();
    searchBox.value = state.term;
    pageSizeSel.value = String(state.pageSize);
    quickCollectionButtons.forEach((btn) => {
      const selected = state.filters.collection?.includes(btn.dataset.collection || '') || (!state.filters.collection && !(btn.dataset.collection || ''));
      btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });

    let pagefindInstance = null;
    let pagefindPromise = null;
    let pagefindManifest = null;
    let pagefindManifestPromise = null;
    let renderTimer = null;

    const basePath = assetBase.endsWith('/') ? assetBase.slice(0, -1) : assetBase;
    const localePath = localeBase.endsWith('/') ? localeBase.slice(0, -1) : localeBase;

    function localizeRoutePath(pathname) {
      const normalized = String(pathname || '/');
      const withoutBase = normalized.startsWith(basePath)
        ? normalized.slice(basePath.length)
        : normalized;
      const withLeadingSlash = withoutBase.startsWith('/') ? withoutBase : `/${withoutBase}`;
      let strippedPath = withLeadingSlash;
      if (withLeadingSlash === '/en' || withLeadingSlash === '/it') strippedPath = '/';
      else if (withLeadingSlash.startsWith('/en/')) strippedPath = withLeadingSlash.slice(3) || '/';
      else if (withLeadingSlash.startsWith('/it/')) strippedPath = withLeadingSlash.slice(3) || '/';
      return `${localePath}${strippedPath === '/' ? '' : strippedPath}`;
    }

    function pagefindAssetUrl(relativePath) {
      const cleanPath = String(relativePath || '').replace(/^\/+/, '');
      return `${assetBase}${cleanPath}`;
    }

    async function loadPagefindManifest() {
      if (pagefindManifest) return pagefindManifest;
      if (pagefindManifestPromise) return pagefindManifestPromise;
      pagefindManifestPromise = (async () => {
        try {
          const res = await fetch(`${assetBase}pagefind/manifest.json`);
          if (!res.ok) return null;
          return await res.json();
        } catch {
          return null;
        }
      })();
      pagefindManifest = await pagefindManifestPromise;
      return pagefindManifest;
    }

    async function loadKeywordManifest() {
      if (keywordManifest) return keywordManifest;
      if (keywordManifestPromise) return keywordManifestPromise;
      keywordManifestPromise = (async () => {
        try {
          const res = await fetch(`${assetBase}dict/keywords_manifest.json`);
          if (!res.ok) return null;
          return await res.json();
        } catch {
          return null;
        }
      })();
      keywordManifest = await keywordManifestPromise;
      return keywordManifest;
    }

    function normalizeKeywordOptions(items) {
      return Array.from(new Set((items || [])
        .map((item) => item?.label)
        .filter((label) => typeof label === 'string' && label.trim().length > 0)))
        .sort((a, b) => a.localeCompare(b, uiLocale, { sensitivity: 'base' }));
    }

    async function ensureKeywordCatalog() {
      if (keywordCatalog) return keywordCatalog;
      if (keywordCatalogPromise) return keywordCatalogPromise;
      const generation = ++keywordCatalogGeneration;
      keywordCatalogPromise = (async () => {
        const manifest = await loadKeywordManifest();
        let items = [];

        try {
          if (manifest?.shards?.length) {
            const shardResults = await loadJsonInBatches(
              manifest.shards.map((shard) => `${assetBase}${shard.path}`),
              { batchSize: KEYWORD_SHARD_BATCH_SIZE, delayMs: 12 },
            );
            items = shardResults.flatMap((payload) => Array.isArray(payload.value?.items) ? payload.value.items : []);
          } else {
            const fallback = await getJsonOnce(`${assetBase}dict/keywords_lookup.json`)
              .catch(() => getJsonOnce(`${assetBase}dict/keywords.json`));
            items = Array.isArray(fallback?.items) ? fallback.items : [];
          }
        } catch (err) {
          console.error(err);
          const fallback = await getJsonOnce(`${assetBase}dict/keywords_lookup.json`)
            .catch(() => getJsonOnce(`${assetBase}dict/keywords.json`));
          items = Array.isArray(fallback?.items) ? fallback.items : [];
        }

        if (generation !== keywordCatalogGeneration) return keywordCatalog || [];
        keywordCatalog = items;
        keywordOptions = normalizeKeywordOptions(items);
        if (searchBox.value) updateSuggestions();
        return keywordCatalog;
      })().catch((err) => {
        console.error(err);
        keywordCatalog = null;
        keywordCatalogPromise = null;
        return [];
      });
      return keywordCatalogPromise;
    }

    async function loadFilters() {
      try {
        // Volumes e collections são leves e necessários para os filtros estruturais.
        // Keywords entram em duas camadas: top keywords imediatas para chips e
        // catálogo completo sob demanda para sugestões e navegação.
        const volumesObj = await getJsonOnce(`${assetBase}volumes.json`);

        const volumes = volumesObj.volumes || [];

        const collections = Array.from(new Set(volumes.map((v) => v.collection_id))).sort();
        const volumeIds = volumes.map((v) => v.id).sort();

        const sections = [
          { key: 'collection', label: s.filterCollection, items: collections },
          { key: 'volume', label: s.filterVolume, items: volumeIds },
        ];

        filtersRoot.innerHTML = `
          <h2 style="margin-top:0;">${s.filtersTitle}</h2>
          <div class="filters">
            ${sections.map((sec) => `
              <details ${sec.key === 'collection' ? 'open' : ''}>
                <summary>${sec.label}</summary>
                <div class="filters-group">
                  ${sec.items.length ? sec.items.map((item) => `
                    <label>
                      <input type="checkbox" name="${sec.key}" value="${item}">
                      ${item}
                    </label>
                  `).join('') : `<p class="muted" style="margin:0;">${s.filtersNoOptions}</p>`}
                </div>
              </details>
            `).join('')}
            <div>
              <h3>${s.filterKeywords}</h3>
              <p style="font-size:0.8rem;color:var(--color-muted);margin:0 0 0.5rem;">${s.filterKeywordsHint}</p>
              <div id="keywords-chips" style="display:flex;flex-wrap:wrap;gap:0.3rem;">
                <span style="font-size:0.8rem;color:var(--color-muted);">${s.filterKeywordsLoading}</span>
              </div>
            </div>
          </div>
        `;

        checkboxNodes = Array.from(filtersRoot.querySelectorAll('input[type="checkbox"]'));

        // aplicar estado inicial de filtros vindos da URL
        checkboxNodes.forEach((cb) => {
          const { name, value } = cb;
          if (state.filters[name] && state.filters[name].includes(value)) {
            cb.checked = true;
          }
          cb.addEventListener('change', handleFilterChange);
        });

        // Carrega keywords em background, sem bloquear a renderização dos filtros estruturais
        getJsonOnce(`${assetBase}dict/keywords_top.json`)
          .then((keywordsObj) => {
            const keywords = keywordsObj.items || [];
            keywordOptions = keywords
              .map((k) => k.label)
              .filter((label) => typeof label === 'string' && label.trim().length > 0);
            const chipsContainer = document.getElementById('keywords-chips');
            if (!chipsContainer) return;
            const chips = keywords.slice(0, 300);
            chipsContainer.innerHTML = chips.map((kw) => `
              <button type="button" class="keyword-chip" data-keyword="${kw.label.replace(/"/g, '&quot;')}"
                 style="font-size:0.78rem;padding:0.15rem 0.45rem;border-radius:999px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-ink);cursor:pointer;"
                 title="${kw.label.replace(/"/g, '&quot;')}">${kw.label.replace(/</g, '&lt;').replace(/&/g, '&amp;')}</button>
            `).join('');
            chipsContainer.querySelectorAll('.keyword-chip').forEach((btn) => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                toggleFilter('keyword', btn.dataset.keyword);
              });
            });
            if (state.term) {
              void ensureKeywordCatalog();
              updateSuggestions();
            }
          })
          .catch(() => {
            const chipsContainer = document.getElementById('keywords-chips');
            if (chipsContainer) chipsContainer.innerHTML = `<span style="font-size:0.8rem;color:var(--color-muted);">${s.filterKeywordsUnavailable}</span>`;
          });
      } catch (err) {
        filtersRoot.innerHTML = `<p class="muted" style="margin:0;">${s.filtersUnavailable}</p>`;
        console.error(err);
      }
    }

    function normalizeUrl(raw) {
      if (!raw) return '#';
      if (/^https?:\/\//i.test(raw)) return raw; // Absolutos

      // Remove repetição do base em qualquer formato
      let path = raw.trim();
      const baseNoSlash = basePath.replace(/^\//, '');
      const stripPrefixes = [basePath, `${basePath}/`, baseNoSlash, `${baseNoSlash}/`];
      for (const pref of stripPrefixes) {
        while (path.startsWith(pref)) {
          path = path.slice(pref.length);
        }
      }

      // Garante barra inicial
      if (!path.startsWith('/')) path = `/${path}`;

      return localizeRoutePath(`${basePath}${path}`);
    }

    async function ensurePagefind() {
      if (pagefindInstance) return pagefindInstance;
      if (pagefindPromise) return pagefindPromise;
      pagefindPromise = (async () => {
        try {
          const manifest = await loadPagefindManifest();
          const primaryPath = manifest?.indexes?.[0]?.path || 'pagefind';
          const bundlePath = manifest?.indexes?.[0]?.path
            ? pagefindAssetUrl(`${primaryPath}/pagefind.js`)
            : pagefindAssetUrl('pagefind/main/pagefind.js');
          const mod = await import(bundlePath);
          const pfModule = mod?.default || mod?.pagefind || mod;
          const pf = (pfModule && typeof pfModule.search === 'function') ? pfModule : mod;
          const basePathForInit = manifest?.indexes?.[0]?.path
            ? pagefindAssetUrl(`${primaryPath}/`)
            : pagefindAssetUrl('pagefind/main/');

          if (pf && typeof pf.options === 'function') {
            await pf.options({ basePath: basePathForInit });
          }

          if (manifest?.indexes?.length > 1 && pf && typeof pf.mergeIndex === 'function') {
            for (const extra of manifest.indexes.slice(1)) {
              await pf.mergeIndex(pagefindAssetUrl(`${extra.path}/`));
            }
          }

          if (pf && typeof pf.search === 'function') return pf;
          throw new Error('Bundle Pagefind sem search utilizável');
        } catch (err) {
          console.error(err);
          resultsEl.textContent = s.searchIndexUnavailable;
          return null;
        }
      })();
      pagefindInstance = await pagefindPromise;
      return pagefindInstance;
    }

    function handleFilterChange() {
      const filters = {};
      checkboxNodes.filter((c) => c.checked).forEach((c) => {
        if (!filters[c.name]) filters[c.name] = [];
        filters[c.name].push(c.value);
      });
      state.filters = filters;
      state.page = 1;
      syncUrl();
      
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(() => {
        render();
      }, 300);
    }

    function toggleFilter(name, value) {
      // Keywords são buscadas como texto (evita baixar o filter chunk de 7MB)
      if (name === 'keyword') {
        state.term = state.term === value ? '' : value;
        state.exactPhrase = !!state.term;
        searchBox.value = state.term;
        state.page = 1;
        syncUrl();
        if (renderTimer) clearTimeout(renderTimer);
        renderTimer = setTimeout(render, 50);
        return;
      }
      if (!state.filters[name]) state.filters[name] = [];
      const idx = state.filters[name].indexOf(value);
      if (idx === -1) {
        state.filters[name].push(value);
      } else {
        state.filters[name].splice(idx, 1);
      }
      if (state.filters[name].length === 0) delete state.filters[name];
      
      // Sincronizar checkboxes se existirem
      checkboxNodes.forEach(cb => {
        if (cb.name === name && cb.value === value) {
          cb.checked = !cb.checked;
        }
      });
      
      state.page = 1;
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    }

    function setCollectionFilter(collection) {
      if (!collection) {
        delete state.filters.collection;
        checkboxNodes.forEach((cb) => {
          if (cb.name === 'collection') cb.checked = false;
        });
      } else {
        state.filters.collection = [collection];
        checkboxNodes.forEach((cb) => {
          if (cb.name === 'collection') {
            cb.checked = cb.value === collection;
          }
        });
      }
      quickCollectionButtons.forEach((btn) => {
        const selected = collection ? btn.dataset.collection === collection : !btn.dataset.collection;
        btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      state.page = 1;
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    }

    window.clearAllFilters = function() {
      state.filters = {};
      state.term = '';
      state.page = 1;
      searchBox.value = '';
      checkboxNodes.forEach(cb => cb.checked = false);
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    };

    function handleTermInput() {
      state.term = searchBox.value;
      state.exactPhrase = false;
      state.page = 1;
      syncUrl();
      render();
    }

    function handlePageSizeChange() {
      const val = parseInt(pageSizeSel.value, 10);
      state.pageSize = Number.isNaN(val) ? 25 : val;
      state.page = 1;
      syncUrl();
      render();
    }

    async function render() {
      const generation = ++renderGeneration;
      const term = (state.term || '').trim();
      const searchInput = state.exactPhrase && term ? `"${term.replace(/"/g, '\\"')}"` : term;
      const searchTerm = term === '' ? null : term;
      const pageSize = state.pageSize || 25;
      const filters = state.filters;
      const noCriteria = searchTerm === null && Object.keys(filters).length === 0;

      // ── Sem critério: passa term null normalmente ao Pagefind ──
      // Porém, se já houve uma busca com filtro antes (pagefind inicializado),
      // precisamos cancelar qualquer debouncedSearch anterior que esteja em voo
      // com searchTerm=null+filtros, pois quando acorda ele executa search(null,{})
      // varrendo 287k registros na thread principal e travando o browser.
      // A forma de cancelar é chamar debouncedSearch('', ...) — string vazia faz o
      // Pagefind incrementar o searchID interno e retornar {} sem varrer nada,
      // descartando a chamada anterior em voo.
      if (noCriteria && pagefindInstance) {
        pagefindInstance.debouncedSearch('', {}, 0);
      }

      // Feedback visual imediato
      resultsEl.innerHTML = `
        <div style="padding: var(--space-8) 0; text-align: center; color: var(--color-muted);">
          <p>${s.searchBusy}</p>
        </div>
      `;

      try {
        const pf = await ensurePagefind();
        if (!pf) {
          resultsEl.textContent = s.searchIndexUnavailable;
          return;
        }

        let searchResult = await pf.debouncedSearch(searchInput || searchTerm, { filters: Object.keys(filters).length ? filters : undefined }, 300);
        // debouncedSearch retorna null quando uma chamada mais recente foi enfileirada — abandona silenciosamente
        if (searchResult === null) return;
        if (searchResult && searchResult.results && searchResult.results.length === 0 && state.exactPhrase && searchInput !== searchTerm) {
          searchResult = await pf.debouncedSearch(searchTerm, { filters: Object.keys(filters).length ? filters : undefined }, 300);
          if (searchResult === null) return;
        }
        if (!searchResult || !searchResult.results) {
          resultsEl.textContent = s.searchIndexEmpty;
          return;
        }
        if (generation !== renderGeneration) return;

        const allResults = searchResult.results;
        const total = allResults.length;

        // ── Sem resultados com critério ──
        if (total === 0) {
          resultsEl.innerHTML = `
            <div style="padding: var(--space-8) var(--space-4); text-align: center; color: var(--color-muted);">
              <h2 style="color: var(--color-ink); font-family: var(--font-serif);">${s.searchNoResults}</h2>
              <p>${s.searchNoResultsDesc}</p>
              <button class="button secondary" style="margin-top: var(--space-4);" onclick="window.clearAllFilters()">${s.searchClearFilters}</button>
            </div>
          `;
          return;
        }
        if (generation !== renderGeneration) return;

        // ── Paginação lazy: slice ANTES de chamar .data() ──
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * pageSize;
        const end = Math.min(start + pageSize, total);
        const visibleResults = allResults.slice(start, end);
        const activeEl = document.activeElement;
        const focusAria = activeEl && activeEl.classList.contains('button') ? activeEl.getAttribute('aria-label') : null;

        if (generation !== renderGeneration) return;
        resultsEl.innerHTML = '';
        const nav = buildPagination(state.page, totalPages, total, start, end);
        resultsEl.appendChild(nav);
        const cardsWrap = document.createElement('div');
        cardsWrap.style.display = 'grid';
        cardsWrap.style.gap = 'var(--space-4)';
        cardsWrap.setAttribute('aria-busy', 'true');
        const loadingNotice = document.createElement('div');
        loadingNotice.className = 'card';
        loadingNotice.style.margin = '0';
        loadingNotice.innerHTML = `
          <p style="margin:0 0 var(--space-3);color:var(--color-muted);">${s.searchBusy}</p>
          <div style="display:grid;gap:var(--space-2);" aria-hidden="true">
            <div style="height:0.9rem;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
            <div style="height:0.65rem;width:82%;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
            <div style="height:0.65rem;width:64%;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
          </div>
        `;
        cardsWrap.appendChild(loadingNotice);
        resultsEl.appendChild(cardsWrap);
        resultsEl.appendChild(buildPagination(state.page, totalPages, total, start, end));

        for (let i = 0; i < visibleResults.length; i += RESULT_BATCH_SIZE) {
          if (generation !== renderGeneration) return;
          const chunk = visibleResults.slice(i, i + RESULT_BATCH_SIZE);
          const hits = await Promise.all(chunk.map((r) => r.data()));
          if (generation !== renderGeneration) return;
          if (loadingNotice.isConnected) loadingNotice.remove();
          hits.forEach((hit) => cardsWrap.appendChild(buildCard(hit, term)));
          if (i + RESULT_BATCH_SIZE < visibleResults.length) {
            await new Promise((resolve) => setTimeout(resolve, 0));
          }
        }
        cardsWrap.removeAttribute('aria-busy');
        if (focusAria) {
          const btn = resultsEl.querySelector(`[aria-label="${focusAria}"]`);
          if (btn) btn.focus();
        }

      } catch (err) {
        resultsEl.textContent = s.searchIndexError;
        console.error(err);
      }
    }

    function buildPagination(page, totalPages, total, start, end) {
      const nav = document.createElement('div');
      nav.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);flex-wrap:wrap;padding:var(--space-2) 0;';

      const info = document.createElement('span');
      info.style.color = 'var(--color-muted)';
      info.style.fontSize = '0.9rem';
      info.textContent = paginationShowing(start + 1, end, total);
      nav.appendChild(info);

      const btnWrap = document.createElement('div');
      btnWrap.style.cssText = 'display:flex;gap:var(--space-2);align-items:center;';

      const prevBtn = document.createElement('button');
      prevBtn.className = 'button secondary';
      prevBtn.textContent = s.paginationPrev;
      prevBtn.disabled = page === 1;
      prevBtn.setAttribute('aria-label', s.paginationPrevLabel);
      prevBtn.addEventListener('click', () => {
        state.page = Math.max(1, state.page - 1);
        syncUrl();
        render();
        resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      const pageSpan = document.createElement('span');
      pageSpan.style.fontSize = '0.9rem';
      pageSpan.textContent = paginationPage(page, totalPages);

      const nextBtn = document.createElement('button');
      nextBtn.className = 'button secondary';
      nextBtn.textContent = s.paginationNext;
      nextBtn.disabled = page === totalPages;
      nextBtn.setAttribute('aria-label', s.paginationNextLabel);
      nextBtn.addEventListener('click', () => {
        state.page = Math.min(totalPages, state.page + 1);
        syncUrl();
        render();
        resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      btnWrap.appendChild(prevBtn);
      btnWrap.appendChild(pageSpan);
      btnWrap.appendChild(nextBtn);
      nav.appendChild(btnWrap);
      return nav;
    }

    function buildCard(hit, term) {
      const article = document.createElement('article');
      article.className = 'card search-result-card';

      const h3 = document.createElement('h3');
      h3.className = 'result-title';
      const link = document.createElement('a');
      const pageUrl = hit.url || '#';
      const rawUrl = hit.meta?.rawUrl || '';
      const target = normalizeUrl(pageUrl);
      if (term && target.startsWith(basePath)) {
        const urlObj = new URL(target, window.location.origin);
        urlObj.searchParams.set('highlight', term);
        link.href = localizeRoutePath(urlObj.pathname) + urlObj.search + urlObj.hash;
      } else {
        link.href = target;
      }
      link.textContent = hit.meta?.title || s.searchNoTitle;
      h3.appendChild(link);

      const metaLine = document.createElement('div');
      metaLine.className = 'result-meta';

      const author = hit.meta?.author || '';
      const work = hit.meta?.work || '';
      const volume = hit.meta?.doc || '';
      const page = hit.meta?.page || '';
      if (author) {
        const authorSpan = document.createElement('div');
        authorSpan.className = 'result-meta-item';
        authorSpan.innerHTML = `<span class="result-meta-label">${s.searchResultAuthor}:</span><span class="result-meta-value">${escapeHtml(author)}</span>`;
        metaLine.appendChild(authorSpan);
      }
      if (work) {
        const workSpan = document.createElement('div');
        workSpan.className = 'result-meta-item';
        workSpan.innerHTML = `<span class="result-meta-label">${s.searchResultWork}:</span><span class="result-meta-value">${escapeHtml(work)}</span>`;
        metaLine.appendChild(workSpan);
      }
      if (volume || page) {
        const volSpan = document.createElement('div');
        volSpan.className = 'result-meta-item';
        volSpan.innerHTML = `<span class="result-meta-label">${s.searchResultVolume}:</span><span class="result-meta-value">${escapeHtml(volume)}${page ? ` · p. ${escapeHtml(page)}` : ''}</span>`;
        metaLine.appendChild(volSpan);
      }

      const snippet = document.createElement('p');
      snippet.className = 'result-snippet';
      snippet.innerHTML = hit.excerpt || (hit.content ? hit.content.slice(0, 180) : s.searchNoSnippet);

      const chips = document.createElement('ul');
      chips.className = 'chips result-chips';

      const badgeItems = [];
      const filtersHit = hit.filters || {};
      Object.entries(filtersHit).forEach(([category, vals]) => {
        if (Array.isArray(vals)) {
          vals.forEach(v => badgeItems.push({ category, value: v }));
        }
      });
      if (hit.meta?.keywords) {
        String(hit.meta.keywords).split('•').map((label) => label.trim()).filter(Boolean).forEach((value) => {
          badgeItems.push({ category: 'keyword', value });
        });
      }

      badgeItems.slice(0, 8).forEach((b) => {
        const li = document.createElement('li');
        li.textContent = b.value;
        li.style.cursor = 'pointer';
        li.title = ariaFilterBy(b.category, b.value);
        li.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleFilter(b.category, b.value);
        };
        chips.appendChild(li);
      });

      const actions = document.createElement('div');
      actions.className = 'result-actions';

      const openBtn = document.createElement('a');
      openBtn.className = 'button secondary';
      openBtn.href = link.href;
      openBtn.textContent = s.searchResultOpenPage;
      actions.appendChild(openBtn);

      if (rawUrl) {
        const rawBtn = document.createElement('a');
        rawBtn.className = 'button secondary';
        rawBtn.href = rawUrl;
        rawBtn.target = '_blank';
        rawBtn.rel = 'noreferrer';
        rawBtn.textContent = s.searchResultOpenRaw;
        actions.appendChild(rawBtn);
      }

      article.appendChild(h3);
      if (metaLine.childNodes.length) article.appendChild(metaLine);
      article.appendChild(snippet);
      if (chips.childNodes.length) article.appendChild(chips);
      article.appendChild(actions);

      return article;
    }

    searchBox.addEventListener('input', () => {
      void ensureKeywordCatalog();
      // Pré-carrega os fragmentos do índice enquanto o usuário digita,
      // sem ainda executar a busca — reduz latência percebida.
      ensurePagefind().then((pf) => {
        if (pf && typeof pf.preload === 'function' && searchBox.value) {
          pf.preload(searchBox.value);
        }
      });
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(() => {
        handleTermInput();
        updateSuggestions();
      }, 120);
    });

    searchBox.addEventListener('focus', () => {
      void ensureKeywordCatalog();
    });

    // Suporte a Enter
    searchBox.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        if (renderTimer) clearTimeout(renderTimer);
        handleTermInput();
      }
    });

    pageSizeSel.addEventListener('change', handlePageSizeChange);

    function updateSuggestions() {
      const term = (searchBox.value || '').toLowerCase();
      if (!term || keywordOptions.length === 0) {
        datalist.innerHTML = '';
        return;
      }
      const suggestions = keywordOptions.filter((k) => k.toLowerCase().includes(term)).slice(0, 15);
      datalist.innerHTML = suggestions.map((s) => `<option value="${s}"></option>`).join('');
    }

    quickCollectionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setCollectionFilter(btn.dataset.collection || '');
      });
    });

    suggestionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const term = btn.dataset.term || '';
        searchBox.value = term;
        state.term = term;
        state.exactPhrase = true;
        state.page = 1;
        syncUrl();
        render();
        updateSuggestions();
      });
    });

    // Render inicial imediato
    render();

    // Carga preguiçosa dos filtros para não travar o render inicial
    loadFilters().then(() => {
      if (state.term) updateSuggestions();
    });
  </script>
</Layout>
