---
import Layout from '../Layout.astro';
import FiltersPanel from '../FiltersPanel.astro';
import { useTranslations, serializeTranslations, getLocaleBase } from '../../i18n';
const base = import.meta.env.BASE_URL || '/';
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const searchIndexVersion = import.meta.env.PUBLIC_INDEXADOR_SEARCH_VERSION || '';
const searchIndexBase = `${baseWithSlash}indexador/search${searchIndexVersion ? `/${encodeURIComponent(searchIndexVersion)}` : ''}`;
const localeBase = getLocaleBase(Astro.currentLocale, base);
const t = useTranslations(Astro.currentLocale);
const uiStrings = serializeTranslations(t);
const uiLocale = Astro.currentLocale ?? 'pt-br';
---
<Layout title={t.searchTitle} description={t.searchSubtitle} breadcrumbs={[{label: t.breadcrumbHome, href: localeBase},{label: t.breadcrumbSearch}]}>
  <div class="main-grid search-layout">
    <FiltersPanel loading={true} />

    <section aria-label={t.ariaResults} class="search-main">
      <header class="search-hero card">
        <div class="search-hero-copy">
          <p class="eyebrow">{t.searchSubtitle}</p>
          <h1>{t.searchTitle}</h1>
          <p>{t.searchHeroHint}</p>
          <p class="search-data-note">{t.searchDataNote}</p>
          <p id="search-engine-note" class="search-engine-note">{t.searchIndexadorPoc}</p>
        </div>
        <div class="search-controls">
          <label class="sr-only" for="search-box">{t.searchPlaceholder}</label>
          <div class="search-combobox">
            <input
              id="search-box"
              type="search"
              placeholder={t.searchPlaceholder}
              class="search-input search-input-xl"
              role="combobox"
              autocomplete="off"
              aria-autocomplete="list"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="search-suggestions-list"
            />
            <ul id="search-suggestions-list" class="search-suggestions-list" role="listbox" aria-label={t.searchSuggestionsLabel} hidden></ul>
          </div>
          <div class="search-toolbar">
            <label for="page-size" class="search-toolbar-label">{t.searchItemsLabel}</label>
            <select id="page-size" class="page-size-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
            </select>
          </div>
          <div class="search-quick-filters" aria-label={t.searchHeroLabel}>
            <button type="button" class="chip-button" data-collection="">{t.searchAllCollections}</button>
            <button type="button" class="chip-button" data-collection="PG">PG</button>
            <button type="button" class="chip-button" data-collection="PL">PL</button>
            <button type="button" class="chip-button" data-collection="PO">PO</button>
          </div>
          <div class="search-suggestions">
            <button type="button" class="suggestion-button" data-term="Agostinho de Hipona">{t.searchQuickAuthors}</button>
            <button type="button" class="suggestion-button" data-term="Trindade">{t.searchQuickThemes}</button>
            <button type="button" class="suggestion-button" data-term="João 1,1">{t.searchQuickScripture}</button>
            <button type="button" class="suggestion-button" data-term="Eucaristia">{t.searchQuickKeywords}</button>
          </div>
        </div>
      </header>

      <div id="results" class="results-list" aria-live="polite">
        <p>{t.searchLoading}</p>
      </div>
    </section>
  </div>

  <style>
    .search-layout {
      align-items: start;
      min-width: 0;
    }
    .search-layout :global(aside),
    .search-main {
      min-width: 0;
      max-width: 100%;
    }
    .search-layout :global(.filters) {
      max-width: 100%;
    }
    .search-layout :global(.card[aria-label]) {
      position: sticky;
      top: calc(var(--space-4) + 72px);
      max-height: calc(100vh - 96px);
      overflow: auto;
    }
    .search-main {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .search-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-6);
      border: 1px solid var(--color-border);
      background: linear-gradient(180deg, color-mix(in srgb, var(--color-surface) 92%, var(--color-accent) 8%) 0%, var(--color-surface) 100%);
    }
    .search-hero-copy .eyebrow {
      margin: 0 0 var(--space-2);
      color: var(--color-muted);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
    }
    .search-hero-copy h1 {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.1;
    }
    .search-hero-copy p {
      margin: var(--space-3) 0 0;
      max-width: 70ch;
      color: var(--color-muted);
      line-height: 1.65;
    }
    .search-data-note {
      padding: var(--space-3) var(--space-4);
      border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
      border-radius: var(--radius-m);
      background: color-mix(in srgb, var(--color-surface) 82%, var(--color-accent) 18%);
      font-size: 0.95rem;
    }
    .search-engine-note {
      font-size: 0.85rem;
    }
    .search-controls {
      display: grid;
      gap: var(--space-3);
    }
    .search-input-xl {
      max-width: none;
      padding: 1rem 1.05rem;
      border-radius: var(--radius-m);
      font-size: 1.05rem;
    }
    .search-combobox {
      position: relative;
      min-width: 0;
    }
    .search-suggestions-list {
      position: absolute;
      z-index: 20;
      inset: calc(100% + var(--space-2)) 0 auto;
      max-height: min(18rem, 45vh);
      margin: 0;
      padding: var(--space-2);
      overflow-y: auto;
      list-style: none;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-m);
      background: var(--color-surface);
      box-shadow: var(--shadow-soft);
    }
    .search-suggestions-list[hidden] {
      display: none;
    }
    .search-suggestions-list :global(.search-suggestion-option) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      width: 100%;
      padding: 0.65rem 0.75rem;
      border: 0;
      border-radius: var(--radius-s);
      background: transparent;
      color: var(--color-ink);
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    .search-suggestions-list :global(.search-suggestion-option:hover),
    .search-suggestions-list :global(.search-suggestion-option[aria-selected="true"]) {
      background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    }
    .search-suggestions-list :global(.search-suggestion-value) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .search-suggestions-list :global(.search-suggestion-kind) {
      flex: 0 0 auto;
      padding: 0.18rem 0.48rem;
      border: 1px solid color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
      border-radius: 999px;
      color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1.3;
      text-transform: uppercase;
    }
    .search-corrections {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }
    .search-toolbar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
    }
    .search-toolbar-label {
      color: var(--color-muted);
      font-size: 0.9rem;
    }
    .filters details {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-s);
      background: var(--color-surface-2);
      padding: 0.5rem 0.7rem;
    }
    .filters summary {
      cursor: pointer;
      list-style: none;
      font-weight: 700;
    }
    .filters summary::-webkit-details-marker { display: none; }
    .filters-group {
      display: grid;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }
    .search-quick-filters,
    .search-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .chip-button,
    .suggestion-button {
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-ink);
      padding: 0.45rem 0.8rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.9rem;
    }
    .chip-button:hover,
    .suggestion-button:hover,
    .chip-button[aria-pressed="true"] {
      background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
      border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
    }
    .search-result-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    @keyframes shimmer {
      0% { background-position: 0% 0; }
      100% { background-position: 200% 0; }
    }
    .result-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 0.7rem;
      font-size: 0.92rem;
      color: var(--color-muted);
    }
    .result-meta-item {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      line-height: 1.4;
      padding: 0.14rem 0.55rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    }
    .result-meta-label {
      color: var(--color-ink);
      font-weight: 600;
      white-space: nowrap;
      letter-spacing: 0.01em;
    }
    .result-meta-value {
      color: var(--color-muted);
      overflow-wrap: anywhere;
    }
    .result-chips {
      gap: 0.4rem;
    }
    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .results-list .card {
      box-shadow: var(--shadow-soft);
    }
    .search-empty-state {
      display: grid;
      justify-items: center;
      gap: var(--space-3);
      padding: clamp(var(--space-6), 8vw, var(--space-8));
      text-align: center;
      border: 1px dashed color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
      background: color-mix(in srgb, var(--color-surface) 94%, var(--color-accent) 6%);
    }
    .search-empty-state-icon {
      display: grid;
      place-items: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 999px;
      color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
      font-size: 1.6rem;
    }
    .search-empty-state h2,
    .search-empty-state p {
      margin: 0;
    }
    .search-empty-state p {
      max-width: 58ch;
      color: var(--color-muted);
      line-height: 1.6;
    }
    @media (max-width: 980px) {
      .search-hero {
        padding: var(--space-5);
      }
      .search-layout :global(.card[aria-label]) {
        position: static;
        max-height: none;
        overflow: visible;
      }
    }
    @media (max-width: 720px) {
      .search-layout :global(.filters) {
        width: 100%;
        flex-direction: column;
        overflow: visible;
      }
      .search-layout :global(.filters > div) {
        min-width: 0;
      }
      .search-hero {
        padding: var(--space-4);
      }
      .search-hero-copy h1 {
        font-size: clamp(1.7rem, 8vw, 2.3rem);
      }
      .search-result-card .button {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script type="module" define:vars={{ assetBase: baseWithSlash, searchIndexBase, localeBase, uiStrings, uiLocale }}>
    const resultsEl = document.getElementById('results');
    const searchBox = document.getElementById('search-box');
    const pageSizeSel = document.getElementById('page-size');
    // uiStrings não contém filtersTitle pois é string (está em uiStrings), mas o aside
    // usa o atributo aria-label renderizado pelo servidor. Selecionamos pelo papel semântico.
    const filtersRoot = document.querySelector('aside[aria-label]');
    const suggestionList = document.getElementById('search-suggestions-list');
    const quickCollectionButtons = Array.from(document.querySelectorAll('[data-collection]'));
    const suggestionButtons = Array.from(document.querySelectorAll('[data-term]'));
    const engineNote = document.getElementById('search-engine-note');
    let checkboxNodes = [];
    let displayedSuggestions = [];
    let activeSuggestionIndex = -1;
    let volumesPayload = null;
    let renderGeneration = 0;
    const dataCache = window.pdfocrDataCache;
    const jsonCache = new Map();
    const RESULT_BATCH_SIZE = 8;
    const SEARCH_SUGGESTION_DISPLAY_LIMIT = 8;

    // Reconstrói funções de formatação (não serializáveis via define:vars)
    const s = uiStrings;
    const isEn = uiLocale === 'en';
    const isIt = uiLocale === 'it';
    const isFr = uiLocale === 'fr';
    function localizedPageSummary(page) {
      if (!page) return '';
      return page.translations?.[uiLocale]?.summary_page || page.summary_page || '';
    }
    function localizedGlobalSummary(page) {
      if (!page) return '';
      return page.translations?.[uiLocale]?.summary_global || page.summary_global || '';
    }
    const paginationShowing = isEn
      ? (start, end, total) => `Showing ${start}–${end} of ${total} results`
      : isIt
        ? (start, end, total) => `Mostrando ${start}–${end} di ${total} risultati`
        : isFr
          ? (start, end, total) => `Affichage de ${start} à ${end} sur ${total} résultats`
      : (start, end, total) => `Mostrando ${start}–${end} de ${total} resultados`;
    const paginationPage = isEn
      ? (page, total) => `Page ${page} / ${total}`
      : isIt
        ? (page, total) => `Pagina ${page} / ${total}`
        : isFr
          ? (page, total) => `Page ${page} / ${total}`
      : (page, total) => `Página ${page} / ${total}`;
    const ariaFilterBy = isEn
      ? (cat, val) => `Filter by ${cat}: ${val}`
      : isIt
        ? (cat, val) => `Filtra per ${cat}: ${val}`
        : isFr
          ? (cat, val) => `Filtrer par ${cat} : ${val}`
      : (cat, val) => `Filtrar por ${cat}: ${val}`;
    const escapeHtml = (value) => String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
    const normalizeWhitespace = (value) => String(value || '').replace(/\s+/g, ' ').trim();

    const getJsonOnce = (url) => {
      if (dataCache?.getJsonOnce) return dataCache.getJsonOnce(url);
      if (!jsonCache.has(url)) {
        const promise = fetch(url).then(async (res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}: ${url}`);
          return res.json();
        }).catch((err) => {
          jsonCache.delete(url);
          throw err;
        });
        jsonCache.set(url, promise);
      }
      return jsonCache.get(url);
    };

    const state = {
      term: '',
      pageSize: 25,
      page: 1,
      filters: {},
      exactPhrase: false,
    };

    function readStateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const term = params.get('term') || '';
      const pageSize = parseInt(params.get('pageSize'), 10);
      const page = parseInt(params.get('page'), 10);
      const filters = {};
      // Coleção seleciona partições do PatrologiaIndexer; volume e livro entram
      // na expressão booleana enviada ao índice.
      ['collection', 'volume', 'book'].forEach((key) => {
        const values = params.getAll(key);
        if (values.length) filters[key] = values;
      });
      // Keywords vindas da URL (?keyword=X) são convertidas em term de busca textual
      const kwValues = params.getAll('keyword');
      const termFromKw = kwValues.join(' ');
      state.term = term || termFromKw;
      state.exactPhrase = kwValues.length > 0 && !!termFromKw;
      state.pageSize = !Number.isNaN(pageSize) && pageSize > 0 ? Math.min(pageSize, 50) : 25;
      state.page = !Number.isNaN(page) && page > 0 ? page : 1;
      state.filters = filters;
    }

    function syncDocumentTitle() {
      const fullTerm = normalizeWhitespace(state.term);
      if (!fullTerm) {
        document.title = s.searchTitle;
        return;
      }
      const termCharacters = Array.from(fullTerm);
      const titleTerm = termCharacters.length > 72
        ? `${termCharacters.slice(0, 71).join('')}…`
        : fullTerm;
      document.title = String(s.searchDocumentTitle || '{term} | Bibliotheca Patristica')
        .replace('{term}', () => titleTerm);
    }

    function syncUrl() {
      const params = new URLSearchParams();
      if (state.term.trim()) params.set('term', state.term.trim());
      if (state.pageSize && state.pageSize !== 25) params.set('pageSize', String(state.pageSize));
      if (state.page && state.page > 1) params.set('page', String(state.page));
      // Apenas filtros estruturais (collection, volume) na URL — keywords vão em 'term'
      Object.entries(state.filters).forEach(([key, values]) => {
        if (key === 'keyword') return; // não serializa keyword como filtro
        values.forEach((v) => params.append(key, v));
      });
      const newUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState({}, '', newUrl);
      syncDocumentTitle();
    }

    function closeSuggestionList() {
      displayedSuggestions = [];
      activeSuggestionIndex = -1;
      suggestionList.replaceChildren();
      suggestionList.hidden = true;
      searchBox.setAttribute('aria-expanded', 'false');
      searchBox.removeAttribute('aria-activedescendant');
    }

    function applySuggestion(value) {
      searchBox.value = value;
      state.term = value;
      state.exactPhrase = false;
      state.page = 1;
      closeSuggestionList();
      syncUrl();
      render();
      searchBox.focus();
    }

    function selectSuggestion(index) {
      if (!displayedSuggestions.length) return;
      activeSuggestionIndex = (index + displayedSuggestions.length) % displayedSuggestions.length;
      const options = Array.from(suggestionList.querySelectorAll('[role="option"]'));
      options.forEach((option, optionIndex) => {
        option.setAttribute('aria-selected', optionIndex === activeSuggestionIndex ? 'true' : 'false');
      });
      const active = options[activeSuggestionIndex];
      if (active) {
        searchBox.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      }
    }

    function showSuggestionList(suggestions) {
      const seen = new Set();
      displayedSuggestions = suggestions.filter((suggestion) => {
        const value = String(suggestion?.value || '').trim();
        if (!value || seen.has(value) || value === searchBox.value.trim()) return false;
        seen.add(value);
        return true;
      }).slice(0, SEARCH_SUGGESTION_DISPLAY_LIMIT);
      activeSuggestionIndex = -1;
      suggestionList.replaceChildren();
      if (!displayedSuggestions.length || document.activeElement !== searchBox) {
        displayedSuggestions = [];
        suggestionList.hidden = true;
        searchBox.setAttribute('aria-expanded', 'false');
        return;
      }
      displayedSuggestions.forEach((suggestion, index) => {
        const item = document.createElement('li');
        item.id = `search-suggestion-${index}`;
        item.className = 'search-suggestion-option';
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', 'false');

        const value = document.createElement('span');
        value.className = 'search-suggestion-value';
        value.textContent = suggestion.value;
        const kind = document.createElement('span');
        kind.className = 'search-suggestion-kind';
        const kindLabel = suggestion.kind === 'correction'
          ? s.searchSuggestionCorrection
          : s.searchSuggestionCompletion;
        kind.textContent = kindLabel;
        kind.setAttribute('aria-hidden', 'true');
        item.setAttribute('aria-label', `${suggestion.value} — ${kindLabel}`);
        item.append(value, kind);
        item.addEventListener('pointerdown', (event) => event.preventDefault());
        item.addEventListener('click', () => applySuggestion(suggestion.value));
        suggestionList.appendChild(item);
      });
      suggestionList.hidden = false;
      searchBox.setAttribute('aria-expanded', 'true');
    }

    function mergeSuggestions(searchResults) {
      const seen = new Set();
      const merged = [];
      for (const result of searchResults) {
        for (const suggestion of result.suggestions || []) {
          if (!suggestion?.value || seen.has(suggestion.value)) continue;
          seen.add(suggestion.value);
          merged.push(suggestion);
        }
      }
      return merged.sort((left, right) => {
        if (left.kind !== right.kind) return left.kind === 'prefix' ? -1 : 1;
        if (left.distance !== right.distance) return left.distance - right.distance;
        if (left.globalImportance !== right.globalImportance) {
          return left.globalImportance - right.globalImportance;
        }
        return String(left.replacement).localeCompare(String(right.replacement), uiLocale);
      });
    }

    readStateFromUrl();
    syncDocumentTitle();
    searchBox.value = state.term;
    pageSizeSel.value = String(state.pageSize);
    quickCollectionButtons.forEach((btn) => {
      const selected = state.filters.collection?.includes(btn.dataset.collection || '') || (!state.filters.collection && !(btn.dataset.collection || ''));
      btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
    });

    let indexadorModulePromise = null;
    let indexadorManifest = null;
    let indexadorManifestPromise = null;
    const indexadorInstances = new Map();
    const pageMetaPromises = new Map();
    let renderTimer = null;

    const basePath = assetBase.endsWith('/') ? assetBase.slice(0, -1) : assetBase;
    const localePath = localeBase.endsWith('/') ? localeBase.slice(0, -1) : localeBase;

    function manifestIndexes(manifest) {
      if (Array.isArray(manifest?.indexes)) return manifest.indexes;
      return (manifest?.collections || []).filter((item) => item && typeof item === 'object');
    }

    function manifestCollections(manifest) {
      if (Array.isArray(manifest?.collections) && manifest.collections.every((item) => typeof item === 'string')) {
        return manifest.collections;
      }
      return Array.from(new Set(manifestIndexes(manifest).flatMap((item) => item.collections || [item.id])));
    }

    function localizeRoutePath(pathname) {
      const normalized = String(pathname || '/');
      const withoutBase = normalized.startsWith(basePath)
        ? normalized.slice(basePath.length)
        : normalized;
      const withLeadingSlash = withoutBase.startsWith('/') ? withoutBase : `/${withoutBase}`;
      let strippedPath = withLeadingSlash;
      if (withLeadingSlash === '/en' || withLeadingSlash === '/it' || withLeadingSlash === '/fr') strippedPath = '/';
      else if (withLeadingSlash.startsWith('/en/')) strippedPath = withLeadingSlash.slice(3) || '/';
      else if (withLeadingSlash.startsWith('/it/')) strippedPath = withLeadingSlash.slice(3) || '/';
      else if (withLeadingSlash.startsWith('/fr/')) strippedPath = withLeadingSlash.slice(3) || '/';
      return `${localePath}${strippedPath === '/' ? '' : strippedPath}`;
    }

    async function loadIndexadorManifest() {
      if (indexadorManifest) return indexadorManifest;
      if (indexadorManifestPromise) return indexadorManifestPromise;
      indexadorManifestPromise = getJsonOnce(`${searchIndexBase}/manifest.json`)
        .then((manifest) => {
          indexadorManifest = manifest;
          const volumeCount = new Set(manifestIndexes(manifest).flatMap((item) => item.volumes || [])).size;
          if (engineNote && manifest.sample) {
            engineNote.textContent = `${s.searchIndexadorPoc} ${s.searchIndexadorSample.replace('{count}', String(volumeCount))}`;
          }
          return manifest;
        })
        .catch((error) => {
          indexadorManifestPromise = null;
          throw error;
        });
      return indexadorManifestPromise;
    }

    async function loadFilters() {
      try {
        // Volumes e collections são leves e necessários para os filtros estruturais.
        // Keywords entram em duas camadas: top keywords imediatas para chips e
        // catálogo completo sob demanda para sugestões e navegação.
        const [volumesObj, customManifest] = await Promise.all([
          getJsonOnce(`${assetBase}volumes.json`),
          loadIndexadorManifest().catch(() => null),
        ]);
        volumesPayload = volumesObj;
        dataCache?.rememberJsonForNavigation?.(`${assetBase}volumes.json`, volumesObj);
        const indexedVolumeIds = customManifest?.sample
          ? new Set(manifestIndexes(customManifest).flatMap((item) => item.volumes || []))
          : null;
        const volumes = (volumesObj.volumes || []).filter((volume) => !indexedVolumeIds || indexedVolumeIds.has(volume.id));

        const collections = Array.from(new Set(volumes.map((v) => v.collection_id))).sort();
        const volumeIds = volumes.map((v) => v.id).sort();

        const sections = [
          { key: 'collection', label: s.filterCollection, items: collections },
          { key: 'volume', label: s.filterVolume, items: volumeIds },
        ];

        filtersRoot.innerHTML = `
          <h2 style="margin-top:0;">${s.filtersTitle}</h2>
          <div class="filters">
            ${sections.map((sec) => `
              <details ${sec.key === 'collection' ? 'open' : ''}>
                <summary>${sec.label}</summary>
                <div class="filters-group">
                  ${sec.items.length ? sec.items.map((item) => `
                    <label>
                      <input type="checkbox" name="${sec.key}" value="${item}">
                      ${item}
                    </label>
                  `).join('') : `<p class="muted" style="margin:0;">${s.filtersNoOptions}</p>`}
                </div>
              </details>
            `).join('')}
            <details class="keyword-filter-section" open>
              <summary>${s.filterKeywords}</summary>
              <div class="filters-group">
                <p style="font-size:0.8rem;color:var(--color-muted);margin:0;">${s.filterKeywordsHint}</p>
                <div id="keywords-chips" style="display:flex;flex-wrap:wrap;gap:0.3rem;">
                  <span style="font-size:0.8rem;color:var(--color-muted);">${s.filterKeywordsLoading}</span>
                </div>
              </div>
            </details>
          </div>
        `;

        if (window.matchMedia('(max-width: 720px)').matches) {
          filtersRoot.querySelector('.keyword-filter-section')?.removeAttribute('open');
        }

        checkboxNodes = Array.from(filtersRoot.querySelectorAll('input[type="checkbox"]'));

        // aplicar estado inicial de filtros vindos da URL
        checkboxNodes.forEach((cb) => {
          const { name, value } = cb;
          if (state.filters[name] && state.filters[name].includes(value)) {
            cb.checked = true;
          }
          cb.addEventListener('change', handleFilterChange);
        });

        // Carrega keywords em background, sem bloquear a renderização dos filtros estruturais
        getJsonOnce(`${assetBase}dict/keywords_top.json`)
          .then((keywordsObj) => {
            const keywords = keywordsObj.items || [];
            const chipsContainer = document.getElementById('keywords-chips');
            if (!chipsContainer) return;
            const chips = keywords.slice(0, 300);
            chipsContainer.innerHTML = chips.map((kw) => `
              <button type="button" class="keyword-chip" data-keyword="${kw.label.replace(/"/g, '&quot;')}"
                 style="font-size:0.78rem;padding:0.15rem 0.45rem;border-radius:999px;border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-ink);cursor:pointer;"
                 title="${kw.label.replace(/"/g, '&quot;')}">${kw.label.replace(/</g, '&lt;').replace(/&/g, '&amp;')}</button>
            `).join('');
            chipsContainer.querySelectorAll('.keyword-chip').forEach((btn) => {
              btn.addEventListener('click', (e) => {
                e.preventDefault();
                toggleFilter('keyword', btn.dataset.keyword);
              });
            });
          })
          .catch(() => {
            const chipsContainer = document.getElementById('keywords-chips');
            if (chipsContainer) chipsContainer.innerHTML = `<span style="font-size:0.8rem;color:var(--color-muted);">${s.filterKeywordsUnavailable}</span>`;
          });
      } catch (err) {
        filtersRoot.innerHTML = `<p class="muted" style="margin:0;">${s.filtersUnavailable}</p>`;
        console.error(err);
      }
    }

    function normalizeUrl(raw) {
      if (!raw) return '#';
      if (/^https?:\/\//i.test(raw)) return raw; // Absolutos

      // Remove repetição do base em qualquer formato
      let path = raw.trim();
      const baseNoSlash = basePath.replace(/^\//, '');
      const stripPrefixes = [basePath, `${basePath}/`, baseNoSlash, `${baseNoSlash}/`];
      for (const pref of stripPrefixes) {
        while (path.startsWith(pref)) {
          path = path.slice(pref.length);
        }
      }

      // Garante barra inicial
      if (!path.startsWith('/')) path = `/${path}`;

      return localizeRoutePath(`${basePath}${path}`);
    }

    async function ensureIndexador(entry) {
      if (indexadorInstances.has(entry.id)) return indexadorInstances.get(entry.id);
      if (!indexadorModulePromise) {
        indexadorModulePromise = import(`${assetBase}indexador/runtime/indexador-pagefind.js`);
      }
      const { createIndexadorPagefind } = await indexadorModulePromise;
      const indexCount = Math.max(1, manifestIndexes(indexadorManifest).length);
      const cacheBudget = Math.max(
        4 * 1024 * 1024,
        Math.floor((16 * 1024 * 1024) / indexCount),
      );
      const instance = createIndexadorPagefind({
        assetBaseUrl: `${assetBase}indexador/runtime`,
        indexBaseUrl: `${searchIndexBase}/${entry.path}`,
        PAGE_SIZE: 50,
        MAX_PER_TOKEN: 10000,
        MAX_CONCURRENT_FETCHES: 6,
        prefixMatch: true,
        prefixMinLength: 3,
        prefixMaxTerms: 32,
        prefixMaxPerTerm: 10000,
        suggestions: true,
        suggestionLimit: 15,
        suggestionMinLength: 3,
        suggestionFallbackMin: 5,
        suggestionWordlists: indexadorManifest?.suggestions?.wordlists === true,
        suggestionWordlistRadius: indexadorManifest?.suggestions?.neighbor_radius || 1,
        maxWasmCacheBytes: cacheBudget,
      });
      await instance.init();
      indexadorInstances.set(entry.id, instance);
      return instance;
    }

    function groupTerms(values = []) {
      const terms = values.map((value) => String(value || '').trim()).filter(Boolean);
      if (!terms.length) return '';
      return terms.length === 1 ? `(${terms[0]})` : `(${terms.map((value) => `(${value})`).join(' || ')})`;
    }

    const indexadorSeparators = /[\s.,!?*\-+'"()[\];\\/=<>|#:«»“”$&@%‘’—]+/gu;

    function keywordLiteralQuery(value) {
      const literal = String(value || '').trim().replace(indexadorSeparators, '_').replace(/^_+|_+$/g, '');
      return literal.includes('_') ? literal : '';
    }

    function buildIndexadorQuery(term, filters, includeCollection, useKeywordLiteral = false) {
      const parts = [];
      const literal = useKeywordLiteral ? keywordLiteralQuery(term) : '';
      if (term) parts.push(`(${literal || term})`);
      const collections = includeCollection ? groupTerms(filters.collection) : '';
      const volumes = groupTerms(filters.volume);
      const books = groupTerms(filters.book);
      if (collections) parts.push(collections);
      if (volumes) parts.push(volumes);
      if (books) parts.push(books);
      return parts.join(' && ');
    }

    async function loadResultPrefix(result, count) {
      const needed = Math.min(count, result.total);
      if (typeof result.getRange === 'function') return result.getRange(0, needed);
      const pages = Math.ceil(needed / result.pageSize);
      const chunks = [];
      for (let page = 0; page < pages; page++) chunks.push(result.getPage(page));
      return (await Promise.all(chunks)).flat().slice(0, needed);
    }

    async function loadVisibleResults(searchResults, start, end) {
      if (searchResults.length === 1 && typeof searchResults[0].getRange === 'function') {
        return searchResults[0].getRange(start, end);
      }
      const prefixes = await Promise.all(searchResults.map((result) => loadResultPrefix(result, end)));
      return prefixes.flat()
        .sort((left, right) => right.score - left.score)
        .filter((item, index, items) => items.findIndex((candidate) => candidate.url === item.url) === index)
        .slice(start, end);
    }

    function metadataBlockPath(value, volumeId) {
      if (!/^[A-Za-z0-9.]+$/.test(volumeId)) return '';
      const path = String(value || '').replace(/^\/+/, '');
      const prefix = `meta/${volumeId}-pages-`;
      const suffix = '.json.gz';
      if (!path.startsWith(prefix) || !path.endsWith(suffix)) return '';
      const blockNumber = path.slice(prefix.length, -suffix.length);
      return /^\d+$/.test(blockNumber) ? path : '';
    }

    function resolveRawUrl(raw, rawBaseUrl) {
      if (raw?.url) return String(raw.url);
      if (!raw?.file || !rawBaseUrl) return '';
      return `${String(rawBaseUrl).replace(/\/$/, '')}/${encodeURIComponent(String(raw.file))}`;
    }

    async function loadPageMetadata(volumeId, pageNumber, directBlockPath = '') {
      const normalizedBlockPath = metadataBlockPath(directBlockPath, volumeId);
      const key = `${volumeId}:${pageNumber}:${normalizedBlockPath}`;
      if (pageMetaPromises.has(key)) return pageMetaPromises.get(key);
      const promise = (async () => {
        let blockPath = normalizedBlockPath;
        if (!blockPath) {
          const meta = await getJsonOnce(`${assetBase}meta/${encodeURIComponent(volumeId)}.json.gz`);
          const block = (meta.page_blocks || []).find((item) => pageNumber >= item.page_first && pageNumber <= item.page_last);
          blockPath = block?.file || '';
        }
        if (!blockPath) return { page: null, rawBaseUrl: '', blockPath: '', blockUrl: '', blockPayload: null };
        const blockUrl = `${assetBase}${blockPath}`;
        const payload = await getJsonOnce(blockUrl);
        return {
          page: (payload.pages || []).find((item) => Number(item.page) === pageNumber) || null,
          rawBaseUrl: payload.raw_base_url || '',
          blockPath,
          blockUrl,
          blockPayload: payload,
        };
      })().catch((error) => {
        pageMetaPromises.delete(key);
        throw error;
      });
      pageMetaPromises.set(key, promise);
      return promise;
    }

    function makeExcerpt(value, term) {
      const text = normalizeWhitespace(value || '');
      if (!text) return s.searchNoSnippet;
      const queryTerms = Array.from(new Set(String(term || '').match(/[\p{L}\p{N}]+/gu) || []))
        .filter((item) => item.length >= 3);
      const lower = text.toLocaleLowerCase(uiLocale);
      const positions = queryTerms
        .map((item) => lower.indexOf(item.toLocaleLowerCase(uiLocale)))
        .filter((position) => position >= 0);
      const matchAt = positions.length ? Math.min(...positions) : 0;
      let start = Math.max(0, matchAt - 140);
      if (start > 0) {
        const nextSpace = text.indexOf(' ', start);
        if (nextSpace >= 0 && nextSpace < matchAt) start = nextSpace + 1;
      }
      const excerpt = text.slice(start, start + 480);
      let html = escapeHtml(excerpt);
      queryTerms.forEach((item) => {
        const escaped = item.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        html = html.replace(new RegExp(escaped, 'giu'), (match) => `<mark>${match}</mark>`);
      });
      return `${start > 0 ? '…' : ''}${html}${start + excerpt.length < text.length ? '…' : ''}`;
    }

    async function enrichIndexadorDocument(document, term) {
      const parsed = new URL(document.url, window.location.origin);
      const volumeId = parsed.searchParams.get('doc') || '';
      const pageNumber = Number(parsed.searchParams.get('page'));
      const directBlockPath = parsed.searchParams.get('mb') || '';
      const metadata = volumeId && Number.isFinite(pageNumber)
        ? await loadPageMetadata(volumeId, pageNumber, directBlockPath)
        : { page: null, rawBaseUrl: '', blockPath: '', blockUrl: '', blockPayload: null };
      const page = metadata.page;
      if (metadata.blockPath) parsed.searchParams.set('mb', metadata.blockPath);
      else parsed.searchParams.delete('mb');
      const publicUrl = `${parsed.pathname}${parsed.search}${parsed.hash}`;
      const titleHint = document.name.includes(' — ') ? document.name.split(' — ').slice(1).join(' — ') : '';
      const titleLabels = titleHint.includes(' • ') ? titleHint.split(' • ').map((item) => item.trim()) : [];
      return {
        url: publicUrl,
        excerpt: makeExcerpt([localizedPageSummary(page), localizedGlobalSummary(page)].filter(Boolean).join(' '), term),
        meta: {
          title: document.name,
          author: page?.author || '',
          work: page?.work || '',
          doc: volumeId,
          page: String(pageNumber || ''),
          collection: volumeId.slice(0, 2),
          rawUrl: resolveRawUrl(page?.raw, metadata.rawBaseUrl),
          keywords: titleLabels.slice(0, 3).join(' • '),
        },
        filters: {
          collection: volumeId ? [volumeId.slice(0, 2)] : [],
          volume: volumeId ? [volumeId] : [],
        },
        navigationCache: metadata.blockUrl && metadata.blockPayload
          ? { blockUrl: metadata.blockUrl, blockPayload: metadata.blockPayload }
          : null,
      };
    }

    function renderEmptyState() {
      closeSuggestionList();
      resultsEl.innerHTML = `
        <div class="card search-empty-state">
          <span class="search-empty-state-icon" aria-hidden="true">🔍</span>
          <h2>${escapeHtml(s.searchEmptyTitle)}</h2>
          <p>${escapeHtml(s.searchEmptyDescription || s.searchIndexadorPrompt)}</p>
        </div>
      `;
    }

    function renderNoResultSuggestions(suggestions) {
      const root = document.getElementById('search-corrections');
      if (!root) return;
      const corrections = suggestions
        .filter((suggestion) => suggestion.kind === 'correction')
        .slice(0, 5);
      if (!corrections.length) return;
      const label = document.createElement('span');
      label.textContent = s.searchDidYouMean;
      root.appendChild(label);
      corrections.forEach((suggestion) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'button secondary';
        button.textContent = suggestion.value;
        button.addEventListener('click', () => applySuggestion(suggestion.value));
        root.appendChild(button);
      });
    }

    function handleFilterChange() {
      const filters = {};
      checkboxNodes.filter((c) => c.checked).forEach((c) => {
        if (!filters[c.name]) filters[c.name] = [];
        filters[c.name].push(c.value);
      });
      state.filters = filters;
      state.page = 1;
      syncUrl();
      
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(() => {
        render();
      }, 300);
    }

    function toggleFilter(name, value) {
      // Keywords são buscadas como texto (evita baixar o filter chunk de 7MB)
      if (name === 'keyword') {
        state.term = state.term === value ? '' : value;
        state.exactPhrase = !!state.term;
        searchBox.value = state.term;
        state.page = 1;
        syncUrl();
        if (renderTimer) clearTimeout(renderTimer);
        renderTimer = setTimeout(render, 50);
        return;
      }
      if (!state.filters[name]) state.filters[name] = [];
      const idx = state.filters[name].indexOf(value);
      if (idx === -1) {
        state.filters[name].push(value);
      } else {
        state.filters[name].splice(idx, 1);
      }
      if (state.filters[name].length === 0) delete state.filters[name];
      
      // Sincronizar checkboxes se existirem
      checkboxNodes.forEach(cb => {
        if (cb.name === name && cb.value === value) {
          cb.checked = !cb.checked;
        }
      });
      
      state.page = 1;
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    }

    function setCollectionFilter(collection) {
      if (!collection) {
        delete state.filters.collection;
        checkboxNodes.forEach((cb) => {
          if (cb.name === 'collection') cb.checked = false;
        });
      } else {
        state.filters.collection = [collection];
        checkboxNodes.forEach((cb) => {
          if (cb.name === 'collection') {
            cb.checked = cb.value === collection;
          }
        });
      }
      quickCollectionButtons.forEach((btn) => {
        const selected = collection ? btn.dataset.collection === collection : !btn.dataset.collection;
        btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      state.page = 1;
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    }

    window.clearAllFilters = function() {
      state.filters = {};
      state.term = '';
      state.page = 1;
      searchBox.value = '';
      checkboxNodes.forEach(cb => cb.checked = false);
      syncUrl();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(render, 50);
    };

    function handleTermInput() {
      state.term = searchBox.value;
      state.exactPhrase = false;
      state.page = 1;
      syncUrl();
      render();
    }

    function handlePageSizeChange() {
      const val = parseInt(pageSizeSel.value, 10);
      state.pageSize = Number.isNaN(val) ? 25 : val;
      state.page = 1;
      syncUrl();
      render();
    }

    async function render() {
      const generation = ++renderGeneration;
      const term = (state.term || '').trim();
      const pageSize = state.pageSize || 25;
      const filters = state.filters;
      const hasCriteria = term || filters.collection?.length || filters.volume?.length || filters.book?.length;

      if (!hasCriteria) {
        renderEmptyState();
        return;
      }

      closeSuggestionList();

      // Feedback visual imediato
      resultsEl.innerHTML = `
        <div style="padding: var(--space-8) 0; text-align: center; color: var(--color-muted);">
          <p>${s.searchBusy}</p>
        </div>
      `;

      try {
        const manifest = await loadIndexadorManifest();
        const availableCollections = new Set(manifestCollections(manifest));
        const requestedCollections = filters.collection?.length
          ? filters.collection
          : [...availableCollections];
        const collections = requestedCollections.filter((item) => availableCollections.has(item));
        const entries = manifestIndexes(manifest).filter((entry) => {
          const supported = entry.collections || [entry.id];
          return collections.some((collection) => supported.includes(collection));
        });
        const query = buildIndexadorQuery(
          term,
          filters,
          manifest.layout === 'unified',
          state.exactPhrase && manifest.config?.keyword_literals === true,
        );
        if (!query) {
          renderEmptyState();
          return;
        }
        const engines = (await Promise.all(entries.map(ensureIndexador))).filter(Boolean);
        if (!engines.length) {
          resultsEl.textContent = s.searchIndexUnavailable;
          return;
        }
        const searchResults = await Promise.all(engines.map((engine) =>
          engine.search(query, { suggestionsFor: term })));
        if (generation !== renderGeneration) return;

        const suggestions = mergeSuggestions(searchResults);
        showSuggestionList(suggestions);

        const total = searchResults.reduce((sum, result) => sum + result.total, 0);

        // ── Sem resultados com critério ──
        if (total === 0) {
          resultsEl.innerHTML = `
            <div style="padding: var(--space-8) var(--space-4); text-align: center; color: var(--color-muted);">
              <h2 style="color: var(--color-ink); font-family: var(--font-serif);">${s.searchNoResults}</h2>
              <p>${s.searchNoResultsDesc}</p>
              <div id="search-corrections" class="search-corrections"></div>
              <button class="button secondary" style="margin-top: var(--space-4);" onclick="window.clearAllFilters()">${s.searchClearFilters}</button>
            </div>
          `;
          renderNoResultSuggestions(suggestions);
          return;
        }
        if (generation !== renderGeneration) return;

        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        state.page = Math.min(Math.max(1, state.page), totalPages);
        const start = (state.page - 1) * pageSize;
        const end = Math.min(start + pageSize, total);
        const visibleResults = await loadVisibleResults(searchResults, start, end);
        if (generation !== renderGeneration) return;
        const activeEl = document.activeElement;
        const focusAria = activeEl && activeEl.classList.contains('button') ? activeEl.getAttribute('aria-label') : null;

        if (generation !== renderGeneration) return;
        resultsEl.innerHTML = '';
        const nav = buildPagination(state.page, totalPages, total, start, end);
        resultsEl.appendChild(nav);
        const cardsWrap = document.createElement('div');
        cardsWrap.style.display = 'grid';
        cardsWrap.style.gap = 'var(--space-4)';
        cardsWrap.setAttribute('aria-busy', 'true');
        const loadingNotice = document.createElement('div');
        loadingNotice.className = 'card';
        loadingNotice.style.margin = '0';
        loadingNotice.innerHTML = `
          <p style="margin:0 0 var(--space-3);color:var(--color-muted);">${s.searchBusy}</p>
          <div style="display:grid;gap:var(--space-2);" aria-hidden="true">
            <div style="height:0.9rem;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
            <div style="height:0.65rem;width:82%;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
            <div style="height:0.65rem;width:64%;border-radius:999px;background:linear-gradient(90deg,var(--color-surface-2),color-mix(in srgb,var(--color-accent) 14%,var(--color-surface)),var(--color-surface-2));background-size:200% 100%;animation:shimmer 1.4s linear infinite;"></div>
          </div>
        `;
        cardsWrap.appendChild(loadingNotice);
        resultsEl.appendChild(cardsWrap);
        resultsEl.appendChild(buildPagination(state.page, totalPages, total, start, end));

        for (let i = 0; i < visibleResults.length; i += RESULT_BATCH_SIZE) {
          if (generation !== renderGeneration) return;
          const chunk = visibleResults.slice(i, i + RESULT_BATCH_SIZE);
          const hits = await Promise.all(chunk.map((document) => enrichIndexadorDocument(document, term)));
          if (generation !== renderGeneration) return;
          if (loadingNotice.isConnected) loadingNotice.remove();
          hits.forEach((hit) => cardsWrap.appendChild(buildCard(hit, term)));
          if (i + RESULT_BATCH_SIZE < visibleResults.length) {
            await new Promise((resolve) => setTimeout(resolve, 0));
          }
        }
        cardsWrap.removeAttribute('aria-busy');
        if (focusAria) {
          const btn = resultsEl.querySelector(`[aria-label="${focusAria}"]`);
          if (btn) btn.focus();
        }

      } catch (err) {
        resultsEl.textContent = s.searchIndexError;
        console.error(err);
      }
    }

    function buildPagination(page, totalPages, total, start, end) {
      const nav = document.createElement('div');
      nav.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);flex-wrap:wrap;padding:var(--space-2) 0;';

      const info = document.createElement('span');
      info.style.color = 'var(--color-muted)';
      info.style.fontSize = '0.9rem';
      info.textContent = paginationShowing(start + 1, end, total);
      nav.appendChild(info);

      const btnWrap = document.createElement('div');
      btnWrap.style.cssText = 'display:flex;gap:var(--space-2);align-items:center;';

      const prevBtn = document.createElement('button');
      prevBtn.className = 'button secondary';
      prevBtn.textContent = s.paginationPrev;
      prevBtn.disabled = page === 1;
      prevBtn.setAttribute('aria-label', s.paginationPrevLabel);
      prevBtn.addEventListener('click', () => {
        state.page = Math.max(1, state.page - 1);
        syncUrl();
        render();
        resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      const pageSpan = document.createElement('span');
      pageSpan.style.fontSize = '0.9rem';
      pageSpan.textContent = paginationPage(page, totalPages);

      const nextBtn = document.createElement('button');
      nextBtn.className = 'button secondary';
      nextBtn.textContent = s.paginationNext;
      nextBtn.disabled = page === totalPages;
      nextBtn.setAttribute('aria-label', s.paginationNextLabel);
      nextBtn.addEventListener('click', () => {
        state.page = Math.min(totalPages, state.page + 1);
        syncUrl();
        render();
        resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      btnWrap.appendChild(prevBtn);
      btnWrap.appendChild(pageSpan);
      btnWrap.appendChild(nextBtn);
      nav.appendChild(btnWrap);
      return nav;
    }

    function buildCard(hit, term) {
      const article = document.createElement('article');
      article.className = 'card search-result-card';

      const h3 = document.createElement('h3');
      h3.className = 'result-title';
      const link = document.createElement('a');
      const pageUrl = hit.url || '#';
      const rawUrl = hit.meta?.rawUrl || '';
      const target = normalizeUrl(pageUrl);
      if (term && target.startsWith(basePath)) {
        const urlObj = new URL(target, window.location.origin);
        urlObj.searchParams.set('highlight', term);
        link.href = localizeRoutePath(urlObj.pathname) + urlObj.search + urlObj.hash;
      } else {
        link.href = target;
      }
      link.textContent = hit.meta?.title || s.searchNoTitle;
      h3.appendChild(link);

      function rememberViewerAssets(prefetchManifest = false) {
        const remember = dataCache?.rememberJsonForNavigation;
        if (!remember) return;
        if (volumesPayload) remember(`${assetBase}volumes.json`, volumesPayload);
        if (hit.navigationCache?.blockUrl && hit.navigationCache?.blockPayload) {
          remember(hit.navigationCache.blockUrl, hit.navigationCache.blockPayload);
        }
        if (!prefetchManifest || !volumesPayload || !hit.meta?.doc) return;
        const volume = (volumesPayload.volumes || []).find((item) => item.id === hit.meta.doc);
        if (!volume?.meta_url) return;
        const metaUrl = `${assetBase}${String(volume.meta_url).replace(/^\/+/, '')}`;
        void getJsonOnce(metaUrl)
          .then((payload) => remember(metaUrl, payload))
          .catch(() => {});
      }

      function prepareViewerLink(anchor) {
        anchor.addEventListener('pointerenter', () => rememberViewerAssets(true));
        anchor.addEventListener('focus', () => rememberViewerAssets(true));
        anchor.addEventListener('pointerdown', () => rememberViewerAssets(false));
        anchor.addEventListener('click', () => rememberViewerAssets(false));
      }

      prepareViewerLink(link);

      const metaLine = document.createElement('div');
      metaLine.className = 'result-meta';

      const author = hit.meta?.author || '';
      const work = hit.meta?.work || '';
      const volume = hit.meta?.doc || '';
      const page = hit.meta?.page || '';
      if (author) {
        const authorSpan = document.createElement('div');
        authorSpan.className = 'result-meta-item';
        authorSpan.innerHTML = `<span class="result-meta-label">${s.searchResultAuthor}:</span><span class="result-meta-value">${escapeHtml(author)}</span>`;
        metaLine.appendChild(authorSpan);
      }
      if (work) {
        const workSpan = document.createElement('div');
        workSpan.className = 'result-meta-item';
        workSpan.innerHTML = `<span class="result-meta-label">${s.searchResultWork}:</span><span class="result-meta-value">${escapeHtml(work)}</span>`;
        metaLine.appendChild(workSpan);
      }
      if (volume || page) {
        const volSpan = document.createElement('div');
        volSpan.className = 'result-meta-item';
        volSpan.innerHTML = `<span class="result-meta-label">${s.searchResultVolume}:</span><span class="result-meta-value">${escapeHtml(volume)}${page ? ` · p. ${escapeHtml(page)}` : ''}</span>`;
        metaLine.appendChild(volSpan);
      }

      const snippet = document.createElement('p');
      snippet.className = 'result-snippet';
      snippet.innerHTML = hit.excerpt || (hit.content ? hit.content.slice(0, 180) : s.searchNoSnippet);

      const chips = document.createElement('ul');
      chips.className = 'chips result-chips';

      const badgeItems = [];
      const filtersHit = hit.filters || {};
      Object.entries(filtersHit).forEach(([category, vals]) => {
        if (Array.isArray(vals)) {
          vals.forEach(v => badgeItems.push({ category, value: v }));
        }
      });
      if (hit.meta?.keywords) {
        String(hit.meta.keywords).split('•').map((label) => label.trim()).filter(Boolean).forEach((value) => {
          badgeItems.push({ category: 'keyword', value });
        });
      }

      badgeItems.slice(0, 8).forEach((b) => {
        const li = document.createElement('li');
        li.textContent = b.value;
        li.style.cursor = 'pointer';
        li.title = ariaFilterBy(b.category, b.value);
        li.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleFilter(b.category, b.value);
        };
        chips.appendChild(li);
      });

      const actions = document.createElement('div');
      actions.className = 'result-actions';

      const openBtn = document.createElement('a');
      openBtn.className = 'button secondary';
      openBtn.href = link.href;
      openBtn.textContent = s.searchResultOpenPage;
      prepareViewerLink(openBtn);
      actions.appendChild(openBtn);

      if (rawUrl) {
        const rawBtn = document.createElement('a');
        rawBtn.className = 'button secondary';
        rawBtn.href = rawUrl;
        rawBtn.target = '_blank';
        rawBtn.rel = 'noreferrer';
        rawBtn.textContent = s.searchResultOpenRaw;
        actions.appendChild(rawBtn);
      }

      article.appendChild(h3);
      if (metaLine.childNodes.length) article.appendChild(metaLine);
      article.appendChild(snippet);
      if (chips.childNodes.length) article.appendChild(chips);
      article.appendChild(actions);

      return article;
    }

    searchBox.addEventListener('input', () => {
      closeSuggestionList();
      if (renderTimer) clearTimeout(renderTimer);
      renderTimer = setTimeout(() => {
        handleTermInput();
      }, 120);
    });

    searchBox.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && displayedSuggestions.length) {
        e.preventDefault();
        selectSuggestion(activeSuggestionIndex + 1);
        return;
      }
      if (e.key === 'ArrowUp' && displayedSuggestions.length) {
        e.preventDefault();
        selectSuggestion(activeSuggestionIndex <= 0
          ? displayedSuggestions.length - 1
          : activeSuggestionIndex - 1);
        return;
      }
      if (e.key === 'Escape') {
        closeSuggestionList();
        return;
      }
      if (e.key === 'Enter') {
        if (activeSuggestionIndex >= 0 && displayedSuggestions[activeSuggestionIndex]) {
          e.preventDefault();
          applySuggestion(displayedSuggestions[activeSuggestionIndex].value);
          return;
        }
        if (renderTimer) clearTimeout(renderTimer);
        handleTermInput();
      }
    });

    searchBox.addEventListener('blur', () => {
      window.setTimeout(closeSuggestionList, 0);
    });

    pageSizeSel.addEventListener('change', handlePageSizeChange);

    quickCollectionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setCollectionFilter(btn.dataset.collection || '');
      });
    });

    suggestionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const term = btn.dataset.term || '';
        searchBox.value = term;
        state.term = term;
        state.exactPhrase = true;
        state.page = 1;
        syncUrl();
        render();
      });
    });

    // Render inicial imediato
    render();

    // Carga preguiçosa dos filtros para não travar o render inicial
    loadFilters();
  </script>
</Layout>
