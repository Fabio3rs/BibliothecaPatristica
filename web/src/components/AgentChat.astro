---
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const rawBase = import.meta.env.BASE_URL || '/';
const assetBase = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const locale = Astro.currentLocale === 'en' || Astro.currentLocale === 'it' || Astro.currentLocale === 'fr' ? Astro.currentLocale : 'pt-br';
const indicesVersion = import.meta.env.PUBLIC_INDEXADOR_INDICES_VERSION || '';
const searchIndexVersion = import.meta.env.PUBLIC_INDEXADOR_SEARCH_VERSION || '';
const strings = {
  sourcesLabel: t.agentChatSources,
  youLabel: t.agentChatYou,
  assistantLabel: t.agentChatAssistant,
  activityLabel: t.agentChatActivity,
  usingTool: t.agentChatUsingTool,
  toolDone: t.agentChatToolDone,
  toolFailed: t.agentChatToolFailed,
  debugRequest: t.agentChatDebugRequest,
  debugResponse: t.agentChatDebugResponse,
  debugToolStart: t.agentChatDebugToolStart,
  debugToolEnd: t.agentChatDebugToolEnd,
  debugToolError: t.agentChatDebugToolError,
  debugResponseRepair: t.agentChatDebugResponseRepair,
  debugCapabilityFallback: t.agentChatDebugCapabilityFallback,
  debugContextPressure: t.agentChatDebugContextPressure,
  debugContextCompactionStart: t.agentChatDebugContextCompactionStart,
  debugContextCompactionEnd: t.agentChatDebugContextCompactionEnd,
  debugComplete: t.agentChatDebugComplete,
  debugEmpty: t.agentChatDebugEmpty,
  statusReady: t.agentChatStatusReady,
  statusConfigMissing: t.agentChatStatusConfigMissing,
  statusWorking: t.agentChatStatusWorking,
  statusAborted: t.agentChatStatusAborted,
  statusError: t.agentChatStatusError,
  settingsSaved: t.agentChatSettingsSaved,
  settingsNotPersisted: t.agentChatSettingsNotPersisted,
  showKey: t.agentChatShowKey,
  hideKey: t.agentChatHideKey,
  debugCopy: t.agentChatDebugCopy,
  debugCopied: t.agentChatDebugCopied,
  copyFailed: t.agentChatCopyFailed,
  errorInvalidUrl: t.agentChatErrorInvalidUrl,
  errorMissingModel: t.agentChatErrorMissingModel,
  errorMissingPrompt: t.agentChatErrorMissingPrompt,
  errorAuth: t.agentChatErrorAuth,
  errorRateLimit: t.agentChatErrorRateLimit,
  errorNetwork: t.agentChatErrorNetwork,
  errorInvalidResponse: t.agentChatErrorInvalidResponse,
  errorEmptyResponse: t.agentChatErrorEmptyResponse,
  errorLoopLimit: t.agentChatErrorLoopLimit,
  errorContextLimit: t.agentChatErrorContextLimit,
  errorGeneric: t.agentChatErrorGeneric,
  connectionConfigured: t.agentChatConnectionConfigured,
  connectionValidated: t.agentChatConnectionValidated,
  connectionFailedSummary: t.agentChatConnectionFailedSummary,
  connectionMissing: t.agentChatConnectionMissing,
  configureLabel: t.agentChatConfigure,
  testConnection: t.agentChatTestConnection,
  testingConnection: t.agentChatTestingConnection,
  connectionEndpointOk: t.agentChatConnectionEndpointOk,
  connectionAuthOk: t.agentChatConnectionAuthOk,
  connectionModelOk: t.agentChatConnectionModelOk,
  connectionToolsOk: t.agentChatConnectionToolsOk,
  connectionToolsMissing: t.agentChatConnectionToolsMissing,
  connectionFailed: t.agentChatConnectionFailed,
  contextLabel: t.agentChatContextLabel,
  removeContext: t.agentChatRemoveContext,
  restoreContext: t.agentChatRestoreContext,
  contextDisabled: t.agentChatContextDisabled,
  newResponse: t.agentChatNewResponse,
  citationLabel: t.agentChatCitationLabel,
  invalidCitation: t.agentChatInvalidCitation,
  pageAbbreviation: t.agentChatPageAbbreviation,
  indexSource: t.agentChatIndexSource,
  evidenceOcr: t.agentChatEvidenceOcr,
  evidenceMetadata: t.agentChatEvidenceMetadata,
  evidenceIndex: t.agentChatEvidenceIndex,
  openViewer: t.agentChatOpenViewer,
  openOcr: t.agentChatOpenOcr,
  openIndex: t.agentChatOpenIndex,
  openSource: t.agentChatOpenSource,
  metadataLabel: t.agentChatMetadataLabel,
  sourceAuthor: t.agentChatSourceAuthor,
  sourceWork: t.agentChatSourceWork,
  sourceSummary: t.agentChatSourceSummary,
  sourceKeywords: t.agentChatSourceKeywords,
  sourceProvenance: t.agentChatSourceProvenance,
  usageSummary: t.agentChatUsageSummary,
  toolLabels: {
    list_volumes: t.agentChatToolListVolumes,
    search_corpus: t.agentChatToolSearchCorpus,
    search_scripture: t.agentChatToolSearchScripture,
    get_page_metadata: t.agentChatToolPageMetadata,
    search_indices: t.agentChatToolSearchIndices,
    get_volume_index: t.agentChatToolVolumeIndex,
    get_page_ocr: t.agentChatToolPageOcr,
  },
};
const clientConfig = JSON.stringify({
  assetBase,
  locale,
  indicesVersion,
  searchIndexVersion,
  defaultPrompt: `${t.agentChatDefaultSystemPrompt} ${t.agentChatScriptureSystemPrompt}`,
  strings,
});
---

<div class="agent-chat" data-agent-chat data-config={clientConfig}>
  <button
    class="agent-chat-launcher"
    type="button"
    data-agent-role="launcher"
    aria-label={t.agentChatOpen}
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <span aria-hidden="true">✦</span>
    <span>{t.agentChatLauncher}</span>
  </button>

  <div class="agent-chat-backdrop" data-agent-role="backdrop" hidden></div>

  <section
    class="agent-chat-drawer"
    data-agent-role="drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="agent-chat-title"
    aria-hidden="true"
    hidden
  >
    <header class="agent-chat-header">
      <div>
        <p class="agent-chat-kicker">{t.agentChatKicker}</p>
        <h2 id="agent-chat-title">{t.agentChatTitle}</h2>
        <p>{t.agentChatSubtitle}</p>
      </div>
      <button class="agent-chat-icon-button" type="button" data-agent-role="close" aria-label={t.agentChatClose}>×</button>
    </header>

    <div class="agent-chat-tabs" role="tablist" aria-label={t.agentChatTabsLabel}>
      <button type="button" role="tab" data-agent-tab="conversation" aria-controls="agent-chat-conversation" aria-selected="true">
        {t.agentChatConversationTab}
      </button>
      <button type="button" role="tab" data-agent-tab="debug" aria-controls="agent-chat-debug" aria-selected="false" tabindex="-1">
        {t.agentChatDebugTab}
      </button>
    </div>

    <div class="agent-chat-panel agent-chat-conversation" id="agent-chat-conversation" role="tabpanel" data-agent-panel="conversation">
      <div class="agent-chat-connection-bar" data-agent-role="connection-bar">
        <span data-agent-role="connection-summary"></span>
        <button type="button" class="agent-chat-link-button" data-agent-role="configure">{t.agentChatConfigure}</button>
      </div>

      <div class="agent-chat-context" data-agent-role="context" hidden>
        <span data-agent-role="context-label"></span>
        <button type="button" class="agent-chat-link-button" data-agent-role="remove-context">{t.agentChatRemoveContext}</button>
      </div>

      <div class="agent-chat-transcript" data-agent-role="transcript" role="log" aria-live="polite" aria-relevant="additions">
        <article class="agent-chat-message is-assistant" data-welcome>
          <div class="agent-chat-message-label">{t.agentChatAssistant}</div>
          <div class="agent-chat-message-body">{t.agentChatWelcome}</div>
        </article>
      </div>

      <button type="button" class="agent-chat-new-response" data-agent-role="new-response" hidden>{t.agentChatNewResponse}</button>

      <div class="agent-chat-status" data-agent-role="status" role="status"></div>

      <form class="agent-chat-composer" data-agent-role="composer">
        <label class="sr-only" for="agent-chat-input">{t.agentChatInputLabel}</label>
        <textarea id="agent-chat-input" data-agent-role="input" rows="2" placeholder={t.agentChatPlaceholder}></textarea>
        <div class="agent-chat-composer-actions">
          <button type="button" class="button secondary" data-agent-role="new-chat">{t.agentChatNewChat}</button>
          <button type="submit" class="button" data-agent-role="send">{t.agentChatSend}</button>
          <button type="button" class="button" data-agent-role="stop" hidden>{t.agentChatStop}</button>
        </div>
      </form>
    </div>

    <div class="agent-chat-panel agent-chat-debug" id="agent-chat-debug" role="tabpanel" data-agent-panel="debug" hidden>
      <details class="agent-chat-settings" data-agent-role="settings">
        <summary>{t.agentChatSettings}</summary>
        <form data-agent-role="settings-form" class="agent-chat-settings-form">
          <aside class="agent-chat-provider-intro" aria-labelledby="agent-chat-provider-title">
            <strong id="agent-chat-provider-title">{t.agentChatProviderIntroTitle}</strong>
            <p>{t.agentChatProviderIntroBody}</p>
            <p>{t.agentChatProviderCostNote}</p>
            <p>{t.agentChatProviderPrivacyNote}</p>
          </aside>
          <label>
            <span>{t.agentChatApiUrl}</span>
            <input data-agent-role="api-url" type="url" inputmode="url" placeholder="http://127.0.0.1:11434/v1" autocomplete="url" />
            <small>{t.agentChatApiUrlHint}</small>
          </label>
          <label>
            <span>{t.agentChatApiKey}</span>
            <span class="agent-chat-key-row">
              <input data-agent-role="api-key" type="password" autocomplete="new-password" placeholder={t.agentChatApiKeyPlaceholder} />
              <button type="button" data-agent-role="reveal-key" aria-pressed="false">{t.agentChatShowKey}</button>
            </span>
          </label>
          <label>
            <span>{t.agentChatModel}</span>
            <input data-agent-role="model" type="text" autocomplete="off" placeholder={t.agentChatModelPlaceholder} />
          </label>
          <p class="agent-chat-security-note">{t.agentChatSecurityNote}</p>
          <details class="agent-chat-advanced-settings">
            <summary>{t.agentChatAdvancedSettings}</summary>
            <div class="agent-chat-advanced-settings-body">
              <label>
                <span>{t.agentChatSystemPrompt}</span>
                <textarea data-agent-role="system-prompt" rows="7"></textarea>
              </label>
              <div class="agent-chat-settings-options">
                <label class="agent-chat-checkbox">
                  <input data-agent-role="debug-enabled" type="checkbox" />
                  <span>{t.agentChatDebugEnabled}</span>
                </label>
                <button type="button" class="agent-chat-link-button" data-agent-role="reset-prompt">{t.agentChatResetPrompt}</button>
              </div>
            </div>
          </details>
          <details class="agent-chat-provider-help">
            <summary>{t.agentChatProviderHelpTitle}</summary>
            <p>{t.agentChatProviderHelpBody}</p>
          </details>
          <div class="agent-chat-settings-actions">
            <button class="button" type="submit">{t.agentChatApplySettings}</button>
            <button class="button secondary" type="button" data-agent-role="test-connection">{t.agentChatTestConnection}</button>
          </div>
          <div class="agent-chat-connection-test" data-agent-role="connection-test" role="status"></div>
        </form>
      </details>

      <div class="agent-chat-debug-head">
        <div>
          <h3>{t.agentChatDebugTitle}</h3>
          <p>{t.agentChatDebugDescription}</p>
        </div>
        <div class="agent-chat-debug-actions">
          <button type="button" class="button secondary" data-agent-role="copy-debug">{t.agentChatDebugCopy}</button>
          <button type="button" class="button secondary" data-agent-role="clear-debug">{t.agentChatDebugClear}</button>
        </div>
      </div>
      <div class="agent-chat-debug-list" data-agent-role="debug-list"></div>
    </div>
  </section>
</div>

<script>
  import { initAgentChats } from '../scripts/agent-chat.js';
  initAgentChats();
</script>

<style>
  .agent-chat [hidden] { display: none !important; }
  .agent-chat-launcher {
    position: fixed;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: 1100;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    box-shadow: var(--shadow-soft);
    font: 700 0.9rem var(--font-sans);
    cursor: pointer;
  }
  .agent-chat-launcher:hover,
  .agent-chat-launcher:focus-visible { filter: brightness(1.08); }
  .agent-chat-launcher span:first-child { font-size: 1.2rem; }
  .agent-chat-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1190;
    background: color-mix(in srgb, var(--color-ink) 42%, transparent);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .agent-chat-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 1200;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    width: min(32rem, 100vw);
    height: 100dvh;
    border-left: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
    transform: translateX(100%);
    transition: transform 0.18s ease;
  }
  .agent-chat[data-open="true"] .agent-chat-backdrop { opacity: 1; }
  .agent-chat[data-open="true"] .agent-chat-drawer { transform: translateX(0); }
  .agent-chat-header {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .agent-chat-header h2 {
    margin: 0;
    font: 700 1.45rem var(--font-serif);
  }
  .agent-chat-header p { margin: var(--space-1) 0 0; color: var(--color-muted); font-size: 0.85rem; }
  .agent-chat-header .agent-chat-kicker {
    margin: 0 0 var(--space-1);
    color: var(--color-accent);
    font: 700 0.72rem var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .agent-chat-icon-button {
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-ink);
    font-size: 1.5rem;
    cursor: pointer;
  }
  .agent-chat-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .agent-chat-tabs button {
    padding: var(--space-3);
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--color-muted);
    font: 700 0.88rem var(--font-sans);
    cursor: pointer;
  }
  .agent-chat-tabs button[aria-selected="true"] { border-bottom-color: var(--color-accent); color: var(--color-accent); }
  .agent-chat-panel { min-height: 0; }
  .agent-chat-conversation {
    display: grid;
    grid-template:
      "connection" auto
      "context" auto
      "transcript" minmax(0, 1fr)
      "new-response" auto
      "status" auto
      "composer" auto / minmax(0, 1fr);
    overflow: hidden;
  }
  .agent-chat-connection-bar { grid-area: connection; }
  .agent-chat-context { grid-area: context; }
  .agent-chat-transcript { grid-area: transcript; }
  .agent-chat-new-response { grid-area: new-response; }
  .agent-chat-status { grid-area: status; }
  .agent-chat-composer { grid-area: composer; }
  .agent-chat-connection-bar,
  .agent-chat-context {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .agent-chat-context { color: var(--color-ink); }
  .agent-chat-settings {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }
  .agent-chat-settings > summary {
    padding: var(--space-3) var(--space-5);
    color: var(--color-accent);
    font-weight: 700;
    cursor: pointer;
  }
  .agent-chat-settings-form {
    display: grid;
    gap: var(--space-3);
    max-height: min(60dvh, 34rem);
    padding: 0 var(--space-5) var(--space-4);
    overflow: auto;
  }
  .agent-chat-provider-intro {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .agent-chat-provider-intro strong { color: var(--color-ink); }
  .agent-chat-provider-intro p { margin: var(--space-1) 0 0; }
  .agent-chat-settings-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .agent-chat-connection-test { min-height: 1.5rem; color: var(--color-muted); font-size: 0.78rem; line-height: 1.5; white-space: pre-line; }
  .agent-chat-settings-form label { display: grid; gap: var(--space-1); font-size: 0.82rem; font-weight: 700; }
  .agent-chat-settings-form input,
  .agent-chat-settings-form textarea,
  .agent-chat-composer textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-ink);
    font: 400 0.9rem var(--font-sans);
  }
  .agent-chat-settings-form input { min-height: 2.6rem; padding: 0 var(--space-3); }
  .agent-chat-settings-form textarea { padding: var(--space-2) var(--space-3); resize: vertical; line-height: 1.45; }
  .agent-chat-settings-form small { color: var(--color-muted); font-weight: 400; line-height: 1.4; }
  .agent-chat-key-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2); }
  .agent-chat-key-row button,
  .agent-chat-link-button {
    border: 0;
    background: transparent;
    color: var(--color-accent);
    font-weight: 700;
    cursor: pointer;
  }
  .agent-chat-key-row button { padding: 0 var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-s); }
  .agent-chat-settings-options { display: flex; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .agent-chat-settings-form .agent-chat-checkbox { display: flex; grid-template-columns: none; align-items: center; gap: var(--space-2); }
  .agent-chat-checkbox input { width: auto; min-height: auto; }
  .agent-chat-security-note { margin: 0; color: var(--color-muted); font-size: 0.78rem; line-height: 1.45; }
  .agent-chat-advanced-settings {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
  }
  .agent-chat-advanced-settings > summary {
    padding: var(--space-2) var(--space-3);
    color: var(--color-accent);
    font-weight: 700;
    cursor: pointer;
  }
  .agent-chat-advanced-settings-body {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .agent-chat-provider-help { color: var(--color-muted); font-size: 0.78rem; line-height: 1.45; }
  .agent-chat-provider-help summary { color: var(--color-accent); font-weight: 700; cursor: pointer; }
  .agent-chat-provider-help p { margin: var(--space-2) 0 0; }
  .agent-chat-transcript {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 0;
    padding: var(--space-4) var(--space-5);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .agent-chat-new-response {
    justify-self: center;
    margin: var(--space-1) 0;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-accent);
    font-weight: 700;
    cursor: pointer;
  }
  .agent-chat-status {
    min-height: 1.75rem;
    padding: var(--space-1) var(--space-5);
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .agent-chat-status[data-tone="error"] { color: var(--color-accent); }
  .agent-chat-status[data-tone="busy"]::before { content: '●'; margin-right: var(--space-1); }
  .agent-chat-composer {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5) max(var(--space-4), env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .agent-chat-composer textarea { min-height: 3.25rem; max-height: 10rem; padding: var(--space-2) var(--space-3); resize: vertical; line-height: 1.45; }
  .agent-chat-composer-actions { display: flex; justify-content: flex-end; gap: var(--space-2); }
  .agent-chat-debug {
    padding: var(--space-4) var(--space-5);
    overflow: auto;
  }
  .agent-chat-debug .agent-chat-settings { margin-bottom: var(--space-5); }
  .agent-chat-debug .agent-chat-settings-form {
    max-height: none;
    overflow: visible;
  }
  .agent-chat-debug-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  .agent-chat-debug-head h3 { margin: 0; font-family: var(--font-serif); }
  .agent-chat-debug-head p { margin: var(--space-1) 0 0; color: var(--color-muted); font-size: 0.84rem; }
  .agent-chat-debug-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .agent-chat-debug-list { display: grid; gap: var(--space-2); }
  .agent-chat :global(.agent-chat-message) {
    align-self: flex-start;
    max-width: 92%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-surface);
  }
  .agent-chat :global(.agent-chat-message.is-user) { align-self: flex-end; background: var(--color-surface-2); }
  .agent-chat :global(.agent-chat-message[data-error="true"]) { border-color: var(--color-accent); }
  .agent-chat :global(.agent-chat-message-label) {
    margin-bottom: var(--space-1);
    color: var(--color-accent);
    font: 700 0.72rem var(--font-sans);
    text-transform: uppercase;
  }
  .agent-chat :global(.agent-chat-message-body) { overflow-wrap: anywhere; font-size: 0.92rem; line-height: 1.55; }
  .agent-chat :global(.agent-chat-message.is-streaming .agent-chat-message-body) { white-space: pre-wrap; }
  .agent-chat :global(.agent-chat-message-body p) { margin: 0 0 var(--space-2); }
  .agent-chat :global(.agent-chat-message-body p:last-child) { margin-bottom: 0; }
  .agent-chat :global(.agent-chat-message-body h3) { margin: var(--space-3) 0 var(--space-2); font: 700 1.02rem var(--font-serif); }
  .agent-chat :global(.agent-chat-message-body ul),
  .agent-chat :global(.agent-chat-message-body ol) { margin: 0 0 var(--space-2); padding-left: var(--space-5); }
  .agent-chat :global(.agent-chat-message-body pre) { overflow: auto; padding: var(--space-2); border-radius: var(--radius-s); background: var(--color-surface-2); white-space: pre-wrap; }
